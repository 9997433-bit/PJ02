  "steps": [
    {
      "step_number": 1,
      "description": "铺大厅后场: 三片灰色大正方形整边互吸, 一片顶四片省时省力。",
      "tip": "大方片是地台主力 —— 巨幕墙和侧墙都要踩它的边线。",
      "tiles_to_add": [
        "lg_0",
        "lg_1",
        "lg_2"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺控制台排行: 六片灰色方板贴着大方片南边排开。",
      "tip": "小方片北边整边吸进大方片南边 —— 长短边贴合一样牢。",
      "tiles_to_add": [
        "f_0_1",
        "f_1_1",
        "f_2_1",
        "f_3_1",
        "f_4_1",
        "f_5_1"
      ],
      "highlight_tiles": [
        "lg_0"
      ]
    },
    {
      "step_number": 3,
      "description": "铺前厅蓝毯行: 再来六片蓝色方板, 大厅地台完工。",
      "tip": "蓝毯是给参观的小朋友站的 —— 发射直播马上开始!",
      "tiles_to_add": [
        "f_0_0",
        "f_1_0",
        "f_2_0",
        "f_3_0",
        "f_4_0",
        "f_5_0"
      ],
      "highlight_tiles": [
        "f_0_1"
      ]
    },
    {
      "step_number": 4,
      "description": "立巨幕下层: 六片青色窗格方沿北边线并肩竖起, 竖边互咬成排。",
      "tip": "这排窗格方就是任务大屏 —— 火箭的一举一动都在上面。",
      "tiles_to_add": [
        "scr_0",
        "scr_1",
        "scr_2",
        "scr_3",
        "scr_4",
        "scr_5"
      ],
      "highlight_tiles": [
        "lg_0",
        "lg_2"
      ]
    },
    {
      "step_number": 5,
      "description": "叠巨幕上层: 素墙四片夹住正中两格红色倒计时钟。",
      "tip": "上下横边加左右竖边互吸, 墙格网环路密布, 撞一下也不怕。",
      "tiles_to_add": [
        "top_0",
