  "steps": [
    {
      "step_number": 1,
      "description": "铺街面南行: 驾驶室墙脚与安全锥脚下用单位方板, 车轮位用长板。",
      "tip": "车轮底座底边长 2 —— 轮位两侧必须是长板长边, 等长才吸得住。",
      "tiles_to_add": [
        "g0_1",
        "g0_2",
        "g0_t",
        "g0_5",
        "g0_6",
        "g0_c",
        "g0_9"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺车道中行: 两块黄色分道砖收在东西两端, 中段全灰色路面。",
      "tip": "中行与南行的长板一一对缝 —— y=1 车轮缝要全线贯通。",
      "tiles_to_add": [
        "g1_1",
        "g1_2",
        "g1_t",
        "g1_m",
        "g1_c",
        "g1_9"
      ],
      "highlight_tiles": [
        "g0_t"
      ]
    },
    {
      "step_number": 3,
      "description": "铺街面北行: 与南行镜像对缝, y=2 车轮缝同样贯通。",
      "tip": "三行铺完, 救援作业区就位 —— 拖车马上进场。",
      "tiles_to_add": [
        "g2_1",
        "g2_2",
        "g2_t",
        "g2_5",
