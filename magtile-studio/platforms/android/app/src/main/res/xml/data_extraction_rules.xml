<?xml version="1.0" encoding="utf-8"?>
<!-- 备份与设备迁移白名单 (API 31+ 走 android:dataExtractionRules):
     云备份与换机迁移均仅含进度存档 progress.db —— 有 include 规则时
     其余文件 (filesDir/data 解包数据资产、外部专属目录的导出 JSON)
     一律隐式排除 (SECURITY_AND_PRIVACY.md §5.1; 签核单 DC7)。
     API 30 及以下的同口径规则见 backup_rules.xml, 两份文件必须保持
     同一白名单。M4 起若引入令牌/凭证文件, 须在两份规则中显式核对
     排除 (§5.1 令牌条款)。 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="progress.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="progress.db" />
    </device-transfer>
</data-extraction-rules>
