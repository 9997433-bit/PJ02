      ]
    },
    {
      "step_number": 4,
      "description": "装入金币: 三枚金色三角放进盒内中央。",
      "tip": "金币底边吸盒底拼缝 —— 关盖前先收好宝贝!",
      "tiles_to_add": [
        "coin_a",
        "coin_b",
        "coin_c"
      ],
      "highlight_tiles": [
        "wall_s"
      ]
    },
    {
      "step_number": 5,
      "description": "放入钥匙: 一把金色瘦高尖靠在盒内北半。",
      "tip": "钥匙也是百宝 —— 开盒靠它!",
      "tiles_to_add": [
        "key"
      ],
      "highlight_tiles": [
        "coin_a"
      ]
    },
    {
      "step_number": 6,
      "description": "平拼翻盖并扣合: 四片金色方板 2x2 整边互吸, 沿后沿铰链翻折; 可先于垫板上平拼再整体搬回 —— 磁吸边即铰链。",
      "tip": "T05 平面翻折 —— 先在桌面平拼, 再沿后沿磁吸边整体翻折扣合。",
      "tiles_to_add": [
        "lid_00",
        "lid_01",
        "lid_10",
        "lid_11",
        "hinge"
      ],
      "highlight_tiles": [
