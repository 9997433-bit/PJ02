  "steps": [
    {
      "step_number": 1,
      "description": "铺厂房区地坪: 河谷西端铺 4 片灰色方板 ([0,2]x[0,2])。",
      "tip": "水轮机厂房将坐在这块地坪上。",
      "tiles_to_add": [
        "yd_0_0",
        "yd_0_1",
        "yd_1_0",
        "yd_1_1"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺下游河床: 4 片长板竖铺 (中段青色是消力池), 东端再补 2 片输电塔区方板。",
      "tip": "长板短边吸地坪边 —— 下游河床一次铺通。",
      "tiles_to_add": [
        "dn_2",
        "dn_3",
        "dn_4",
        "dn_5",
        "pt_0",
        "pt_1"
      ],
      "highlight_tiles": [
        "yd_1_0"
      ]
    },
    {
      "step_number": 3,
      "description": "立下游墙西段: y=2 线上立 4 片灰色立墙。",
      "tip": "底边吸河床板边 —— 这是大坝的下游脸面。",
      "tiles_to_add": [
        "dw_s_0",
        "dw_s_1",
        "dw_s_2",
        "dw_s_3"
      ],
      "highlight_tiles": [
        "dn_2",
        "dn_3"
      ]
    },
    {
      "step_number": 4,
      "description": "立下游墙东段: 再立 3 片, 下游面贯通。",
      "tip": "一字排开不留缝 —— 重力坝靠身板挡水。",
      "tiles_to_add": [
        "dw_s_4",
        "dw_s_5",
        "dw_s_6"
      ],
      "highlight_tiles": [
        "dw_s_3"
      ]
    },
    {
      "step_number": 5,
      "description": "盖坝顶压顶: 7 片灰色压顶板逐格盖上, 南长边先整边吸住下游墙顶沿。",
      "tip": "压顶暂时单边悬挑半格 (在力矩预算内) —— 上游墙一立就变双保险。",
      "tiles_to_add": [
        "cap_0",
        "cap_1",
        "cap_2",
        "cap_3",
        "cap_4",
        "cap_5",
        "cap_6"
      ],
      "highlight_tiles": [
        "dw_s_0",
        "dw_s_6"
      ]
    },
    {
      "step_number": 6,
      "description": "立上游墙: y=3 线上立 7 片, 墙顶吸住压顶北沿, 与下游墙夹出 1 格厚的坝芯。",
      "tip": "每片压顶从此同时压住上下游两面墙 —— 双铰链互为保险, 下级坝体锁成连续箱形环。",
