  "steps": [
    {
      "step_number": 1,
      "description": "铺设河床西半段: 沿直线平放 4 片青色浅滩正方形, 相邻边互相吸合。",
      "tip": "这条 8 格长的浅滩就是大桥的中轴线, 请沿桌面摆直。",
      "tiles_to_add": [
        "bed_0",
        "bed_1",
        "bed_2",
        "bed_3"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺设河床东半段: 再接 4 片青色浅滩, 连成完整河道。",
      "tip": "8 片浅滩必须严丝合缝 —— 桥墩全都要立在它们的接缝上。",
      "tiles_to_add": [
        "bed_4",
        "bed_5",
        "bed_6",
        "bed_7"
      ],
      "highlight_tiles": [
        "bed_3"
      ]
    },
    {
      "step_number": 3,
      "description": "铺设河水: 浅滩中段两侧各平放 4 片蓝色正方形, 河面在桥下展开。",
      "tip": "河水只铺中段 —— 两端留给河岸, 大桥正好跨过最宽的河面。",
      "tiles_to_add": [
        "wat_s_2",
