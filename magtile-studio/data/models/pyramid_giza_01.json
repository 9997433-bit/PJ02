{
  "schema_version": 1,
  "id": "pyramid_giza_01",
  "name": "吉萨金字塔",
  "name_en": "Pyramid of Giza 01",
  "description": "逐层居中收分的三级阶梯金字塔: 5x5 沙漠地台上, 3x3 塔身与退台平台、1x1 第二级层层收分, 顶上四片等边三角形合拢成金色压顶石; 四角红色护坡斜撑双边吸合抗侧力, 四座方尖碑守望四角, 一条神道从东侧直通塔底。层叠退台的收分节奏与锥顶合拢的自锁环, 一课双技法。",
  "difficulty": 3,
  "total_pieces": 64,
  "tags": [
    "金字塔",
    "建筑地标",
    "层叠退台",
    "进阶"
  ],
