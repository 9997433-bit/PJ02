  "steps": [
    {
      "step_number": 1,
      "description": "铺发射塔地台: 两片灰色方板沿西端打底, 六片蓝色方板合围第一层墙环。",
      "tip": "塔基东边要留出一条直线跑道 —— 弹珠将从这里分流进双轨。",
      "tiles_to_add": [
        "base_0",
        "base_1",
        "tw0_s",
        "tw0_w_0",
        "tw0_w_1",
        "tw0_n",
        "tw0_e_0",
        "tw0_e_1"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "发射塔第二层: 六片蓝色方板骑上第一层墙顶, 上下边完整贴合。",
      "tip": "两层墙环已经够高 —— D2 不需要三层塔, 弹珠从 z=2 出发。",
      "tiles_to_add": [
        "tw1_s",
        "tw1_w_0",
        "tw1_w_1",
        "tw1_n",
        "tw1_e_0",
        "tw1_e_1"
      ],
      "highlight_tiles": [
        "tw0_s",
        "tw0_e_0"
      ]
    },
    {
      "step_number": 3,
      "description": "盖发球台: 两片黄色方板压住第二层墙顶, 三片挡珠三角围住台沿 (东缘留口)。",
      "tip": "东缘南半格空着 —— 那是弹珠滑向首段坡道的出珠口。",
      "tiles_to_add": [
        "deck_0",
        "deck_1",
        "drail_w",
        "drail_n",
        "drail_s"
      ],
      "highlight_tiles": [
        "tw1_s",
        "tw1_e_0"
      ]
    },
    {
      "step_number": 4,
      "description": "首段坡道 (整段成组): 塔东侧立桥墩与橙色门框立柱, 坡道顶边吸出珠口, 南轨转接台压住墩顶与坡尾。",
      "tip": "门框立柱就是第一道分流门 —— 桥墩-坡道-转接台三件互吸应纹丝不动。",
      "tiles_to_add": [
        "p1a",
        "gate_e0",
        "ramp_1",
        "plat_s",
        "rail1_s"
      ],
      "highlight_tiles": [
        "deck_0",
        "tw1_e_0"
      ]
    },
    {
      "step_number": 5,
      "description": "分流枢纽: 北轨转接台与三座橙色门框方 —— 与首段立柱合计四道门洞, 弹珠选轨!",
      "tip": "门框门洞是 T17 负空间 —— 北轨走 y=1, 南轨走 y=0, 实物跑珠看哪轨更顺!",
      "tiles_to_add": [
        "plat_n",
        "gate_n0",
        "gate_n1",
        "gate_s1"
      ],
      "highlight_tiles": [
        "plat_s",
        "gate_e0"
      ]
    },
    {
      "step_number": 6,
      "description": "北轨下坡: 立桥墩, 橙色坡道从北轨转接台东沿下探, 铺转接台与北接珠池。",
      "tip": "池底西缘紧吸轨末转接台东沿 —— 北轨一路贯通!",
      "tiles_to_add": [
        "p2n",
        "ramp_n",
