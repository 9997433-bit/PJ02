        "signal_tower"
      ],
      "highlight_tiles": [
        "canal_5",
        "canal_6"
      ]
    },
    {
      "step_number": 5,
      "description": "装两道闸门: 橙色立板竖边咬进闸墙拐角, 底边整边吸拼缝。",
      "tip": "下游门放船进闸, 上游门挡住高位水 —— 一次只开一道。",
      "tiles_to_add": [
        "gate_low",
        "gate_high"
      ],
      "highlight_tiles": [
        "lock_s1",
        "lock_n2"
      ]
    },
    {
      "step_number": 6,
      "description": "立高位水道侧墙: 六片灰墙沿水道两侧排到东头。",
      "tip": "墙脚踩拼缝竖边互咬 —— 高位水道的箱壁越砌越长。",
      "tiles_to_add": [
