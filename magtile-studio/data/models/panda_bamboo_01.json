        "ground_4_0"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺竹林中段两行: 方板与长板拼出斑驳的林下光影。",
      "tip": "行行等边互吸 —— 熊猫的墙脚要踩这些拼缝。",
