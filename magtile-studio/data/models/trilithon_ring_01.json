  "steps": [
    {
      "step_number": 1,
      "description": "铺祭坛: 绿色大方板放正中当青草祭坛 —— 大方板一片顶四片, 祭坛要又大又平。",
      "tip": "",
      "tiles_to_add": [
        "altar"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "立南门铺参道: 内石板脚整边吸祭坛南边, 门楣两条长边同时压住两块石板顶, 两节黄色参道从外石板脚下一字铺出去。",
      "tip": "门楣两端都有石板托着 —— 剪掉一边还有另一边, 这就是三石塔站了五千年的秘密。",
      "tiles_to_add": [
