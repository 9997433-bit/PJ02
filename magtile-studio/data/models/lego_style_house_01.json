  "steps": [
    {
      "step_number": 1,
      "description": "铺草坪南排: 4 片绿色方板加 1 片灰色长板 (环屋步道南段), 入户步道口开在南沿正中偏东。",
      "tip": "草坪铺在桌面中央, 灰色长板的长边就是主楼南墙的地基线。",
      "tiles_to_add": [
        "lw_0_0",
        "lr_s",
        "lw_3_0",
        "lw_4_0",
        "lw_5_0"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺草坪中部: 西东两片灰色长板竖铺、室内两片绿色长板横铺, 再补东侧 4 片绿色方板 —— 环屋步道围出主楼地基。",
      "tip": "长板环环相扣, 主楼的每条墙底线都落在长板长边上。",
      "tiles_to_add": [
        "lr_w",
        "lr_f0",
        "lr_f1",
        "lr_e",
        "lw_4_1",
        "lw_5_1",
        "lw_4_2",
        "lw_5_2"
      ],
      "highlight_tiles": [
        "lr_s",
        "lw_3_0"
      ]
    },
    {
      "step_number": 3,
      "description": "铺草坪北部: 环屋步道北段长板加 4 片方板, 再补齐最北一排 6 片 —— 6x5 院子就绪。",
      "tip": "院子铺好了, 别墅马上开工。",
      "tiles_to_add": [
        "lr_n",
        "lw_0_3",
        "lw_3_3",
        "lw_4_3",
        "lw_5_3",
        "lw_0_4",
