  "steps": [
    {
      "step_number": 1,
      "description": "铺庭院地台: 两排清灰相间的方板, 中间留出走向拜月台的甬道视线。",
      "tip": "中秋夜全家在庭院集合 —— 地台边缘就是待会儿立灯笼的地方。",
      "tiles_to_add": [
        "yard_0_f",
        "yard_1_f",
        "yard_2_f",
        "yard_0_n",
        "yard_1_n",
        "yard_2_n"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "立一层台基的南墙与东墙: 红色方板沿庭院北缝立起, 转角竖边互咬。",
      "tip": "南墙墙脚正好踩住庭院拼缝, 台基和庭院从此连成一体。",
      "tiles_to_add": [
        "t1_s_0",
        "t1_s_1",
        "t1_s_2",
        "t1_e_0",
        "t1_e_1",
        "t1_e_2"
      ],
      "highlight_tiles": [
        "yard_0_n",
        "yard_2_n"
      ]
    },
    {
      "step_number": 3,
      "description": "立一层台基的北墙与西墙: 四面红墙合围, 轻推整圈应一起联动。",
      "tip": "四角竖边两两互咬 —— 合围的环比四面单墙结实得多。",
      "tiles_to_add": [
        "t1_n_0",
        "t1_n_1",
        "t1_n_2",
        "t1_w_0",
        "t1_w_1",
        "t1_w_2"
      ],
      "highlight_tiles": [
        "t1_s_0",
        "t1_e_0"
      ]
    },
    {
      "step_number": 4,
      "description": "铺一层台面: 周边八片黄色方板整边压住墙顶, 中心一片最后落位四邻互吸。",
      "tip": "先铺贴墙的, 再补中心 —— 每片都有现成的边可以吸。",
      "tiles_to_add": [
        "deck1_0_0",
        "deck1_1_0",
        "deck1_2_0",
        "deck1_0_2",
        "deck1_1_2",
        "deck1_2_2",
        "deck1_0_1",
        "deck1_2_1",
        "deck1_1_1"
      ],
      "highlight_tiles": [
        "t1_s_1",
        "t1_n_1"
      ]
    },
    {
      "step_number": 5,
      "description": "立二层月台的南墙与东西短墙: 南墙踩台面拼缝, 短墙底边同时吸台面边缘与一层墙顶。",
      "tip": "二层不盖满整层 —— 它整个退到北缘, 前面空出来的就是拜月台。",
      "tiles_to_add": [
        "t2_s_0",
        "t2_s_1",
        "t2_s_2",
        "t2_w",
        "t2_e"
      ],
      "highlight_tiles": [
        "deck1_0_2",
        "deck1_2_2"
      ]
    },
    {
      "step_number": 6,
      "description": "立二层北墙: 三片红墙骑上一层北墙顶, 墙上墙上下边完整贴合。",
      "tip": "北面从地面数上来足足两层高 —— 这是拜月台的靠山。",
      "tiles_to_add": [
        "t2_n_0",
        "t2_n_1",
        "t2_n_2"
      ],
      "highlight_tiles": [
        "t1_n_0",
        "t1_n_2"
      ]
    },
    {
      "step_number": 7,
      "description": "铺二层台面: 三片黄色方板压住二层墙顶, 高台落成。",
      "tip": "台面四边都吸在墙顶上, 高台稳稳当当。",
      "tiles_to_add": [
        "deck2_0",
        "deck2_1",
        "deck2_2"
      ],
      "highlight_tiles": [
        "t2_s_1",
        "t2_n_1"
      ]
    },
    {
      "step_number": 8,
      "description": "请出满月: 黄色六边形立在二层台面南沿正中, 底边整边吸住沿口。",
      "tip": "六边形立起来就是挂在高台上的一轮满月 —— 今晚月亮最圆!",
      "tiles_to_add": [
        "moon"
      ],
      "highlight_tiles": [
        "deck2_1"
      ]
    },
    {
      "step_number": 9,
      "description": "玉兔登台: 两片清色方板并肩踩上一层台面拼缝, 两根瘦高尖耳竖在头顶。",
      "tip": "兔耳是全模型最高点 —— 玉兔仰着头, 正好望向身后的满月。",
      "tiles_to_add": [
        "rabbit_w",
        "rabbit_e",
        "rabbit_ear_w",
        "rabbit_ear_e"
      ],
      "highlight_tiles": [
        "deck1_0_1",
        "deck1_1_1"
      ]
    },
    {
      "step_number": 10,
