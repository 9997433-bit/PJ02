  "steps": [
    {
      "step_number": 1,
      "description": "铺观测坪南两行: 灰绿相间的单位方板行行等边互吸。",
      "tip": "蓝色那格要放在东边第二行 —— 它是雨量筒的接水底格。",
      "tiles_to_add": [
        "pad_0_0",
        "pad_1_0",
        "pad_2_0",
        "pad_3_0",
        "pad_4_0",
        "pad_0_1",
        "pad_1_1",
        "pad_2_1",
        "pad_3_1",
        "pad_4_1"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺观测坪北两行: 再来十片, 整片场坪连成一张网。",
      "tip": "所有仪器都要踩坪上的拼缝, 每一道缝都是一条磁力吸边。",
      "tiles_to_add": [
        "pad_0_2",
        "pad_1_2",
        "pad_2_2",
        "pad_3_2",
        "pad_4_2",
        "pad_0_3",
