  "steps": [
    {
      "step_number": 1,
      "description": "铺靶墙行: 四片单位方板 + 长板 + 单位方板, 靶楼和机架的脚都踩这行。",
      "tip": "城堡运动会要开投准表演啦! 先把演武场的地坪铺平整。",
      "tiles_to_add": [
        "g1_0",
        "g1_1",
        "g1_2",
        "g1_3",
        "g1_e",
        "g1_6"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺靶墙后行: 和上一行等长边互吸, 靶楼的北脚也要落在单位方板上。",
      "tip": "墙脚下必须是单位方板 —— 墙底边要和方板边等长吸合。",
      "tiles_to_add": [
        "g2_0",
        "g2_1",
        "g2_2",
        "g2_3",
        "g2_e",
        "g2_6"
      ],
      "highlight_tiles": [
        "g1_0"
      ]
    },
    {
      "step_number": 3,
      "description": "铺石弹行: 石弹金字塔底下那格一定要是单位方板。",
      "tip": "石弹堆的四条底边都要整边吸住脚下的方板。",
      "tiles_to_add": [
        "g0_w",
        "g0_2",
        "g0_3",
        "g0_4",
        "g0_5",
        "g0_6"
      ],
      "highlight_tiles": [
        "g1_2"
      ]
    },
    {
      "step_number": 4,
      "description": "铺北侧草坪收口: 三块绿色长板 + 一片方板, 演武场围合完成。",
      "tip": "相邻行等长边互吸 —— 演武场的地基连成一体。",
      "tiles_to_add": [
        "g3_w",
        "g3_m",
        "g3_e",
        "g3_6"
      ],
      "highlight_tiles": [
        "g2_0"
      ]
    },
    {
      "step_number": 5,
      "description": "砌靶楼一层墙环: 六片石墙四角竖边互咬, 围成 1x2 的闭环。",
      "tip": "闭环墙才站得稳 —— 每个拐角都有两条竖边互相咬住。",
      "tiles_to_add": [
        "t1_w_1",
        "t1_w_2",
        "t1_e_1",
        "t1_e_2",
        "t1_s",
        "t1_n"
      ],
      "highlight_tiles": [
        "g1_0",
        "g2_0"
      ]
    },
    {
      "step_number": 6,
      "description": "摞二层靶窗环: 东面两扇窗格方正对投石机, 就是今天的靶窗。",
      "tip": "底边与一层墙顶整边共线吸合 —— 看谁能把彩弹投进靶窗!",
      "tiles_to_add": [
        "t2_w_1",
