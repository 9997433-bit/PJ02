  "steps": [
    {
      "step_number": 1,
      "description": "铺园路: 五片灰色方板围出框外走道, 中间留 2x2 给花床。",
      "tip": "园路是围栏的脚位 —— 拼缝对齐, 墙才站得稳。",
      "tiles_to_add": [
        "path_0_0",
