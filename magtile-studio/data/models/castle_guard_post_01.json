  "steps": [
    {
      "step_number": 1,
      "description": "铺岗房地台: 两片灰色长方板并排吸成 2x2 的石地面。",
      "tip": "长边贴长边 —— 地台是岗楼的根, 拼缝要严丝合缝。",
      "tiles_to_add": [
        "floor_s",
        "floor_n"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "立南面城门墙: 紫色门框方的门洞给士兵进出, 黄色窗格方是射箭孔。",
      "tip": "两片竖边互咬、墙脚踩住地台南缘 —— 门洞要正对来路。",
      "tiles_to_add": [
        "gate",
        "arrow_slit"
      ],
      "highlight_tiles": [
        "floor_s"
      ]
    },
    {
      "step_number": 3,
      "description": "立东西两面石墙: 每面两片灰方, 墙脚踩地台拼缝、与南墙咬角。",
      "tip": "角上竖边咬住了, 墙才推不倒 —— 每放一片都捏捏角。",
      "tiles_to_add": [
        "wall_w_s",
        "wall_w_n",
        "wall_e_s",
        "wall_e_n"
      ],
      "highlight_tiles": [
        "gate",
        "arrow_slit"
      ]
    },
    {
      "step_number": 4,
      "description": "立北墙合围: 两片灰方补上最后一面, 岗房锁成一圈。",
      "tip": "从门洞往里看一眼 —— 一间能站岗的小石屋成形了。",
      "tiles_to_add": [
        "wall_n_w",
        "wall_n_e"
      ],
      "highlight_tiles": [
        "wall_w_n",
        "wall_e_n"
      ]
    },
    {
      "step_number": 5,
      "description": "收平顶甲板: 两片蓝色长板压满四面墙顶, 岗楼有了第二层。",
      "tip": "每片长板要同时压住三面墙顶再松手, 两片中缝互吸。",
      "tiles_to_add": [
        "deck_s",
        "deck_n"
      ],
      "highlight_tiles": [
        "wall_n_w",
        "gate"
      ]
    },
    {
      "step_number": 6,
      "description": "摆雉堞: 四枚红色三角沿甲板边转着圈站, 一面一枚对角错开。",
      "tip": "底边整条吸住甲板沿 —— 错位站的垛口从哪边看都威风。",
      "tiles_to_add": [
        "merlon_s",
        "merlon_e",
        "merlon_n",
        "merlon_w"
      ],
      "highlight_tiles": [
        "deck_s",
        "deck_n"
      ]
    },
    {
      "step_number": 7,
      "description": "接两翼城墙: 两侧短墙咬住楼角接地立稳, 墙顶各站一枚城齿 —— 换岗!",
      "tip": "翼墙竖边与楼角互咬、墙脚落地 —— 以后城墙就从这里往两边长。",
      "tiles_to_add": [
        "wing_w",
        "wing_e",
        "wing_w_top",
        "wing_e_top"
      ],
      "highlight_tiles": [
        "wall_w_s",
        "wall_e_s"
      ]
    }
  ]
