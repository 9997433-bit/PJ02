        "tf_n_3_3",
        "tf_n_3_4"
      ],
      "highlight_tiles": [
        "tf_s_1_1"
      ]
    },
    {
      "step_number": 4,
      "description": "铺东列广场砖收口: 地坪 5x5 围合完成。",
      "tip": "相邻格等长边互吸 —— 整片地坪连成一体, 场馆放线完毕。",
      "tiles_to_add": [
        "pz_e_0",
        "pz_e_1",
        "pz_e_2",
        "pz_e_3",
        "pz_e_4"
      ],
      "highlight_tiles": [
        "walk_3"
      ]
    },
    {
      "step_number": 5,
      "description": "砌南缸南墙与西墙: 五片窗格方玻璃, 四角竖边互咬。",
      "tip": "窗格方就是玻璃幕墙 —— 镂空外框照样整边吸合。",
      "tiles_to_add": [
        "ts_s_1",
        "ts_s_2",
        "ts_s_3",
        "ts_w_0",
        "ts_w_1"
      ],
      "highlight_tiles": [
        "tf_s_1_0"
      ]
    },
    {
