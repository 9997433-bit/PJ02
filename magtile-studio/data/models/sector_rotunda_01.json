      ]
    },
    {
      "step_number": 11,
      "description": "戴三角柱冠: 四片金色三角骑上柱顶, 与殿顶金冠遥相呼应。",
      "tip": "柱冠重心正压柱顶铰链线 —— 力矩为零的收笔。",
      "tiles_to_add": [
        "pc_sw",
