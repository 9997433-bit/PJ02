  "steps": [
    {
      "step_number": 1,
      "description": "铺荒原南半: 2 行红色地坪, 每行 方板+长板+长板+方板 x3 (8x2)。",
      "tip": "长板拼缝落在 y=1 线上 —— 轮组马上要整边吸在这条缝上。",
      "tiles_to_add": [
        "ml_0",
        "ma_0",
        "mb_0",
        "mc_0",
        "md_0",
        "me_0",
        "ml_1",
        "ma_1",
        "mb_1",
        "mc_1",
        "md_1",
        "me_1"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺荒原北半: 再铺 2 行, 荒原合拢成 8x4 火星地表。",
      "tip": "红色大地一望无际 —— 这里是探测车的着陆区。",
      "tiles_to_add": [
        "ml_2",
        "ma_2",
        "mb_2",
        "mc_2",
