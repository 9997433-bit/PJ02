  "steps": [
    {
      "step_number": 1,
      "description": "铺设腹底: 4 片黄色长方形纵向平铺 ([2,6]x[0,2]), 长边逐片互吸成一整块。",
      "tip": "鳄鱼是贴地爬行的动物 —— 腹底就是它贴住河滩的肚皮。",
      "tiles_to_add": [
        "bel_2",
        "bel_3",
        "bel_4",
        "bel_5"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "竖立南侧壁: 4 片绿色正方形沿腹底南沿一字立起, 底边吸腹底短边。",
      "tip": "相邻侧壁的竖边也要两两吸牢, 躯干才结实。",
      "tiles_to_add": [
        "bs_2",
        "bs_3",
        "bs_4",
        "bs_5"
      ],
      "highlight_tiles": [
        "bel_2",
        "bel_5"
      ]
    },
    {
      "step_number": 3,
      "description": "竖立北侧壁: 4 片绿色正方形沿北沿立起, 与南侧壁隔腹相望。",
      "tip": "南北侧壁完全对称, 中间就是鳄鱼厚实的身体。",
      "tiles_to_add": [
        "bn_2",
        "bn_3",
        "bn_4",
        "bn_5"
      ],
      "highlight_tiles": [
        "bs_2"
      ]
    },
    {
      "step_number": 4,
      "description": "封前胸与后臀: 头尾两端各立 2 片绿色正方形, 竖边与侧壁拐角互吸。",
      "tip": "前胸墙顶马上要吸住张开的上颚 —— 位置务必摆正。",
      "tiles_to_add": [
        "chest_0",
        "chest_1",
        "rump_0",
        "rump_1"
      ],
      "highlight_tiles": [
        "bs_2",
        "bs_5",
        "bn_2",
        "bn_5"
      ]
    },
    {
      "step_number": 5,
      "description": "盖背甲南排: 4 片绿色方板压住南侧壁与前后墙顶边。",
      "tip": "背甲每片都要同时吸住墙顶边与相邻背甲边。",
      "tiles_to_add": [
        "dk_2_0",
        "dk_3_0",
        "dk_4_0",
        "dk_5_0"
      ],
      "highlight_tiles": [
        "bs_2",
        "chest_0"
      ]
    },
    {
      "step_number": 6,
      "description": "盖背甲北排: 再压 4 片, 躯干合拢成结实的箱形。",
      "tip": "箱形躯干剪断任何一条缝都塌不了 —— 这就是鳄鱼的铠甲。",
      "tiles_to_add": [
        "dk_2_1",
        "dk_3_1",
        "dk_4_1",
        "dk_5_1"
      ],
      "highlight_tiles": [
        "dk_2_0"
      ]
    },
    {
      "step_number": 7,
      "description": "立起背棘: 4 片橙色等边三角沿背脊拼缝一字立起, 底边吸背甲缝。",
      "tip": "背棘立在拼缝正上方, 一条缝同时咬住左右两片背甲。",
      "tiles_to_add": [
        "ridge_2",
        "ridge_3",
        "ridge_4",
        "ridge_5"
      ],
      "highlight_tiles": [
        "dk_2_0",
        "dk_5_1"
      ]
    },
    {
      "step_number": 8,
      "description": "铺下颚: 头前平铺 4 片绿色方板, 东沿吸前胸墙底边。",
      "tip": "下颚贴地摊开 —— 鳄鱼正准备张开血盆大口。",
      "tiles_to_add": [
        "jaw_0_0",
