  "steps": [
    {
      "step_number": 1,
      "description": "铺瓜田南行: 石板小径正对将来的大门, 东边留出小南瓜的底格。",
      "tip": "秋收之夜, 瓜田里要点起一盏大灯笼 —— 先把小院铺平整。",
      "tiles_to_add": [
        "field_0_0",
        "path",
        "field_3_0",
        "field_4_0",
        "field_5_0"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺中段两行: 黄色的是屋里的烛光地板, 墙脚要踩住这些拼缝。",
      "tip": "行行等边互吸 —— 屋里先铺一层暖暖的烛光色。",
      "tiles_to_add": [
        "field_0_1",
        "floor_1_1",
        "floor_2_1",
        "floor_3_1",
        "field_4_1",
        "field_0_2",
        "floor_1_2",
        "floor_2_2",
        "floor_3_2",
        "field_4_2"
      ],
      "highlight_tiles": [
        "path"
      ]
    },
    {
      "step_number": 3,
      "description": "铺瓜田北行: 西边紫色花圃, 东边再留一格小南瓜底格。",
      "tip": "单位方板的四条边都能整边吸合 —— 小南瓜就要种在那格上。",
      "tiles_to_add": [
        "field_0_3",
        "field_2_3",
        "field_4_3",
        "field_5_3"
      ],
      "highlight_tiles": [
        "floor_1_2"
      ]
    },
    {
      "step_number": 4,
      "description": "立一层南墙与西墙: 黄色门框方是南瓜灯咧开的嘴巴, 也是大门。",
      "tip": "嘴巴先上墙 —— 从小径走过来, 正好走进南瓜的笑容里。",
      "tiles_to_add": [
        "w1_s_w",
        "mouth",
        "w1_s_e",
        "w1_w_s",
        "w1_w_n"
      ],
      "highlight_tiles": [
        "floor_1_1"
      ]
    },
    {
      "step_number": 5,
      "description": "合一层北墙与东墙: 十片墙环四角竖边互咬闭环。",
      "tip": "闭环墙才站得稳 —— 每个拐角都有两条竖边互相咬住。",
      "tiles_to_add": [
        "w1_n_w",
        "w1_n_m",
        "w1_n_e",
        "w1_e_s",
        "w1_e_n"
      ],
      "highlight_tiles": [
        "w1_s_w"
      ]
    },
    {
      "step_number": 6,
      "description": "摞二层南墙与西墙: 两扇黄窗格一左一右, 是南瓜灯发光的眼睛。",
      "tip": "底边与一层墙顶整边共线吸合 —— 眼睛亮起来啦!",
