        "bx_s_0"
      ]
    },
    {
      "step_number": 7,
      "description": "压方箱台面: 4 片红色方板压住围墙顶边、中缝互吸。",
      "tip": "台面四板再加一圈水平环, 箱顶稳如平地。",
      "tiles_to_add": [
