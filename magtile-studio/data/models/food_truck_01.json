      ]
    },
    {
      "step_number": 10,
      "description": "挑遮阳篷: 车顶前沿向南平挑 3 片红黄条纹方板, 篷片之间也要互吸。",
      "tip": "每片篷力矩 15, 三片共用一条铰链线 (预算 60) —— 刚刚好, 篷上别再放东西。",
      "tiles_to_add": [
        "awn_1",
        "awn_2",
        "awn_3"
      ],
      "highlight_tiles": [
