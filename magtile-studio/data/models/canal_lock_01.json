      ]
    },
    {
      "step_number": 9,
      "description": "合上游闸门与东壁: 西侧两片灰墙紧闭顶住高水位, 箱环锁死。",
      "tip": "四角竖边互咬, 墙环闭合 —— 高水位这就装得住了。",
      "tiles_to_add": [
        "gate_up_s",
        "gate_up_n",
        "pl_e_1",
        "pl_e_2"
      ],
      "highlight_tiles": [
