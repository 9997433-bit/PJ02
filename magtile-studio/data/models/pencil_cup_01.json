  "steps": [
    {
      "step_number": 1,
      "description": "铺桌垫: 六片灰黄棋盘方板逐片整边互吸, 铺成 3x2 的地基。",
      "tip": "棋盘颜色错开铺, 拼缝正好留给筒墙和便签夹踩。",
      "tiles_to_add": [
        "mat_0_0",
        "mat_0_1",
        "mat_1_0",
        "mat_1_1",
        "mat_2_0",
        "mat_2_1"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "起铅笔主筒第一层: 四片蓝色方板合围左前格, 竖棱角缝两两互吸。",
      "tip": "四片墙围成环, 推一下整筒一起动才算吸对。",
      "tiles_to_add": [
        "cup_s0",
        "cup_e0",
        "cup_n0",
        "cup_w0"
      ],
      "highlight_tiles": [
        "mat_0_0"
      ]
    },
    {
      "step_number": 3,
      "description": "主筒加高第二层: 四片青色窗格方上下整边贴合, 窗格里能看到笔身。",
      "tip": "窗格方外框和方板一模一样, 吸法完全相同。",
      "tiles_to_add": [
        "cup_s1",
        "cup_e1",
        "cup_n1",
        "cup_w1"
      ],
      "highlight_tiles": [
        "cup_s0"
      ]
    },
    {
      "step_number": 4,
      "description": "围便签矮筒: 四片橙色方板合围右前格, 一层高刚好露出便签头。",
      "tip": "",
      "tiles_to_add": [
        "tray_s",
        "tray_e",
        "tray_n",
        "tray_w"
      ],
      "highlight_tiles": [
        "mat_2_0"
      ]
    },
    {
      "step_number": 5,
      "description": "夹便签夹: 两片红色立三角骑住中间两条拼缝的后半段。",
      "tip": "立三角骑缝而立, 一格缝隙正好夹住课程表。",
      "tiles_to_add": [
        "clip_w",
        "clip_e"
      ],
      "highlight_tiles": [
        "mat_1_1"
      ]
    },
    {
      "step_number": 6,
      "description": "种北沿灌木: 三片草绿三角骑住桌垫北沿整边, 书桌也要有绿意。",
      "tip": "",
      "tiles_to_add": [
        "bush_0",
