  "steps": [
    {
      "step_number": 1,
      "description": "铺街面南排: 担架车底板长板居西 (北长边就是车轮缝), 青色连廊步道两格居中, 黄色救护车位标线长板居东。",
      "tip": "长板 [1,3] 的两条长边将来要接住担架车的双轮, 务必对齐。",
      "tiles_to_add": [
        "g0_w",
        "g0_gur",
        "g0_l0",
        "g0_l1",
        "g0_bay"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "补齐街面北排: 与南排一一对缝, 车轮缝 y=1 全线贯通。",
      "tip": "救护车沿黄色标线停靠, 病人下车正对连廊口。",
      "tiles_to_add": [
