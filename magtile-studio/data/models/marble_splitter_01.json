  "steps": [
    {
      "step_number": 1,
      "description": "起拱廊西段: 两片蓝色门框方横向站好, 一片黄色跑道板压住两墩顶。",
      "tip": "门框方的门洞连成一条穿廊视线 —— 跑道板边与墩顶边等长互吸。",
      "tiles_to_add": [
        "pier_0",
        "pier_1",
        "track_0"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "续拱廊东段: 再两墩两板, 三片跑道板在墩顶连成 z=1 高架跑道。",
      "tip": "每片跑道板都骑住一墩一缝 —— 桥墩与跑道咬成一串环。",
      "tiles_to_add": [
        "pier_2",
        "track_1",
        "pier_3",
        "track_2"
      ],
      "highlight_tiles": [
        "pier_1",
        "track_0"
      ]
    },
    {
      "step_number": 3,
      "description": "装发球拱与道沿: 门框骑上跑道西端当发球拱, 六片红色三角挡珠护住南北道沿。",
      "tip": "弹珠从发球拱门洞放进跑道 —— 东端不设挡珠, 那是出珠口。",
      "tiles_to_add": [
        "start_arch",
        "rail_s0",
        "rail_n0",
        "rail_s1",
        "rail_n1",
        "rail_s2",
        "rail_n2"
      ],
      "highlight_tiles": [
        "track_0",
        "track_2"
      ]
    },
    {
      "step_number": 4,
      "description": "接落地段: 橙色坡道顶边吸住跑道东端, 坡尾落地由黄色落地板接住。",
      "tip": "坡道顶边同时吸跑道板边与东墩顶 —— 弹珠顺 30 度斜面冲下来。",
      "tiles_to_add": [
        "ramp_dn",
        "pad"
      ],
      "highlight_tiles": [
        "track_2",
        "pier_3"
      ]
    },
    {
      "step_number": 5,
      "description": "铺 T 形分流口: 三片黄色方板横排, 绿色分流挡板立在正东迎珠。",
      "tip": "弹珠冲过落地板撞上挡板 —— 向北还是向南, 每次都是悬念。",
      "tiles_to_add": [
        "cross_c",
        "cross_n",
        "cross_s",
        "wedge"
      ],
      "highlight_tiles": [
        "pad"
      ]
    },
    {
      "step_number": 6,
      "description": "立地面分流门: 南北横缝上各立一道蓝色门框, 弹珠必从门洞穿出。",
      "tip": "门框方第三种用法: 桥墩、发球拱之后, 这次当地面分流门。",
      "tiles_to_add": [
        "gate_n",
        "gate_s"
      ],
      "highlight_tiles": [
        "cross_c",
        "wedge"
      ]
    },
    {
      "step_number": 7,
      "description": "砌北接珠湾: 青色湾底接住门洞, 得分窗封住北端, 两侧三角挡珠。",
      "tip": "弹珠穿过北门洞撞上得分窗 —— 青色湾记一分!",
      "tiles_to_add": [
        "bay_n",
        "score_n",
        "bn_w",
        "bn_e"
      ],
      "highlight_tiles": [
        "gate_n"
      ]
    },
    {
      "step_number": 8,
      "description": "砌南接珠湾 (镜像): 紫色湾底 + 得分窗 + 侧沿三角 —— 拱廊分流滚珠道完工, 放珠开跑!",
      "tip": "轮流放珠数两湾进珠数 —— 实物跑珠才算验收合格!",
