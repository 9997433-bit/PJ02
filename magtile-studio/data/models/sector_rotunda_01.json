  "steps": [
    {
      "step_number": 1,
      "description": "铺柱廊地板: 七片汉白玉石板沿东西向排开, 半圆殿由此向南敞开.",
      "tip": "这是全殿的受力底盘 —— 柱脚与殿内地板都从这里接龙.",
      "tiles_to_add": [
        "porch_0",
        "porch_1",
        "porch_2",
        "porch_3",
        "porch_4",
        "porch_5",
        "porch_6"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "立柱廊第一批: 西半四根方柱 (x=0..3), 柱脚整边踩地板北沿.",
      "tip": "每根柱只有一片高 —— 柱顶高度就是扇形拱的落点.",
      "tiles_to_add": [
        "col_0",
