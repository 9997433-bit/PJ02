  "steps": [
    {
      "step_number": 1,
      "description": "铺马路南排: 轮缝长板对齐 y=1 线, 东端两条透明斑马线。",
      "tip": "两片长板拼缝在 x=3 —— 前后轮组都靠这排格线吸合。",
      "tiles_to_add": [
        "r0_0",
        "r0_a",
        "r0_b",
        "r0_z1",
        "r0_z2",
        "r0_z3"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺行车道: 中排 6 片, 出租车就停在这条车道上。",
      "tip": "车底长板的两条长边就是南北轮组的吸合线。",
      "tiles_to_add": [
