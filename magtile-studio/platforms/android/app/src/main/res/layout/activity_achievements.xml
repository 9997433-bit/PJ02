<?xml version="1.0" encoding="utf-8"?>
<!-- 成就墙全览 (对齐桌面 Qt AchievementsPage §7.1): 标题栏 + 引导语 +
     徽章卡片网格 (两列, 行由代码填充) + 页脚只报喜不催促 (§4.3) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/magtile_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/magtile_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- 大返回键 (触控目标 >= 48dp) -->
        <TextView
            android:id="@+id/achievements_back"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/back_button"
            android:textColor="@color/magtile_on_primary"
            android:textSize="@dimen/text_section"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/achievements_title"
            android:textColor="@color/magtile_on_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:text="@string/achievements_hint"
        android:textColor="@color/magtile_text_secondary"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <!-- 徽章卡片网格: 两列一行, 行由代码按数据填充 -->
        <LinearLayout
            android:id="@+id/badge_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp" />
    </ScrollView>

    <!-- 页脚: 只报喜不催促 (§4.3) -->
    <TextView
        android:id="@+id/achievements_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/magtile_card"
        android:elevation="6dp"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/magtile_text_secondary"
        android:textSize="13sp" />

</LinearLayout>
