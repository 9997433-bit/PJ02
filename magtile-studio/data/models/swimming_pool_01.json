{
  "schema_version": 1,
  "id": "swimming_pool_01",
  "name": "游泳池",
  "name_en": "Swimming Pool",
  "description": "标准泳道游泳池: 12 片长方形拼出 6x4 青透相间的四条泳道, 一圈方板池岸环绕 (黄色转角升起四面泳旗); 西端双柱门架跳水台托起跨接平台, 透明跳板向池面悬挑, 东端三只直角三角出发台踏上岸沿, 南岸桥式救生员椅居高守望, 北岸粉色四坡遮阳伞自锁合拢 —— 预备, 跳!",
  "difficulty": 3,
  "total_pieces": 64,
  "tags": [
    "运动",
    "游泳",
    "夏日",
    "场景"
  ],
