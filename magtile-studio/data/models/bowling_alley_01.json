  "steps": [
    {
      "step_number": 1,
      "description": "铺球道: 南端两片清色犯规线方板, 向北接四条橙色木纹长板。",
      "tip": "脚不能越过犯规线 —— 球道从这里一直铺到瓶台脚下。",
      "tiles_to_add": [
        "lane_foul_w",
        "lane_foul_e",
        "lane_w_1",
        "lane_w_3",
        "lane_e_1",
        "lane_e_3"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺西回球廊: 五片黄色单位方板贴着球道西沿排成一列。",
      "tip": "必须用单位方板 —— 沟墙的每段墙脚都要有等长拼缝可吸。",
      "tiles_to_add": [
        "walk_w_0",
        "walk_w_1",
        "walk_w_2",
        "walk_w_3",
        "walk_w_4"
      ],
      "highlight_tiles": [
        "lane_foul_w"
      ]
    },
    {
      "step_number": 3,
      "description": "铺东回球廊: 五片黄色单位方板贴着球道东沿排成一列。",
      "tip": "打完的球从这两条廊道滚回来 —— 东西各一条。",
      "tiles_to_add": [
        "walk_e_0",
        "walk_e_1",
        "walk_e_2",
        "walk_e_3",
        "walk_e_4"
      ],
      "highlight_tiles": [
        "walk_w_0"
      ]
    },
    {
      "step_number": 4,
      "description": "立西沟墙: 五片灰墙踩 x=2 拼缝, 竖边逐片相咬成链。",
      "tip": "沟墙挡住歪球 —— 掉沟的球就沿着墙根滚到底。",
      "tiles_to_add": [
        "gut_w_0",
        "gut_w_1",
        "gut_w_2",
        "gut_w_3",
        "gut_w_4"
      ],
      "highlight_tiles": [
        "walk_w_2"
      ]
    },
    {
      "step_number": 5,
      "description": "立东沟墙: 五片灰墙踩 x=4 拼缝, 与西沟墙隔道相望。",
      "tip": "两道沟墙夹住球道 —— 直球才能冲到瓶阵。",
      "tiles_to_add": [
        "gut_e_0",
        "gut_e_1",
        "gut_e_2",
        "gut_e_3",
        "gut_e_4"
      ],
      "highlight_tiles": [
        "gut_w_0"
      ]
    },
    {
      "step_number": 6,
      "description": "铺瓶台地板 (y [5,7]): 六片蓝色单位方板与球道北端等边互吸。",
      "tip": "瓶台的十道墙脚全踩在这六片方板的拼缝上。",
      "tiles_to_add": [
        "deck_f_1_5",
        "deck_f_1_6",
        "deck_f_2_5",
        "deck_f_2_6",
        "deck_f_3_5",
        "deck_f_3_6"
      ],
      "highlight_tiles": [
        "lane_w_3"
      ]
    },
    {
      "step_number": 7,
      "description": "立瓶台南北墙: 南墙三片正对球道, 北墙三片压住底线。",
      "tip": "南墙就是球道的终点挡板 —— 球瓶要站在它头顶上。",
      "tiles_to_add": [
        "deck_s_1",
        "deck_s_2",
        "deck_s_3",
        "deck_n_1",
        "deck_n_2",
        "deck_n_3"
      ],
      "highlight_tiles": [
        "deck_f_2_5"
      ]
    },
    {
      "step_number": 8,
      "description": "立瓶台东西墙合环: 四片侧墙把瓶台锁成闭环箱体。",
      "tip": "四角竖边互咬 —— 环墙合环, 瓶台稳如磐石。",
      "tiles_to_add": [
        "deck_w_5",
