  "steps": [
    {
      "step_number": 1,
      "description": "拼甲板: 四片灰色长板在桌面拼成 4x2 通长平板, 这就是渡轮的船底。",
      "tip": "长边贴长边、短边贴短边, 拼缝对齐甲板才平整。",
      "tiles_to_add": [
        "deck_fw_s",
        "deck_fw_n",
        "deck_aft_s",
        "deck_aft_n"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "合船头: 两片直角三角在西端共边一咬, 破浪尖就冲在最前面。",
      "tip": "",
      "tiles_to_add": [
        "bow_s",
        "bow_n"
      ],
      "highlight_tiles": [
        "deck_fw_s",
        "deck_fw_n"
      ]
    },
    {
      "step_number": 3,
      "description": "立舷墙: 四片红色长楣踩住甲板两条长边, 一片底边正好吸满两格。",
      "tip": "长楣立起后扶一下两端, 下一步就有横墙来锁角。",
      "tiles_to_add": [
        "bulwark_s_fw",
        "bulwark_s_aft",
        "bulwark_n_fw",
        "bulwark_n_aft"
      ],
      "highlight_tiles": [
        "deck_fw_s",
        "deck_aft_n"
      ]
    },
    {
      "step_number": 4,
      "description": "围驾驶舱: 门框方是登舱门, 三片窗格方是舷窗 —— 墙脚骑拼缝, 竖边咬舷墙。",
      "tip": "前半段甲板故意空着 —— 那是自行车和行李上船的车位。",
      "tiles_to_add": [
        "cabin_door",
