  "steps": [
    {
      "step_number": 1,
      "description": "铺亭基和石板路: 灰色方板放院子正中当亭基, 黄色方板贴在南边当石板路。",
      "tip": "两片方板整边吸合 —— 石板路以后就是进亭子的必经之路。",
      "tiles_to_add": [
        "base",
        "path"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "立凉亭四面窗格墙: 墙脚整边骑住亭基四边, 相邻墙竖棱手拉手围成一圈。",
