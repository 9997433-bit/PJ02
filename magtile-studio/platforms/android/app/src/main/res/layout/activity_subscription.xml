<?xml version="1.0" encoding="utf-8"?>
<!-- 订阅页 (家长门后, UI_UX_SPEC.md §11; 对齐桌面 Qt
     SubscriptionPage 信息结构): 页首免费额度明示 → 订阅说明 →
     订阅生效状态卡 / 三档档位卡 (价格实时读 Play 后台, 查询不可用
     退回温和占位卡) → 主 CTA + 恢复购买 → 开发档模拟开关 (仅
     Debug) → 我们的承诺 → 页脚。红线: 无倒计时/无催促/不索取
     信息; 价格只出现在本页 (儿童侧零价格, 入口经家长门 +
     会话守卫由 SubscriptionActivity 保证)。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/magtile_background"
    android:orientation="vertical">

    <!-- 标题栏 (与库存录入屏同一样式: 主色底 + 大返回键) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/magtile_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/subscription_back"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/subscription_back"
            android:textColor="@color/magtile_on_primary"
            android:textSize="@dimen/text_section"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/subscription_title"
            android:textColor="@color/magtile_on_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <!-- 页首免费额度明示 (§11 反套路即信任, 完成绿浅底) -->
            <TextView
                android:id="@+id/subscription_free_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stat_completed"
                android:gravity="center"
                android:padding="14dp"
                android:text="@string/subscription_free_notice_no_count"
                android:textColor="@color/magtile_success"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <!-- 订阅说明 (只讲价值, 无紧迫话术) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_progress_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/subscription_intro_title"
                    android:textColor="@color/magtile_primary"
                    android:textSize="@dimen/text_section"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/subscription_intro_body"
                    android:textColor="@color/magtile_text_secondary"
                    android:textSize="@dimen/text_secondary" />
            </LinearLayout>

            <!-- 订阅生效状态卡 (已订阅时可见; 完成绿「已拥有」) -->
            <LinearLayout
                android:id="@+id/subscription_active_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_stat_completed"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/subscription_active_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/subscription_active_title"
                    android:textColor="@color/magtile_success"
                    android:textSize="@dimen/text_section"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/subscription_active_body"
                    android:textColor="@color/magtile_text_secondary"
                    android:textSize="@dimen/text_secondary" />
            </LinearLayout>

            <!-- 三档档位卡容器 (item_subscription_plan 按查询结果注入;
                 查询不可用时整组隐藏, 绝不显示空价格卡) -->
            <LinearLayout
                android:id="@+id/subscription_plan_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 查询中 / 查询不可用的温和占位卡 (与桌面「即将上线」同语义) -->
            <TextView
                android:id="@+id/subscription_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_progress_card"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/subscription_loading_products"
                android:textColor="@color/magtile_text_secondary"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />

            <!-- 主 CTA (>= 64dp 主操作按钮 §4.1): 档位可购时发起购买,
                 占位态点按只给温和提示; 已订阅时隐藏 -->
            <TextView
                android:id="@+id/subscription_cta"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_primary_button"
                android:gravity="center"
                android:text="@string/subscription_cta_coming"
                android:textColor="@color/magtile_on_primary"
                android:textSize="@dimen/text_section"
                android:textStyle="bold" />

            <!-- 恢复购买 (换机/重装场景, COMMERCIAL_PLAN §2.2 承诺项) -->
            <TextView
                android:id="@+id/subscription_restore"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_outline_button"
                android:gravity="center"
                android:text="@string/subscription_restore"
                android:textColor="@color/magtile_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <!-- 开发档「模拟已订阅」开关行 (仅 Debug 构建可见,
                 SubscriptionActivity 按 BuildConfig.DEBUG 控制) -->
            <LinearLayout
                android:id="@+id/subscription_dev_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_progress_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/subscription_dev_title"
                        android:textColor="@color/magtile_text_primary"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/subscription_dev_body"
                        android:textColor="@color/magtile_text_secondary"
                        android:textSize="@dimen/text_secondary" />
                </LinearLayout>

                <Switch
                    android:id="@+id/subscription_dev_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- 我们的承诺 (透明条款, §11) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_progress_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/subscription_promises_title"
                    android:textColor="@color/magtile_primary"
                    android:textSize="@dimen/text_section"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/subscription_promise_1"
                    android:textColor="@color/magtile_text_secondary"
                    android:textSize="@dimen/text_secondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/subscription_promise_2"
                    android:textColor="@color/magtile_text_secondary"
                    android:textSize="@dimen/text_secondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/subscription_promise_3"
                    android:textColor="@color/magtile_text_secondary"
                    android:textSize="@dimen/text_secondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/subscription_promise_4"
                    android:textColor="@color/magtile_text_secondary"
                    android:textSize="@dimen/text_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/subscription_footer"
                android:textColor="@color/magtile_text_secondary"
                android:textSize="@dimen/text_secondary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
