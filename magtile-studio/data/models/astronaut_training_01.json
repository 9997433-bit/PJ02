  "steps": [
    {
      "step_number": 1,
      "description": "铺南草坪: 三条绿色长板加一片方板, 短边互吸连成一排。",
      "tip": "宇航员训练第一课: 先把场地铺平整。",
      "tiles_to_add": [
        "gs_0",
        "gs_1",
        "gs_2",
        "gs_3"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺缓冲垫南行: 七片青色方板贴着草坪北边排开。",
      "tip": "离心机脚下全是软垫 —— 训练安全第一。",
      "tiles_to_add": [
