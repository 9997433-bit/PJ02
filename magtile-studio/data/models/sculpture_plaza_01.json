{
  "schema_version": 1,
  "id": "sculpture_plaza_01",
  "name": "雕塑艺术广场",
  "name_en": "Sculpture Plaza 01",
  "description": "全库第一座雕塑群落场景: 7x5 石板广场上五件互不重样的户外雕塑各用一种结构语言 —— 方尖碑两层箱式墙环竖叠、等腰四坡锥收尖 (尖顶 3.94); pi 形拱门双墙托天桥板零悬挑; 现代画屏大正方形整片立起、直角三角斜撑抵脚; 低卧金字塔四棱落地自锁; 悬挑长椅单边铰链托坐板 —— 一场广场上的结构语言展。",
  "difficulty": 3,
  "total_pieces": 56,
  "tags": [
    "博物馆",
    "艺术",
    "雕塑",
    "广场",
    "进阶"
  ],
