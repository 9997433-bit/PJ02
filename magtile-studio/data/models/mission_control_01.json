        "clk_b",
        "top_4",
        "top_5"
      ],
      "highlight_tiles": [
        "scr_0",
        "scr_5"
      ]
    },
    {
      "step_number": 6,
      "description": "起西侧墙: 下素上透两层, 前端直角三角斜撑双边吸合抵住墙角。",
      "tip": "斜撑竖边吸墙角竖边、横边吸地台缝 —— 大厅开口处最需要它。",
      "tiles_to_add": [
        "sw_2_0",
