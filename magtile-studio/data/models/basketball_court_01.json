{
  "schema_version": 1,
  "id": "basketball_court_01",
  "name": "街头篮球场",
  "name_en": "Street Basketball Court",
  "description": "街头篮球半场: 橙色大正方形油漆区领衔 5x4 水泥场地, U 形箱筒篮架塔两层围合、塔口嵌两片窗格方篮板, 红色篮筐平台压顶悬挑; 三面窗格方铁丝网围栏 (南开门框方大门) 与塔身竖边锁扣, 东侧球员长凳悬挑坐板面朝场地, 中场一颗四坡自锁的橙色篮球 —— 嘭、嘭、嘭, 运球声就是街头的心跳。",
  "difficulty": 3,
  "total_pieces": 52,
  "tags": [
    "运动",
    "篮球",
    "街头",
    "场景"
  ],
