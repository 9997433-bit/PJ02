  "steps": [
    {
      "step_number": 1,
      "description": "铺设月面着陆场南半部: 平放 2 排共 10 片正方形, 相邻边互相吸合; 青色片是环形山。",
      "tip": "着陆场要铺在桌面中央: 舷梯还要从北缘伸出一大截。",
      "tiles_to_add": [
        "m_0_0",
        "m_1_0",
        "m_2_0",
        "m_3_0",
        "m_4_0",
        "m_0_1",
        "m_1_1",
        "m_2_1",
        "m_3_1",
        "m_4_1"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "着陆场中部再铺 2 排共 10 片, 与南半部整边贴合。",
      "tip": "每片先对准一条边再松手, 整块月面中间不能留缝。",
      "tiles_to_add": [
