  "steps": [
    {
      "step_number": 1,
      "description": "铺门前行: 两条草地长板夹三片方板, 中间灰色的是青石门阶。",
      "tip": "万圣节的傍晚到啦! 门阶北沿待会儿要咬住南瓜屋的大门墙脚。",
      "tiles_to_add": [
        "g1_w",
        "g1_2",
        "g1_3",
        "g1_4",
        "g1_e"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺南瓜田行: 七片方板等边互吸, 灰色方板续上青石小路。",
      "tip": "小南瓜要种在单位方板上 —— 四条底边都得有整边可吸。",
      "tiles_to_add": [
        "g0_0",
