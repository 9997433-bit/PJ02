  "steps": [
    {
      "step_number": 1,
      "description": "铺湿地坪: 12 片青色方板铺满洗车隧道 (x [2,6], y [2,5])。",
      "tip": "立刷和车轮都要整边吸在这些拼缝上 —— 一格都不能错位。",
      "tiles_to_add": [
        "fl_2_2",
        "fl_2_3",
        "fl_2_4",
        "fl_3_2",
        "fl_3_3",
        "fl_3_4",
        "fl_4_2",
        "fl_4_3",
        "fl_4_4",
        "fl_5_2",
        "fl_5_3",
        "fl_5_4"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺入口与出口引道: 东西各 3 片灰色长板, 车道贯通 8 格。",
      "tip": "西进东出 —— 洗车馆是一条流水线, 不走回头路。",
      "tiles_to_add": [
        "in_2",
        "in_3",
        "in_4",
        "out_2",
        "out_3",
        "out_4"
      ],
      "highlight_tiles": [
        "fl_2_3",
        "fl_5_3"
      ]
    },
    {
      "step_number": 3,
      "description": "立南墙一层: 4 片蓝墙沿 y=2 排开, 墙脚整边吸地坪南沿。",
      "tip": "相邻墙片竖边互咬 —— 整面墙比单片墙稳得多。",
      "tiles_to_add": [
        "ws1_2",
        "ws1_3",
        "ws1_4",
        "ws1_5"
      ],
      "highlight_tiles": [
        "fl_2_2"
      ]
    },
    {
      "step_number": 4,
      "description": "立北墙一层: 与南墙隔 3 格车道对望。",
      "tip": "中间留足 3 格宽 —— 车身加两排刷子刚刚好。",
      "tiles_to_add": [
        "wn1_2",
        "wn1_3",
        "wn1_4",
        "wn1_5"
      ],
      "highlight_tiles": [
        "fl_2_4"
      ]
    },
    {
      "step_number": 5,
      "description": "装两道立刷: 紫色/绿色方片底边整边吸地坪拼缝 (x=3 与 x=5), 竖边与墙棱互咬, 中间让出车道。",
      "tip": "立刷成对夹住车道 —— 车身两侧一次刷干净。",
      "tiles_to_add": [
        "br_s3",
        "br_n3",
        "br_s5",
        "br_n5"
      ],
      "highlight_tiles": [
        "fl_2_2",
        "fl_4_4"
      ]
    },
    {
      "step_number": 6,
      "description": "小黄车开进刷位: 车轮底座整边吸地坪拼缝, 长板车顶压轮顶, 车头朝出口。",
      "tip": "车轮正好贴着立刷 —— 记住: 车要赶在封顶之前开进来!",
      "tiles_to_add": [
