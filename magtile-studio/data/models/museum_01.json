  "steps": [
    {
      "step_number": 1,
      "description": "铺前庭地坪: 4 片灰色长板围出 2x2 金字塔基座 (拼缝即塔缘)。",
      "tip": "长板长边就是金字塔的下底吸合线 —— 铺正再往下走。",
      "tiles_to_add": [
        "ct_s",
        "ct_n",
        "ct_w",
        "ct_e"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺步道: 4 片方板一字排开 (y 2..3), 连接前庭与大门。",
      "tip": "步道短边整边吸地坪长板端边 —— 观众从这里排队入馆。",
      "tiles_to_add": [
        "wk_2",
        "wk_3",
        "wk_4",
        "wk_5"
      ],
      "highlight_tiles": [
        "ct_w",
        "ct_e"
      ]
    },
    {
      "step_number": 3,
      "description": "起玻璃金字塔: 4 片透明梯形下底整边吸地坪长边, 腰腰互吸, 方板压顶合龙。",
      "tip": "卢浮宫同款 —— 五片自锁成环, 阳光直落前庭。",
      "tiles_to_add": [
        "pyr_s",
        "pyr_e",
        "pyr_n",
        "pyr_w",
        "pyr_cap"
      ],
      "highlight_tiles": [
        "ct_s",
        "ct_n"
      ]
    },
    {
      "step_number": 4,
      "description": "立两翼正面墙: 6 片方墙沿 y=3 线立起, x=1 与 x=6 两格用透明玻璃窗。",
      "tip": "靠步道两格墙脚踩步道北边 —— 展廊的落地展窗朝南。",
      "tiles_to_add": [
        "wf_0",
        "wf_1",
        "wf_2",
