  "steps": [
    {
      "step_number": 1,
      "description": "铺西岸: 10 片绿色地坪铺出西岸草地, 桥头留在正中一行。",
      "tip": "河谷从西岸铺起 —— 正中一行就是过河的路线。",
      "tiles_to_add": [
        "wb_0_0",
        "wb_r_0",
        "wb_0_1",
        "wb_r_1",
        "wb_r_2",
        "wb_2_2",
        "wb_0_3",
        "wb_r_3",
        "wb_0_4",
        "wb_r_4"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺河面南半: 4 片蓝色河水接上西岸。",
      "tip": "河水由南向北流 —— 蓝色长板是平静的深水区。",
      "tiles_to_add": [
        "rv_s_0",
        "rv_5_0",
        "rv_s_1",
        "rv_5_1"
      ],
      "highlight_tiles": [
        "wb_r_0"
      ]
    },
    {
      "step_number": 3,
      "description": "铺桥下河床: 3 片蓝色方板一字排开, 格缝就是桥墩的立足线。",
      "tip": "这一行必须用方板 —— x=3/4/5/6 四条格缝马上要立桥墩。",
      "tiles_to_add": [
        "rv_3_2",
        "rv_4_2",
        "rv_5_2"
      ],
      "highlight_tiles": [
        "wb_2_2"
      ]
    },
    {
      "step_number": 4,
      "description": "铺河面北半: 4 片河水合拢, 小河贯通南北。",
