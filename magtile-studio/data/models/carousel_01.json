  "steps": [
    {
      "step_number": 1,
      "description": "铺转台南列: 1 片粉色长方形边台居中, 左右各锁 1 片青色角台。",
      "tip": "长方形的短边正好交给 1x1 角台 —— 回字环的长短分工。",
      "tiles_to_add": [
        "dk_s",
        "ck_sw",
        "ck_se"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺转台东西边台: 2 片长方形竖着放, 长边对内、短边咬住角台。",
      "tip": "内侧长边留给中央鼓身 —— 那是一条 2 格长的整边铰链。",
      "tiles_to_add": [
        "dk_w",
        "dk_e"
      ],
      "highlight_tiles": [
        "ck_sw",
        "ck_se"
      ]
    },
    {
      "step_number": 3,
      "description": "铺转台北列合环: 北边台与两只角台落位, 回字大转台闭环。",
      "tip": "转台是一整圈: 剪断任何一条拼缝, 环上还有第二条路。",
      "tiles_to_add": [
        "dk_n",
        "ck_nw",
        "ck_ne"
      ],
      "highlight_tiles": [
        "dk_w",
        "dk_e"
      ]
    },
    {
      "step_number": 4,
      "description": "铺入园动线: 透明走道长板接转台南沿, 两侧路板与售票亭地台顺次相吸。",
      "tip": "走道长边整边吸转台南边台 —— 入口动线与转台焊成整体。",
      "tiles_to_add": [
        "walk",
        "pv_w",
        "pv_e",
        "kg"
      ],
      "highlight_tiles": [
        "dk_s"
      ]
    },
    {
      "step_number": 5,
      "description": "铺花圃: 东西两条绿色长方形花圃, 长边整边吸转台外沿。",
      "tip": "花圃也用长边贴长边 —— 一格短边可吸不住 2 格长边。",
      "tiles_to_add": [
        "bed_w",
        "bed_e"
      ],
      "highlight_tiles": [
        "dk_w",
        "dk_e"
      ]
    },
    {
      "step_number": 6,
      "description": "立绿篱: 花圃南北短边各立 1 片绿色三角, 共 4 片。",
      "tip": "三角绿篱立在花圃短边上, 底边整边吸合。",
      "tiles_to_add": [
        "hg_ws",
        "hg_wn",
        "hg_es",
        "hg_en"
      ],
      "highlight_tiles": [
        "bed_w",
        "bed_e"
      ]
    },
    {
      "step_number": 7,
      "description": "砌鼓身第 1 层: 4 片红色长方形绕 2x2 环抱区立起, 拐角竖边互吸自锁成环, 底边与转台内长边整边贴合。",
      "tip": "按 南-东-北-西 逆时针放, 每片放下即咬住转台与上一片。",
      "tiles_to_add": [
        "dr_s_0",
        "dr_e_0",
        "dr_n_0",
        "dr_w_0"
      ],
      "highlight_tiles": [
        "dk_s",
        "dk_n"
      ]
    },
    {
      "step_number": 8,
      "description": "砌鼓身第 2 层: 黄色圈层再叠一环, 上环整边压下环。",
      "tip": "红黄相间就是旋转木马的糖果色号。",
      "tiles_to_add": [
        "dr_s_1",
        "dr_e_1",
        "dr_n_1",
        "dr_w_1"
      ],
      "highlight_tiles": [
        "dr_s_0"
      ]
    },
    {
      "step_number": 9,
      "description": "撑大帐篷: 4 片红色梯形下底吸鼓身墙顶整边, 腰腰互吸合拢。",
      "tip": "梯形下底长 2 恰与墙顶等长 —— 一圈装完越按越紧。",
      "tiles_to_add": [
        "tent_s",
        "tent_e",
        "tent_n",
        "tent_w"
      ],
      "highlight_tiles": [
        "dr_s_1",
        "dr_n_1"
      ]
    },
    {
      "step_number": 10,
      "description": "封帐篷压顶: 黄色压顶方片盖住帐篷 1x1 天窗。",
      "tip": "压顶四边同时吸四片梯形上底, 帐篷从此一体。",
      "tiles_to_add": [
        "tent_cap"
      ],
      "highlight_tiles": [
        "tent_s"
      ]
    },
    {
      "step_number": 11,
      "description": "立角台木马: 4 只等腰三角木马立上四只角台的外沿口。",
      "tip": "木马底边整边吸角台沿口, 重心正压铰链、力臂为零。",
