  "steps": [
    {
      "step_number": 1,
      "description": "铺草甸地台: 八片灰绿相间的方板拼成 4x2 平台, 这是转角城墙的地基。",
      "tip": "拼缝对齐了, 上面的城墙和哨塔才有整边可吸。",
      "tiles_to_add": [
        "ground_0_0",
        "ground_1_0",
        "ground_2_0",
        "ground_3_0",
        "ground_0_1",
        "ground_1_1",
        "ground_2_1",
        "ground_3_1"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "立 L 形城墙: 西墙两片、南墙两片合围转角, 墙脚整边踩地台拼缝。",
      "tip": "L 形短段就是城墙转角 —— 敌人从这边来, 先看见的就是这截墙。",
      "tiles_to_add": [
        "wall_w_0",
        "wall_w_1",
        "wall_s_1",
        "wall_s_2"
      ],
      "highlight_tiles": [
        "ground_0_0",
        "ground_1_0"
      ]
    },
    {
      "step_number": 3,
      "description": "装城墙城齿: 西墙与南墙顶沿各立一片黄色等边三角垛口。",
      "tip": "城齿与墙共面, 重心正压墙顶 —— 力矩为零。",
      "tiles_to_add": [
        "crenel_w",
        "crenel_s"
      ],
      "highlight_tiles": [
        "wall_w_1",
        "wall_s_2"
      ]
    },
    {
      "step_number": 4,
      "description": "起哨塔一层: 三片蓝墙合围, 南面嵌一片橙色门框方门洞。",
      "tip": "门洞朝南 —— 哨兵进出塔内, 敌人从墙外看不见里面。",
      "tiles_to_add": [
        "t1_n",
        "t1_w",
        "t1_gate",
        "t1_e"
      ],
      "highlight_tiles": [
        "ground_1_1"
      ]
    },
    {
      "step_number": 5,
      "description": "加哨塔二层: 北墙换清色窗格方箭窗, 东西墙续高, 平顶封住塔顶。",
      "tip": "箭窗就是 T17 负空间 —— 少一片墙, 瞭望孔却更有城堡味道。",
      "tiles_to_add": [
        "t2_slit",
        "t2_w",
        "t2_e",
        "t2_roof"
      ],
      "highlight_tiles": [
        "t1_n",
        "t1_gate"
      ]
    },
    {
      "step_number": 6,
      "description": "立瞭望尖与塔顶城齿: 红色瞭望尖 + 黄色垛口 —— 转角哨塔落成!",
      "tip": "单塔加短墙, 体量不大却站得住 —— 城堡主题第一座 D1 入门作品。",
      "tiles_to_add": [
        "lookout",
        "tower_crenel"
      ],
      "highlight_tiles": [
        "t2_roof"
      ]
    }
  ]
