  "steps": [
    {
      "step_number": 1,
      "description": "铺水榭地板与石径: 2 片黄色长板纵铺成榭底, 东侧再接 1 片灰色石径长板。",
      "tip": "三片长板的长边都落在 x 整数线上 —— 之后墙和桥墩全靠这些边。",
      "tiles_to_add": [
        "pav_fl_w",
        "pav_fl_e",
        "path"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "立水榭下层环墙: 西、东、北三面各立 1 片整幅长板墙, 南面整面敞开。",
      "tip": "墙底边 (长 2) 与地板长边逐段等长整边贴合; 敞开的南面就是水榭的看台。",
      "tiles_to_add": [
        "pw0_w",
        "pw0_e",
        "pw0_n"
      ],
      "highlight_tiles": [
        "pav_fl_w",
        "pav_fl_e"
      ]
    },
    {
      "step_number": 3,
      "description": "架上层环梁圈: 西、东、北三面先叠, 南梁最后悬跨门洞, 两端竖边吸东西梁竖边 —— 四片合成自锁环。",
      "tip": "南梁下面没有墙, 全靠两端竖边受力 —— 这就是敞口水榭的门脸。",
      "tiles_to_add": [
        "pw1_w",
        "pw1_e",
        "pw1_n",
        "pw1_s"
      ],
      "highlight_tiles": [
        "pw0_w",
        "pw0_e"
      ]
    },
    {
      "step_number": 4,
      "description": "收梯形四坡顶: 4 片青瓦梯形下底整边吸环梁顶边, 四腰两两互吸。",
      "tip": "梯形下底长 2, 恰与环梁顶边等长 —— 一片压一面。",
      "tiles_to_add": [
        "pav_rf_s",
        "pav_rf_e",
        "pav_rf_n",
        "pav_rf_w"
      ],
      "highlight_tiles": [
        "pw1_s",
        "pw1_n"
      ]
    },
    {
      "step_number": 5,
      "description": "盖攒尖压顶: 1 片黄色方片盖住四坡顶围出的天窗口, 大水榭落成。",
      "tip": "压顶四边同时吸四片梯形上底 —— 咔哒一声整顶锁死。",
      "tiles_to_add": [
        "pav_rf_cap"
      ],
      "highlight_tiles": [
        "pav_rf_s",
        "pav_rf_e"
      ]
    },
    {
      "step_number": 6,
      "description": "立石灯笼: 石径南北两端各立 1 座橙色等腰石灯笼。",
      "tip": "灯笼底边吸石径短边, 是入园的第一重仪式感。",
      "tiles_to_add": [
        "lant_s",
        "lant_n"
      ],
      "highlight_tiles": [
        "path"
      ]
    },
    {
      "step_number": 7,
      "description": "铺莲池: 3 片蓝色长板纵铺 ([3,6]x[0,2]), 与石径长边相吸。",
      "tip": "池水的每条 x 整数线马上都要站上一座桥墩。",
      "tiles_to_add": [
        "pond_3",
        "pond_4",
        "pond_5"
      ],
      "highlight_tiles": [
        "path"
      ]
    },
    {
      "step_number": 8,
      "description": "立四座桥墩: 4 片灰色长板立在 x = 3/4/5/6 四条边线上, 底边与池板长边整边贴合。",
      "tip": "桥墩是立式长板 —— 一片顶两根柱子, 稳而通透。",
      "tiles_to_add": [
        "pier_3",
        "pier_4",
        "pier_5",
        "pier_6"
      ],
      "highlight_tiles": [
        "pond_3",
        "pond_5"
      ]
    },
    {
      "step_number": 9,
      "description": "铺桥面: 3 片灰色长板依次压上, 每片两端同时吸左右桥墩顶边。",
      "tip": "双端受力零悬挑 —— 罗马水道桥同款的过跨手法。",
      "tiles_to_add": [
        "deck_3",
        "deck_4",
        "deck_5"
      ],
      "highlight_tiles": [
        "pier_3",
        "pier_6"
      ]
    },
    {
      "step_number": 10,
      "description": "装南侧桥栏: 3 片朱红三角立在桥面南沿。",
      "tip": "桥栏立在桥面短边正上方, 力臂为零纯压不弯。",
      "tiles_to_add": [
        "rail_s_3",
        "rail_s_4",
        "rail_s_5"
      ],
      "highlight_tiles": [
        "deck_4"
      ]
    },
    {
      "step_number": 11,
      "description": "装北侧桥栏: 再立 3 片, 石桥合栏。",
      "tip": "过桥赏莲, 两侧都要有栏 —— 安全第一。",
      "tiles_to_add": [
        "rail_n_3",
        "rail_n_4",
        "rail_n_5"
      ],
      "highlight_tiles": [
        "rail_s_4"
      ]
    },
    {
      "step_number": 12,
      "description": "铺东岸与岸边园地东段: 东岸长板吸池板东沿, 上方园地方板接岸铺开。",
      "tip": "东岸是绿色草坡, 小亭马上要立在它的园地上。",
      "tiles_to_add": [
        "shore",
