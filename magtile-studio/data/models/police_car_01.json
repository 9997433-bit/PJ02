  "steps": [
    {
      "step_number": 1,
      "description": "南车道: 方板+长板+长板+方板 x3 铺出第一排路面, 长板拼缝正好落在 x=1~3 与 3~5 —— 车轮底座马上要吸在这两条缝上。",
      "tip": "长板放准了, 后面的轮子才有整边可吸。",
      "tiles_to_add": [
        "r0_a",
        "r0_b",
        "r0_c",
        "r0_d",
        "r0_e",
        "r0_f"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "临检车道: 同样的板序再铺一排 —— 警车就停这排接受检查。",
      "tip": "",
      "tiles_to_add": [
        "r1_a",
        "r1_b",
        "r1_c",
        "r1_d",
        "r1_e",
        "r1_f"
      ],
      "highlight_tiles": [
        "r0_b",
        "r0_c"
      ]
    },
    {
      "step_number": 3,
      "description": "北车道: 两块白色导流格镶在 x=2~4, 其余用灰色长板补齐。",
      "tip": "白色导流格的北边是拦截桩的落脚点。",
      "tiles_to_add": [
        "r2_a",
        "r2_b",
        "r2_c",
        "r2_d",
        "r2_e"
      ],
      "highlight_tiles": [
        "r1_a",
        "r1_f"
      ]
    },
    {
      "step_number": 4,
      "description": "人行道: 西段两块橙色长砖, 东段 x=4~8 改用四块方砖 —— 岗亭与告示牌都要立在方砖的格边上。",
      "tip": "",
      "tiles_to_add": [
        "wk_a",
        "wk_b",
        "wk_c",
        "wk_d",
        "wk_e",
        "wk_f"
      ],
      "highlight_tiles": [
        "r2_b",
        "r2_e"
      ]
    },
    {
      "step_number": 5,
      "description": "四只车轮: 前对吸 x=1~3 拼缝, 后对吸 x=3~5 拼缝, 分别立在 y=1 与 y=2 线上 —— 车轮底座一片顶两格, 底边整边咬住路缝。",
      "tip": "轮顶 (z=1) 稍后要托起整个车身。",
      "tiles_to_add": [
        "wb_fs",
        "wb_fn",
        "wb_rs",
        "wb_rn"
      ],
      "highlight_tiles": [
        "r0_b",
        "r1_c"
      ]
    },
    {
      "step_number": 6,
      "description": "车身三段: 发动机盖长板压前轮顶, 座舱底板长板压后轮顶, 后备箱方板短边吸座舱底板东端。",
      "tip": "长板长边与轮顶整边等长贴合 —— 力全部直落车轮。",
      "tiles_to_add": [
        "hood",
        "cabin_floor",
        "trunk"
      ],
      "highlight_tiles": [
        "wb_fs",
        "wb_rn"
      ]
    },
    {
      "step_number": 7,
      "description": "蓝色警条: 两条整片长方形竖立在座舱两侧, 底边同时吸住轮组顶边与座舱底板长边。",
      "tip": "警条就是座舱墙 —— 白车身蓝警条, 一眼认出警车。",
      "tiles_to_add": [
        "stripe_s",
        "stripe_n"
      ],
      "highlight_tiles": [
        "cabin_floor",
        "wb_rs"
      ]
    },
    {
      "step_number": 8,
      "description": "车顶: 白色长板盖上 z=2, 两条长边整边压住南北警条顶。",
      "tip": "轮组+警条+车顶锁成箱形环, 这就是车身的刚度。",
      "tiles_to_add": [
        "roof"
      ],
      "highlight_tiles": [
        "stripe_s",
        "stripe_n"
      ]
    },
    {
      "step_number": 9,
      "description": "玻璃: 前挡风从车顶西沿 45 度斜披向发动机盖, 后窗从东沿斜披向后备箱, 车鼻再从机盖前缘斜披一片 —— 轿车轮廓出来了。",
      "tip": "每片玻璃 30g, 远低于悬挂预算 —— 稳稳挂住。",
      "tiles_to_add": [
        "windshield",
        "rear_glass",
        "nose"
      ],
      "highlight_tiles": [
        "roof",
        "hood"
      ]
    },
    {
      "step_number": 10,
      "description": "车顶警灯: 红色等边三角立上车顶前沿短边 —— 嘀嘟嘀嘟!",
      "tip": "三角重心正压铰链线, 力臂为零。",
      "tiles_to_add": [
        "beacon"
      ],
      "highlight_tiles": [
