  "steps": [
    {
      "step_number": 1,
      "description": "铺西列广场砖: 五片灰色方板一字排开, 正中那格是门厅地板。",
      "tip": "开馆第一件事是铺好入口 —— 检票口就设在正中那格。",
      "tiles_to_add": [
        "pz_w_0",
        "pz_w_1",
        "pz_w_2",
        "pz_w_3",
        "pz_w_4"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺南缸缸底: 六片蓝色水板, 缸墙的脚全踩在这些拼缝上。",
      "tip": "蓝色一铺, 水就'注'进来了 —— 南缸住的是热带鱼。",
      "tiles_to_add": [
        "tf_s_1_0",
        "tf_s_1_1",
        "tf_s_2_0",
        "tf_s_2_1",
        "tf_s_3_0",
        "tf_s_3_1"
      ],
      "highlight_tiles": [
        "pz_w_0"
      ]
    },
    {
      "step_number": 3,
      "description": "铺隧道地板与北缸缸底: 灰色步道居中, 六片水板铺北缸。",
      "tip": "灰色步道两侧都是水 —— 一会儿游客就从这里穿缸而过。",
      "tiles_to_add": [
        "walk_1",
        "walk_2",
        "walk_3",
        "tf_n_1_3",
        "tf_n_1_4",
        "tf_n_2_3",
