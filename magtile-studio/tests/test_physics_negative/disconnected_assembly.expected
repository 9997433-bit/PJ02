# disconnected_assembly.expected — 物理负例期望声明 (sidecar, 由 test_physics_negative.sh 读取)
# expected_fail_rule: validate 输出必须匹配的错误/警告码 (grep 正则)
# severity: error = 必须以非零退出码拒绝; warning = 必须零退出且输出 [警告] 行
# R2: 断开装配 —— 两座各自接地的孤岛, 教程须分组说明 (Warning 不阻断)
expected_fail_rule=disconnected_assembly
severity=warning
