      "step_number": 5,
      "description": "立转轴塔: 红墙四片合环踩正中垫缝, 灰色转盘压顶四边全吸。",
      "tip": "四角竖边互咬 + 转盘压顶 —— 离心机的心脏必须最结实。",
      "tiles_to_add": [
        "hub_s",
        "hub_n",
        "hub_w",
        "hub_e",
        "hub_disc"
      ],
      "highlight_tiles": [
