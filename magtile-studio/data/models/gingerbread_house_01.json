  "steps": [
    {
      "step_number": 1,
      "description": "铺雪院南行: 两条雪地长板夹一格红色糖果小径。",
      "tip": "森林深处飘来甜甜的香味 —— 顺着糖果小径走过去看看!",
      "tiles_to_add": [
        "yard_0_0",
        "path",
        "yard_3_0"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺院心两行: 姜饼色的是屋内地板, 清色的是院里的雪。",
      "tip": "行行等边互吸 —— 墙脚要踩住这些拼缝。",
      "tiles_to_add": [
