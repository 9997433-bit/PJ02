    {
      "step_number": 4,
      "description": "铺北草坪: 场地合拢, 训练中心占地 7x4。",
      "tip": "草坪长板与垫行整边互吸, 全场连成一张网。",
      "tiles_to_add": [
        "gn_0",
        "gn_1",
