{
  "schema_version": 1,
  "id": "royal_citadel_01",
  "name": "王城四塔要塞",
  "name_en": "Royal Citadel 01",
  "description": "城堡与要塞 D5 旗舰: 结构签名是'回字形三重防线' —— 6x6 环形边廊地台锚定环形幕墙 (四角竖缝闭环 + 庭院八根斜撑锁脚), 四座三段式角楼以二层环圈自锁托等边四坡锥顶, 南门楼双塔夹长方形门楣; 中央主堡用双层 2x1 长板环梁圈叠圈, 顶上梯形四坡大顶压顶合尖 —— 与 D3 城堡塔楼 (单塔) 和 D4 城堡吊桥 (机构叙事)的防御纵深完全不同。",
  "difficulty": 5,
  "total_pieces": 124,
  "tags": [
    "城堡",
    "要塞",
    "角楼",
    "雉堞",
    "大师",
    "旗舰",
    "需要扩展装"
  ],
  "content_meta": {
    "series": "castle_fortress",
    "structural_signature": {
      "tile_histogram": {
        "square": 71,
        "equilateral_triangle": 30,
        "rectangle": 11,
        "right_triangle": 8,
        "trapezoid": 4
      },
      "silhouette_class": "concentric_fortress",
      "height_layers": 5
    },
    "build_paradigm": "outline_first",
    "technique_tags": {
      "primary": "T01_box_frame",
      "secondary": [
        "T14_diagonal_bracing",
        "T17_negative_space"
      ]
    },
    "signature_statement": "回字形三重防线: 环形幕墙、四座锥顶角楼与长板环梁主堡逐圈向心收拢。",
    "physical_risk_notes": [
      {
        "step": 11,
        "risk": "门楣跨门洞落位时若只吸单端, 另一端悬空易坠",
        "mitigation": "教程要求先立双塔身, 门楣两端短竖边同时对准再放手"
      },
      {
        "step": 27,
        "risk": "梯形大顶第四片合围前, 前三片腰边为半开环",
        "mitigation": "tip 提示装最后一片前先把前三片棱边对准, 一次合尖"
      }
    ]
  },
