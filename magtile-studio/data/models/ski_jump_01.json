  "steps": [
    {
      "step_number": 1,
      "description": "出发塔第 1 层: 平放 1 片灰色底板, 四周立 4 片红色塔壁, 拐角竖边互吸。",
      "tip": "出发塔要长到三层高, 第一层的四角一定要吸方正。",
      "tiles_to_add": [
        "tw_base",
        "tw_s_0",
        "tw_n_0",
        "tw_w_0",
        "tw_e_0"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "出发塔第 2 层: 再立 4 片红色塔壁, 上下边完整贴合。",
      "tip": "对缝叠墙吸力最强 —— 塔身是整条雪道的靠山。",
      "tiles_to_add": [
        "tw_s_1",
        "tw_n_1",
        "tw_w_1",
        "tw_e_1"
      ],
      "highlight_tiles": [
        "tw_s_0",
        "tw_e_0"
      ]
    },
    {
      "step_number": 3,
      "description": "出发塔第 3 层: 塔身升到三层, 一手扶塔一手放片。",
      "tip": "越高越要轻放, 别让下层塔壁被带歪。",
      "tiles_to_add": [
        "tw_s_2",
        "tw_n_2",
        "tw_w_2",
        "tw_e_2"
      ],
      "highlight_tiles": [
        "tw_s_1",
        "tw_e_1"
      ]
    },
    {
      "step_number": 4,
      "description": "盖出发台: 1 片灰色方板压住塔口, 四边同时吸四面塔壁顶边。",
      "tip": "出发台就是运动员蓄势待发的地方。",
      "tiles_to_add": [
        "tw_top"
      ],
      "highlight_tiles": [
        "tw_s_2",
        "tw_e_2"
      ]
    },
    {
      "step_number": 5,
      "description": "装出发台护栏: 西、南、北三面各立 1 片蓝色三角护栏, 东面留作出发口。",
      "tip": "护栏立在台沿正上方, 出发口朝向雪道正东。",
      "tiles_to_add": [
        "tw_rail_w",
        "tw_rail_s",
        "tw_rail_n"
      ],
      "highlight_tiles": [
        "tw_top"
      ]
    },
    {
      "step_number": 6,
      "description": "装登塔坡道: 1 片灰色坡道顶边吸塔西壁顶边 (一层高), 坡尾自然落地。",
      "tip": "这是运动员背着雪板登塔的楼梯 —— 坡尾落地就是支撑。",
      "tiles_to_add": [
        "climb"
      ],
      "highlight_tiles": [
        "tw_w_0"
      ]
    },
    {
      "step_number": 7,
      "description": "助滑段整段成组安装: 塔东侧先叠双层红色栈桥墩, 助滑坡顶边整边吸出发台东沿、坡尾搭上墩顶, 再铺 1 片中继台压住墩顶与坡尾。",
      "tip": "坡道-桥墩-平台三件互吸成三角刚性节点, 装完轻摇应纹丝不动。",
      "tiles_to_add": [
        "p1_a",
        "p1_b",
        "run1",
        "mid"
      ],
      "highlight_tiles": [
        "tw_top",
        "tw_e_0"
      ]
    },
    {
      "step_number": 8,
      "description": "装中继台护栏: 南北各立 1 片蓝色三角, 逼住雪板笔直向东。",
      "tip": "跳台滑雪的助滑道是笔直的 —— 护栏就是它的边界线。",
      "tiles_to_add": [
        "mid_rail_s",
        "mid_rail_n"
      ],
      "highlight_tiles": [
        "mid"
      ]
    },
    {
      "step_number": 9,
      "description": "加速段: 立单层桥墩, 加速坡从中继台东沿下探, 铺起跳台压住墩顶与坡尾。",
      "tip": "与助滑段同样的三角刚性节点, 只是矮了一层。",
      "tiles_to_add": [
        "p2",
        "run2",
        "table"
      ],
      "highlight_tiles": [
        "mid",
        "mid_rail_s"
      ]
    },
    {
      "step_number": 10,
      "description": "装起跳台护栏: 南北各 1 片蓝色三角 —— 这里就是腾空点!",
      "tip": "起跳台只有一格长, 运动员在这里全力起跳。",
      "tiles_to_add": [
        "tab_rail_s",
        "tab_rail_n"
      ],
      "highlight_tiles": [
        "table"
      ]
    },
    {
      "step_number": 11,
      "description": "装着陆坡: 1 片坡道顶边吸起跳台东沿, 坡尾直落雪面。",
      "tip": "着陆坡不需要桥墩 —— 坡尾落地自然就是支撑。",
      "tiles_to_add": [
        "land"
      ],
      "highlight_tiles": [
        "table"
      ]
    },
    {
