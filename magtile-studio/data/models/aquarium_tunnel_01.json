  "steps": [
    {
      "step_number": 1,
      "description": "铺广场南行: 四片方板一字排开, 这是水族馆的门脸。",
      "tip": "中间两列待会是隧道步道, 黄色的路一直通到馆里。",
      "tiles_to_add": [
        "plz_0_0",
        "plz_1_0",
        "plz_2_0",
        "plz_3_0"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺第二行: 黄色步道格居中, 灰色广场格在两边。",
      "tip": "行行等边互吸, 步道从这里钻进水箱底下。",
      "tiles_to_add": [
        "plz_0_1",
        "plz_1_1",
        "plz_2_1",
        "plz_3_1"
      ],
      "highlight_tiles": [
        "plz_0_0"
      ]
    },
    {
      "step_number": 3,
      "description": "铺第三行: 步道继续向北。",
      "tip": "这两行黄格就是隧道的地面 —— 头顶马上就要有鱼了。",
      "tiles_to_add": [
        "plz_0_2",
        "plz_1_2",
        "plz_2_2",
        "plz_3_2"
      ],
      "highlight_tiles": [
        "plz_1_1"
      ]
    },
    {
      "step_number": 4,
      "description": "铺第四行: 广场铺满, 北出口亮相。",
      "tip": "隧道南进北出, 两头都不封 —— 这是一条走得通的路。",
      "tiles_to_add": [
        "plz_0_3",
        "plz_1_3",
        "plz_2_3",
        "plz_3_3"
      ],
      "highlight_tiles": [
        "plz_1_2"
      ]
    },
    {
      "step_number": 5,
      "description": "立水箱外壁: 蓝色墙踩住广场拼缝, 南北面各留 2 格隧道口。",
      "tip": "四角竖边互咬; 正中空出来的洞口就是隧道大门。",
      "tiles_to_add": [
        "t0_s_0",
        "t0_s_3",
        "t0_n_0",
        "t0_n_3",
        "t0_w_1",
        "t0_w_2",
        "t0_e_1",
        "t0_e_2"
      ],
      "highlight_tiles": [
        "plz_0_1"
      ]
    },
    {
      "step_number": 6,
      "description": "立隧道玻璃墙: 两排清色墙夹住黄色步道。",
      "tip": "玻璃墙与外壁围成左右两个闭环箱体 —— 那是鱼住的地方。",
      "tiles_to_add": [
        "tn_w_1",
        "tn_w_2",
        "tn_e_1",
        "tn_e_2"
      ],
      "highlight_tiles": [
        "t0_s_0"
      ]
    },
    {
      "step_number": 7,
      "description": "铺水箱底两侧: 四片蓝色方板压上外壁与隧道墙顶。",
      "tip": "每片底板两条外边压墙顶, 箱体就此封成整环。",
      "tiles_to_add": [
        "dk_w_1",
        "dk_w_2",
        "dk_e_1",
        "dk_e_2"
      ],
      "highlight_tiles": [
        "tn_w_1"
      ]
    },
    {
      "step_number": 8,
      "description": "盖隧道顶: 两块蓝色长板短边各压一排玻璃墙顶。",
      "tip": "双端受力零悬挑, 像桥一样跨过隧道 —— 桥上就是水底。",
      "tiles_to_add": [
        "dk_t_1",
        "dk_t_2"
      ],
      "highlight_tiles": [
        "dk_w_1"
      ]
    },
    {
      "step_number": 9,
      "description": "放小鱼: 三条小鱼骑上水底拼缝, 趁玻璃环没合拢先入住。",
      "tip": "底边整边吸住拼缝; 橙色小丑鱼最喜欢待在隧道顶上。",
      "tiles_to_add": [
