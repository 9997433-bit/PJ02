{
  "schema_version": 1,
  "id": "trex_skeleton_01",
  "name": "霸王龙化石骨架",
  "name_en": "T-Rex Fossil Skeleton 01",
  "description": "博物馆立姿霸王龙: 脊柱是'左右壁 + 背板'的箱形梁, 从后腿顶向头尾双向悬挑贯穿全身; 肋骨、小短手与下颌全部倒挂在脊柱下缘, 胸腔与大嘴都是负空间。头尾互为配重, 尾椎补齐前重心始终不越出展台 —— 全模型没有一面墙, 形体完全由骨骼定义, 搭完就是一件博物馆展品。",
  "difficulty": 3,
  "total_pieces": 73,
  "tags": [
    "恐龙",
    "骨架",
    "动物世界",
    "博物馆",
    "悬挑"
  ],
