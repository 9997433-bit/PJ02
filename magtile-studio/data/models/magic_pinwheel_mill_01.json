  "steps": [
    {
      "step_number": 1,
      "description": "铺星尘晒场: 三片黄色方板整边相吸一字排开 —— 磨好的星尘粉就晾在这里。",
      "tip": "",
      "tiles_to_add": [
        "yard_w",
        "yard_c",
        "yard_e"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "立磨坊塔楼: 橙色门框方是坊门, 墙脚整边吸住晒场板边, 三面紫墙竖棱角缝互吸围成一圈。",
      "tip": "四片墙的竖棱像小手拉手 —— 拉成一圈塔楼就推不倒了。",
      "tiles_to_add": [
        "mill_s",
        "mill_w",
        "mill_n",
        "mill_e"
      ],
      "highlight_tiles": [
        "yard_c"
      ]
    },
    {
      "step_number": 3,
      "description": "搭借墙工坊: 工坊西面直接借塔楼东墙, 南北两片紫墙加透明天窗围好, 盖上工坊帽。",
      "tip": "借一面墙省一片料 —— 这是老木匠的智慧。",
      "tiles_to_add": [
        "shed_s",
        "shed_n",
        "shed_e",
        "shed_cap"
      ],
      "highlight_tiles": [
        "mill_e"
