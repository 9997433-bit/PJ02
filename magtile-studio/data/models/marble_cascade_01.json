  "steps": [
    {
      "step_number": 1,
      "description": "铺发射塔地台: 两片灰色方板沿西端打底, 六片蓝色方板合围第一层墙环。",
      "tip": "塔基东边要留出一条直线跑道 —— 弹珠将从这里三级瀑布跳下。",
      "tiles_to_add": [
        "base_0",
        "base_1",
        "tw0_s",
        "tw0_w_0",
        "tw0_w_1",
        "tw0_n",
        "tw0_e_0",
        "tw0_e_1"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "发射塔第二层: 六片蓝色方板骑上第一层墙顶, 上下边完整贴合。",
      "tip": "两层墙环已经够高 —— D2 不需要三层塔, 弹珠从 z=2 出发。",
      "tiles_to_add": [
        "tw1_s",
        "tw1_w_0",
        "tw1_w_1",
        "tw1_n",
        "tw1_e_0",
        "tw1_e_1"
      ],
      "highlight_tiles": [
        "tw0_s",
        "tw0_e_0"
      ]
    },
    {
      "step_number": 3,
      "description": "盖发球台: 两片黄色方板压住第二层墙顶, 三片挡珠三角围住台沿 (东缘留口)。",
      "tip": "东缘南半格空着 —— 那是弹珠跳向第一级瀑布的出珠口。",
      "tiles_to_add": [
        "deck_0",
        "deck_1",
        "drail_w",
        "drail_n",
        "drail_s"
      ],
      "highlight_tiles": [
        "tw1_s",
        "tw1_e_0"
      ]
    },
    {
      "step_number": 4,
      "description": "第一级瀑布 (整段成组): 塔东侧立桥墩与门式立柱, 坡道顶边吸出珠口, 转接台压住墩顶与坡尾。",
      "tip": "桥墩-坡道-转接台三件互吸 —— 第一级瀑布就位, 轻摇应纹丝不动。",
      "tiles_to_add": [
        "p1a",
        "p1c",
        "ramp_1",
        "plat_1"
      ],
      "highlight_tiles": [
        "deck_0",
        "tw1_e_0"
      ]
    },
    {
      "step_number": 5,
      "description": "转接台一装挡珠: 一片红三角锁住平台南沿, 弹珠只能乖乖向东滑。",
      "tip": "第一跳落下后, 弹珠会沿平台向东冲 —— 挡珠防止它跑偏。",
      "tiles_to_add": [
        "rail1_s"
      ],
      "highlight_tiles": [
        "plat_1"
      ]
    },
    {
      "step_number": 6,
      "description": "第二级瀑布: 立桥墩, 第二段坡道从转接台东缘下探到 z=0。",
      "tip": "海拔又降一层 —— 听, 弹珠落台的声音比第一跳更响。",
      "tiles_to_add": [
        "p2a",
        "ramp_2",
        "plat_2"
      ],
      "highlight_tiles": [
        "plat_1",
        "p1c"
      ]
    },
    {
      "step_number": 7,
      "description": "转接台二装挡珠: 一片红三角锁住平台南沿。",
      "tip": "第二级转接台是最后一层平台 —— 再往前就是冲线。",
      "tiles_to_add": [
        "rail2_s"
      ],
      "highlight_tiles": [
        "plat_2"
      ]
    },
    {
      "step_number": 8,
      "description": "第三级冲线: 立门式立柱, 橙色坡道从立柱顶 z=1 直落地面接池。",
      "tip": "冲线坡道顶边吸台缘, 坡尾落地不需要任何支撑 —— 第三跳!",
      "tiles_to_add": [
        "p3a",
        "ramp_3"
      ],
      "highlight_tiles": [
        "plat_2"
      ]
    },
    {
      "step_number": 9,
      "description": "铺接珠池: 两片青色池底沿冲线方向铺开, 南北矮墙围合。",
      "tip": "池子敞口朝西 —— 弹珠从冲线坡道冲进来, 撞池壁减速。",
      "tiles_to_add": [
        "pool_0",
        "pool_1",
        "pool_s"
      ],
      "highlight_tiles": [
        "ramp_3"
      ]
    },
    {
      "step_number": 10,
      "description": "立铃靶: 粉色窗格方板立在池端 —— 阶梯瀑布滚珠台完工, 放珠开跳!",
      "tip": "三跳连落, 听哪一声最响 —— 实物跑珠才算真正验收!",
      "tiles_to_add": [
        "bell"
      ],
      "highlight_tiles": [
        "pool_0"
      ]
    }
  ]
