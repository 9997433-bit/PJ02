  "steps": [
    {
      "step_number": 1,
      "description": "铺设游乐场南排: 5 片正方形 (绿灰相间) 沿直线平放吸合。",
      "tip": "注意场地网格从 -0.5 起 —— 摆放时以第一片为基准即可, 后续全部对齐它。",
      "tiles_to_add": [
        "base_0_0",
        "base_1_0",
        "base_2_0",
        "base_3_0",
        "base_4_0"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺设中排 5 片。",
      "tip": "中排与北排的接缝线就是摩天轮星轮所在的竖直平面。",
      "tiles_to_add": [
        "base_0_1",
        "base_1_1",
        "base_2_1",
        "base_3_1",
        "base_4_1"
      ],
      "highlight_tiles": [
        "base_0_0",
        "base_4_0"
      ]
    },
    {
      "step_number": 3,
      "description": "铺设北排 5 片, 5x3 游乐场完工。",
      "tip": "从上往下看是整齐的 5x3 棋盘格。",
      "tiles_to_add": [
        "base_0_2",
        "base_1_2",
        "base_2_2",
        "base_3_2",
        "base_4_2"
      ],
      "highlight_tiles": [
        "base_0_1"
      ]
    },
    {
      "step_number": 4,
      "description": "竖立塔架下层: 3 片灰色立墙并排立在中排与北排的接缝上, 相邻竖边互吸。",
      "tip": "三片连成一面 3 格宽的桁架墙 —— 摩天轮的全部重量都压在它上面。",
      "tiles_to_add": [
        "col_0_1",
        "col_1_1",
        "col_2_1"
      ],
      "highlight_tiles": [
        "base_1_1",
        "base_2_1",
        "base_3_1"
      ]
    },
    {
      "step_number": 5,
      "description": "叠塔架上层: 再叠 3 片, 上下完整贴合、左右竖边互吸。",
      "tip": "塔架顶边 (高度 2) 将同时托住轮毂和两片下轮辐 —— 三点托举。",
      "tiles_to_add": [
        "col_0_2",
        "col_1_2",
        "col_2_2"
      ],
      "highlight_tiles": [
        "col_0_1",
        "col_2_1"
      ]
    },
    {
      "step_number": 6,
      "description": "安装六边形轮毂: 竖立在中柱顶边正上方, 底边整边吸合。",
      "tip": "轮毂是整面星轮的心脏; 放稳后轻碰不应晃动。",
      "tiles_to_add": [
        "hub"
      ],
      "highlight_tiles": [
        "col_1_2"
      ]
    },
    {
      "step_number": 7,
      "description": "安装 2 片下轮辐: 红色等边三角形贴着轮毂左下、右下两条边, 水平底边分别吸在左右侧柱的顶边上。",
      "tip": "每片下轮辐同时吸住轮毂斜边和侧柱顶边 —— 星轮从此三点着力。",
      "tiles_to_add": [
        "spoke_3",
        "spoke_5"
      ],
      "highlight_tiles": [
        "hub",
        "col_0_2",
        "col_2_2"
      ]
    },
    {
      "step_number": 8,
      "description": "安装 3 片上轮辐: 贴着轮毂左上、正上、右上三条边向外辐射。",
      "tip": "先左上、再正上、最后右上, 每片底边与轮毂边完全贴合。",
      "tiles_to_add": [
        "spoke_2",
        "spoke_1",
        "spoke_0"
      ],
      "highlight_tiles": [
        "hub"
      ]
    },
    {
      "step_number": 9,
      "description": "嵌入 4 片紫色菱形辐间板: 填进相邻轮辐之间的豁口, 两条边分别与两侧轮辐的侧边互吸 —— 星轮锁成一个整环。",
      "tip": "菱形的锐角朝轮心、钝角朝外; 装完后星轮任何一片都有两条以上支撑路径。",
      "tiles_to_add": [
        "rhomb_5",
        "rhomb_0",
        "rhomb_1",
        "rhomb_2"
      ],
      "highlight_tiles": [
        "spoke_0",
        "spoke_1"
      ]
    },
    {
      "step_number": 10,
