        "g4_b",
        "g4_5",
        "g4_6"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺车亭行: 7 片方板, 灰色是车亭与小站的地基。",
      "tip": "每片对齐格子 —— 前柱与小站南墙踩这排格线。",
