      ],
      "highlight_tiles": [
        "lr_w",
        "lr_e"
      ]
    },
    {
      "step_number": 4,
      "description": "主楼首层圈层: 4 片橙色长方形立成 2x2 围圈, 四角竖边咬合, 每片底长边整边吸住环屋步道长板的长边。",
      "tip": "长方形圈层砌法 —— 每个转角两片竖边互吸, 一圈锁定。",
      "tiles_to_add": [
        "mb_s_0",
        "mb_e_0",
        "mb_n_0",
        "mb_w_0"
      ],
      "highlight_tiles": [
        "lr_s",
        "lr_n"
      ]
    },
    {
      "step_number": 5,
      "description": "主楼二层圈层: 再叠 4 片粉色长方形, 主楼升到 2 格高。",
      "tip": "上下圈层的竖缝对齐, 墙顶留出 2 格长的整边给屋顶。",
