  "steps": [
    {
      "step_number": 1,
      "description": "铺中央地台: 4 片黄色步道方板放在四条腿柱将要立起的位置旁, 中间用长方形、东西两侧用方板草地补齐。",
      "tip": "腿柱线两旁必须是单格方板 —— 立墙的底边只吸等长的整边。",
      "tiles_to_add": [
        "walk_11",
        "walk_41",
        "walk_12",
        "walk_42",
        "lawn_c1",
        "lawn_c2",
