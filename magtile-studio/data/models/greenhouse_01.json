  "steps": [
    {
      "step_number": 1,
      "description": "铺前院: 4 片绿色方板沿南边排开, 这是温室的门前院子。",
      "tip": "先铺地再起屋 —— 所有立起的片都要吸在地砖拼缝上。",
      "tiles_to_add": [
        "yard_0",
        "yard_1",
        "yard_2",
        "yard_3"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺东西小路与后檐: 两列灰色小路夹住温室地块, 北面 4 片绿色方板收边。",
      "tip": "小路的内沿 (x=3 与 x=5) 就是玻璃坡将要落地的檐线。",
      "tiles_to_add": [
        "path_w0",
        "path_w1",
        "path_w2",
        "path_w3",
        "path_e0",
        "path_e1",
        "path_e2",
        "path_e3",
        "back_0",
        "back_1",
        "back_2",
        "back_3"
      ],
      "highlight_tiles": [
        "yard_1"
      ]
    },
    {
      "step_number": 3,
      "description": "铺苗床西列: 4 片彩色方板从南到北排进温室。",
      "tip": "红-黄-粉-绿, 每块苗床种不同的菜。",
      "tiles_to_add": [
        "bed_w0",
        "bed_w1",
        "bed_w2",
        "bed_w3"
      ],
      "highlight_tiles": [
        "path_w0"
      ]
    },
    {
      "step_number": 4,
      "description": "铺苗床东列: 再排 4 片, 两列苗床间留出 x=4 的中缝。",
      "tip": "这条中缝在脊线正下方 —— 下一步作物就种在缝上。",
      "tiles_to_add": [
        "bed_e0",
        "bed_e1",
        "bed_e2",
        "bed_e3"
      ],
      "highlight_tiles": [
        "bed_w0"
      ]
    },
    {
      "step_number": 5,
      "description": "种作物: 沿中缝立 4 株 幼苗-番茄-幼苗-番茄 (等边/等腰交替)。务必先种菜再盖顶 —— 盖完顶手就伸不进去了!",
      "tip": "作物在脊线正下方, 头顶还有富余不会顶到玻璃。",
      "tiles_to_add": [
        "plant_0",
        "plant_1",
        "plant_2",
        "plant_3"
      ],
      "highlight_tiles": [
        "bed_w1",
        "bed_e1"
      ]
    },
    {
      "step_number": 6,
      "description": "立第一、二跨玻璃: 4 片透明长方形短边落地吸住檐线拼缝, 东西两两在脊线对脊合掌。",
      "tip": "像搭帐篷: 先扶稳西片, 东片一合掌顶边互吸就稳了。",
      "tiles_to_add": [
        "glass_w0",
        "glass_e0",
        "glass_w1",
        "glass_e1"
      ],
      "highlight_tiles": [
        "path_w0",
        "path_e0"
      ]
    },
    {
      "step_number": 7,
      "description": "立第三、四跨玻璃: 再合掌两跨, 相邻跨的长边整边互吸, 四榀连成通长玻璃顶。",
      "tip": "每片新玻璃同时吸住地缝与邻跨长边 —— 越搭越稳。",
      "tiles_to_add": [
        "glass_w2",
        "glass_e2",
        "glass_w3",
        "glass_e3"
      ],
      "highlight_tiles": [
        "glass_w1",
        "glass_e1"
      ]
    },
    {
      "step_number": 8,
      "description": "起北山墙下排: 2 片绿色等边三角形立在北檐线上, 尖朝上。",
      "tip": "两片的斜边正好躺在玻璃坡的斜线上, 严丝合缝。",
      "tiles_to_add": [
        "gable_n_l",
        "gable_n_r"
      ],
      "highlight_tiles": [
        "back_1",
        "back_2"
      ]
    },
    {
      "step_number": 9,
      "description": "嵌北山墙锁芯: 1 片透明倒三角尖朝下卡进两片之间 —— 这就是'三角力'拼法的锁芯。",
      "tip": "倒三角两条边同时吸住左右两片的内斜边。",
      "tiles_to_add": [
        "gable_n_c"
      ],
      "highlight_tiles": [
        "gable_n_l",
        "gable_n_r"
      ]
    },
    {
      "step_number": 10,
      "description": "封北山墙顶角: 1 片黄色等边三角形骑上锁芯, 尖顶正抵脊线 —— 边长 2 的大三角由 4 片小三角拼成!",
