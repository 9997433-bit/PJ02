  "steps": [
    {
      "step_number": 1,
      "description": "铺塔基地台并立发射塔第一层: 两片灰色方板打底, 六片蓝色方板沿地台边缘合围。",
      "tip": "塔基东边要留出一整条直线场地 —— 弹珠将从这里一冲到底。",
      "tiles_to_add": [
        "base_0",
        "base_1",
        "tw0_s",
        "tw0_w_0",
        "tw0_w_1",
        "tw0_n",
        "tw0_e_0",
        "tw0_e_1"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "发射塔第二层: 六片蓝色方板骑上第一层墙顶, 上下边完整贴合。",
      "tip": "墙环四角竖边两两互咬, 一层一层像穿糖葫芦一样往上叠。",
      "tiles_to_add": [
        "tw1_s",
        "tw1_w_0",
        "tw1_w_1",
        "tw1_n",
        "tw1_e_0",
        "tw1_e_1"
      ],
      "highlight_tiles": [
        "tw0_s",
        "tw0_e_0"
      ]
    },
    {
      "step_number": 3,
      "description": "发射塔第三层: 六片青色方板封顶层, 塔身升到三层高。",
      "tip": "塔越高越要轻放 —— 一手扶塔身, 一手放片。",
      "tiles_to_add": [
        "tw2_s",
        "tw2_w_0",
        "tw2_w_1",
        "tw2_n",
        "tw2_e_0",
        "tw2_e_1"
      ],
      "highlight_tiles": [
        "tw1_s",
        "tw1_e_0"
      ]
    },
    {
      "step_number": 4,
      "description": "盖发射台: 两片黄色方板压住第三层墙顶, 四边都要吸在墙顶上。",
      "tip": "发射台就是赛道起点 —— 弹珠从这里出发一冲到底。",
      "tiles_to_add": [
        "deck_0",
        "deck_1"
      ],
      "highlight_tiles": [
        "tw2_s",
        "tw2_n"
      ]
    },
    {
      "step_number": 5,
      "description": "装台沿挡珠: 五片红色挡珠三角围住台沿, 东缘南半格空着不拦 —— 那是出珠口。",
      "tip": "出珠口对准正东 —— 从这里望出去就是弹珠的整条冲刺跑道。",
      "tiles_to_add": [
        "drail_w_0",
        "drail_w_1",
        "drail_s",
        "drail_n",
        "drail_e_1"
      ],
      "highlight_tiles": [
        "deck_0",
        "deck_1"
      ]
    },
    {
      "step_number": 6,
      "description": "冲刺段一 (整段成组安装): 塔东侧先立双层栈桥墩与双层门式立柱, 橙色坡道顶边整边吸住出珠口沿、坡尾搭上墩顶, 黄色转接台西缘压住墩顶与坡尾、东缘压住立柱顶。",
      "tip": "桥墩-坡道-转接台三件互吸, 立柱像门框一样顶住台缘 —— 装完轻摇应纹丝不动。",
      "tiles_to_add": [
        "p1a",
        "p1b",
        "p1c",
        "p1d",
        "ramp_1",
        "plat_1"
      ],
      "highlight_tiles": [
        "deck_0",
        "tw2_e_0"
      ]
    },
    {
      "step_number": 7,
      "description": "转接台一装挡珠三角: 南北各一片红三角, 弹珠只能乖乖直行。",
      "tip": "直线冲刺不拐弯 —— 挡珠三角是跑道两侧的护栏。",
      "tiles_to_add": [
        "rail1_s",
        "rail1_n"
      ],
      "highlight_tiles": [
        "plat_1"
      ]
    },
    {
      "step_number": 8,
      "description": "冲刺段二: 立单层桥墩与立柱, 第二段坡道从转接台东缘下探, 再铺第二块转接台与两片挡珠三角。",
      "tip": "海拔又降一层 —— 弹珠每过一段都更快一分。",
      "tiles_to_add": [
        "p2a",
        "p2b",
        "ramp_2",
        "plat_2",
        "rail2_s",
        "rail2_n"
      ],
      "highlight_tiles": [
        "plat_1",
        "p1d"
      ]
    },
    {
      "step_number": 9,
      "description": "架冲线坡道: 最后一段橙色坡道从转接台二东缘直落地面, 坡尾自然着地。",
      "tip": "冲线坡道顶边吸台缘, 坡尾落地不需要任何支撑。",
      "tiles_to_add": [
        "ramp_3"
      ],
      "highlight_tiles": [
        "plat_2"
      ]
    },
    {
      "step_number": 10,
      "description": "铺保龄球道: 四片清色方板从坡尾向东一字排开, 西缘与坡尾整边互吸。",
      "tip": "球道要铺得笔直 —— 弹珠落地后就在这条道上滑行减速。",
      "tiles_to_add": [
        "lane_0",
        "lane_1",
        "lane_2",
        "lane_3"
      ],
      "highlight_tiles": [
        "ramp_3"
      ]
    },
