{
  "schema_version": 1,
  "id": "strait_rainbow_bridge_01",
  "name": "海峡之虹悬索桥",
  "name_en": "Strait Rainbow Suspension Bridge 01",
  "description": "桥梁工程 D5 悬索旗舰: 结构签名是'十二段菱形链从双塔垂向桥面' —— 先立双塔桁架芯与斜撑 (T02+T14), 再铺桥面连续梁, 最后由跨中向两塔对称挂透明菱形主缆与吊索, 用受压链条再现悬索桥的受拉曲线; 与 D3 海湾悬索桥 (单格悬挑合龙) 和 D4 石拱桥 (拱洞负空间) 传力叙事均不同。",
  "difficulty": 5,
  "total_pieces": 110,
  "tags": [
    "桥梁",
    "悬索桥",
    "工程",
    "桁架",
    "大师",
    "需要扩展装"
  ],
  "content_meta": {
    "series": "bridge_engineering",
    "structural_signature": {
      "tile_histogram": {
        "rhombus": 48,
