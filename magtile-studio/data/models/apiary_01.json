  "steps": [
    {
      "step_number": 1,
      "description": "铺南行花田: 六片绿色草地方板边边互吸连成一排。",
      "tip": "蜜源花田在蜂箱南边 —— 蜜蜂出巢门就能上班采蜜。",
      "tiles_to_add": [
