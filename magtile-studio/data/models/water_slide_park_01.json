  "steps": [
    {
      "step_number": 1,
      "description": "池底西半: 平铺 6 片青色池底 (x 2..4), 相邻边互吸。",
      "tip": "青色就是水面 —— 池底铺得平, 水花才溅得欢。",
      "tiles_to_add": [
        "pool_2_0",
        "pool_2_1",
        "pool_2_2",
        "pool_3_0",
        "pool_3_1",
        "pool_3_2"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "池底东半: 再铺 6 片, 4x3 大泳池成形。",
      "tip": "12 片池底缝缝相吸, 是全场最大的一块地锚。",
      "tiles_to_add": [
        "pool_4_0",
        "pool_4_1",
        "pool_4_2",
        "pool_5_0",
        "pool_5_1",
        "pool_5_2"
      ],
      "highlight_tiles": [
        "pool_3_1"
      ]
    },
    {
      "step_number": 3,
      "description": "泳池南墙: 立 4 片蓝色池墙, 底边吸池底南沿边。",
      "tip": "池墙立直, 相邻竖边互吸 —— 别让池水漏出去。",
      "tiles_to_add": [
        "pw_s_2",
        "pw_s_3",
        "pw_s_4",
        "pw_s_5"
      ],
      "highlight_tiles": [
        "pool_2_0",
        "pool_5_0"
      ]
    },
    {
      "step_number": 4,
      "description": "泳池北墙: 同法再立 4 片, 南北池岸相对而立。",
      "tip": "北墙中段 (x 4..5) 待会儿要借给儿童区当靠山。",
      "tiles_to_add": [
        "pw_n_2",
        "pw_n_3",
        "pw_n_4",
        "pw_n_5"
      ],
      "highlight_tiles": [
        "pw_s_2"
      ]
    },
    {
      "step_number": 5,
      "description": "泳池东墙与西口: 东面 3 片合拢, 西面只装南北两段 —— 中间留 1 格宽的滑道入水口。",
      "tip": "西口正对跳台 —— 大滑梯要从这里俯冲进池心。",
      "tiles_to_add": [
        "pw_e_0",
        "pw_e_1",
        "pw_e_2",
        "pw_w_s",
        "pw_w_n"
      ],
      "highlight_tiles": [
        "pw_s_5",
        "pw_n_5"
      ]
    },
    {
      "step_number": 6,
      "description": "出发步道: 南北各铺 3 片灰色步道 (x -1..2), 东端吸池墙底边。",
      "tip": "两条步道是跳台与泳池之间的地面纽带, 先从池边往西铺。",
      "tiles_to_add": [
