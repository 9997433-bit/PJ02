  "steps": [
    {
      "step_number": 1,
      "description": "铺走道南排: 五片清灰相间的方板从西到东一字排开。",
      "tip": "这是能真正走通的花园长廊 —— 走道铺直, 墙和梁才不歪。",
      "tiles_to_add": [
        "path_0_0",
        "path_1_0",
        "path_2_0",
        "path_3_0",
        "path_4_0"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺走道北排: 再来五片, 两排整边互吸, 棋盘格颜色错开。",
      "tip": "两排走道拼成 5x2 的大地毯, 长廊的地基就位。",
      "tiles_to_add": [
