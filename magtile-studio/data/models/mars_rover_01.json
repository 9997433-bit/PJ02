        "me_3"
      ],
      "highlight_tiles": [
        "ml_1",
        "me_1"
      ]
    },
    {
      "step_number": 3,
      "description": "立地貌岩钉与风蚀石: 东端拼缝立 2 片直角三角岩钉, 对角再立 2 片橙色风蚀石。",
      "tip": "直角边整边吸地坪拼缝 —— 火星的风把石头削成了刀片。",
      "tiles_to_add": [
        "spike_s",
        "spike_n",
        "wind_w",
        "wind_n"
      ],
      "highlight_tiles": [
        "me_0",
        "me_3"
      ]
    },
    {
      "step_number": 4,
      "description": "堆岩丘: 4 片橙色等边三角在东侧格子上四棱互吸, 合拢成一座岩丘。",
      "tip": "四坡自锁 —— 亿万年的陨石堆积就是这个形状。",
      "tiles_to_add": [
        "mound_s",
        "mound_e",
        "mound_n",
        "mound_w"
      ],
      "highlight_tiles": [
        "md_2"
      ]
    },
    {
      "step_number": 5,
      "description": "装南侧轮组: 2 片车轮底座沿 y=1 拼缝立起, 底边整边吸合。",
      "tip": "车轮底座是探测车的脚 —— 一片顶两格, 稳稳咬住地缝。",
      "tiles_to_add": [
        "wh_s_1",
        "wh_s_3"
      ],
      "highlight_tiles": [
        "ma_0",
        "mb_0"
      ]
    },
    {
      "step_number": 6,
      "description": "装北侧轮组: y=3 拼缝再立 2 片, 六轮底盘左右就位。",
      "tip": "两侧轮组严格对位 —— 甲板要同时压住它们。",
      "tiles_to_add": [
        "wh_n_1",
        "wh_n_3"
      ],
      "highlight_tiles": [
        "wh_s_1",
        "wh_s_3"
      ]
    },
    {
      "step_number": 7,
      "description": "立车尾墙: x=1 线上 2 片黄色方墙, 底边整边吸地坪格边。",
      "tip": "车尾墙与轮组同高 —— 它们共同托起甲板。",
      "tiles_to_add": [
        "bw_w_1",
        "bw_w_2"
      ],
      "highlight_tiles": [
