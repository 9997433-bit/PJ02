        "pad_2_3",
        "pad_3_3",
        "pad_4_3"
      ],
      "highlight_tiles": [
        "pad_0_0"
      ]
    },
    {
      "step_number": 3,
      "description": "立测风塔第一层: 四片灰墙合环, 四角竖边互咬。",
      "tip": "墙脚整边吸住坪缝, 闭环墙筒是最稳的塔身。",
      "tiles_to_add": [
        "tw0_s",
        "tw0_n",
        "tw0_w",
        "tw0_e"
      ],
      "highlight_tiles": [
        "pad_0_0"
      ]
    },
    {
      "step_number": 4,
      "description": "测风塔第二层墙环整边骑上第一层墙顶。",
      "tip": "上层每片墙底边都要与下层墙顶整边对齐再松手。",
      "tiles_to_add": [
        "tw1_s",
        "tw1_n",
        "tw1_w",
        "tw1_e"
      ],
      "highlight_tiles": [
        "tw0_s"
      ]
    },
    {
      "step_number": 5,
      "description": "塔顶压顶四边全吸, 风杆与风向旗骑上塔顶。",
      "tip": "风杆底边同时吸住压顶北沿和北墙顶 —— 一条线上两道保险, 杆尖直上 4.0。",
      "tiles_to_add": [
        "tw_cap",
        "tw_mast",
        "tw_vane"
      ],
      "highlight_tiles": [
        "tw1_n"
      ]
    },
    {
      "step_number": 6,
      "description": "搭百叶箱支架层: 四片清色墙把箱体架离地面。",
      "tip": "百叶箱要离地通风, 温度计才量得准。",
      "tiles_to_add": [
        "sc_leg_s",
        "sc_leg_n",
        "sc_leg_w",
        "sc_leg_e"
      ],
      "highlight_tiles": [
        "pad_2_2"
      ]
    },
    {
      "step_number": 7,
      "description": "百叶层上箱: 整圈窗格方骑上支架墙顶, 再盖青色压顶。",
      "tip": "窗格方的镂空就是百叶 —— 风穿箱而过, 太阳晒不进去。",
      "tiles_to_add": [
        "sc_lv_s",
        "sc_lv_n",
        "sc_lv_w",
        "sc_lv_e",
        "sc_cap"
      ],
      "highlight_tiles": [
        "sc_leg_s"
      ]
    },
    {
      "step_number": 8,
      "description": "围雨量筒: 四片青色墙开顶合环, 蓝色底格在筒心。",
      "tip": "只围不盖, 雨水才落得进来; 四角竖边互咬照样闭环。",
      "tiles_to_add": [
        "rg_s",
        "rg_n",
        "rg_w",
        "rg_e"
      ],
      "highlight_tiles": [
        "pad_4_1"
      ]
    },
    {
      "step_number": 9,
      "description": "立数据屏: 窗格方立牌插在坪缝上, 面向观测坪。",
      "tip": "今天的风速、气温、雨量, 都会显示在这块屏上。",
      "tiles_to_add": [
        "data_screen"
      ],
      "highlight_tiles": [
        "sc_lv_s"
      ]
    },
    {
      "step_number": 10,
      "description": "装光伏板收尾: 支撑墙立在北沿, 斜板顶边吸墙顶、坡尾落地。",
      "tip": "30 度朝天正对太阳 —— 观测站开始记录今天的天气!",
      "tiles_to_add": [
        "pv_stand",
        "pv_panel"
      ],
      "highlight_tiles": [
        "data_screen"
      ]
    }
  ]
