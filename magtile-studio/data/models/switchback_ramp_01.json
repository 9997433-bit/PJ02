  "steps": [
    {
      "step_number": 1,
      "description": "铺塔基立墙: 一片灰色方板打底, 西/南/北三面绿墙围合, 东面空着。",
      "tip": "东面不砌墙 —— 那是弹珠唯一的出口, 坡道就从这里下探。",
      "tiles_to_add": [
        "base",
        "tw_w",
        "tw_s",
        "tw_n"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "塔基四角斜撑 (T14): 四片紫色直角三角, 竖直角边吸墙角竖缝、水平边贴地外伸。",
      "tip": "双边吸合的斜撑锁死塔身 —— 之字赛道反复开球也撞不倒。",
      "tiles_to_add": [
        "br_sw",
        "br_nw",
        "br_se",
        "br_ne"
      ],
      "highlight_tiles": [
        "tw_s",
        "tw_n"
      ]
    },
    {
      "step_number": 3,
      "description": "盖发球台加挡珠: 黄色方板压住三面墙顶, 三片红三角围住西/南/北台沿。",
      "tip": "发球台 z=1 —— D2 的弹珠只需一层楼的势能就够跑完全程。",
      "tiles_to_add": [
        "deck",
        "drail_w",
        "drail_s",
        "drail_n"
      ],
      "highlight_tiles": [
        "tw_w"
      ]
    },
    {
      "step_number": 4,
      "description": "挂 30 度坡道 (T08): 橙色长板顶边整边吸发球台东缘, 坡尾直落地面网格线。",
      "tip": "坡尾边恰好落在 x=3 的网格线上 —— 与长廊首块地板整边互吸。",
      "tiles_to_add": [
        "ramp"
      ],
      "highlight_tiles": [
        "deck"
      ]
    },
    {
      "step_number": 5,
      "description": "铺长廊南列: 五片蓝青棋盘方板沿东向排开, 首板西缘咬住坡尾。",
      "tip": "弹珠从南半幅入场 —— 记住这条线, 之字闸门马上要逼它变道。",
      "tiles_to_add": [
        "lane_s3",
        "lane_s4",
        "lane_s5",
        "lane_s6",
        "lane_s7"
      ],
      "highlight_tiles": [
        "ramp"
      ]
    },
    {
      "step_number": 6,
      "description": "铺长廊北列: 五片方板与南列拼缝逐段对齐互吸, 长廊变成 2 格宽。",
      "tip": "2 格宽才玩得起之字 —— 一半是路, 一半是闸。",
      "tiles_to_add": [
        "lane_n3",
        "lane_n4",
        "lane_n5",
        "lane_n6",
        "lane_n7"
      ],
      "highlight_tiles": [
        "lane_s5"
      ]
    },
    {
      "step_number": 7,
      "description": "立之字闸门: 四片橙色直角三角骑在地板拼缝上, 交替封南半幅和北半幅。",
      "tip": "底直角边整边吸拼缝, 斜边朝来珠方向 —— 弹珠贴着斜面滑向另一半幅。",
      "tiles_to_add": [
        "gate_4",
        "gate_5",
        "gate_6",
        "gate_7"
      ],
      "highlight_tiles": [
        "lane_s3",
        "lane_n4"
      ]
    },
    {
      "step_number": 8,
      "description": "装长廊边挡: 六片红三角站上长廊外沿, 与闸门错位互补, 把弹珠兜在场内。",
      "tip": "哪边闸门封路, 对面就要有边挡 —— 之字线的每个折点都被兜住。",
      "tiles_to_add": [
        "srail_s3",
        "srail_s5",
        "srail_s7",
        "srail_n3",
        "srail_n4",
        "srail_n6"
      ],
      "highlight_tiles": [
        "gate_4",
        "gate_5"
      ]
    },
    {
      "step_number": 9,
      "description": "铺接珠池底: 四片青色方板拼成 2x2 池底, 西缘咬住长廊末端。",
      "tip": "池底与长廊整边互吸 —— 弹珠冲线后直接滚进池心。",
      "tiles_to_add": [
        "pool_80",
        "pool_81",
        "pool_90",
        "pool_91"
      ],
      "highlight_tiles": [
        "lane_s7",
        "lane_n7"
      ]
    },
    {
      "step_number": 10,
      "description": "砌池壁: 东/南/北六面蓝色矮墙围合, 西面敞开当冲线口。",
      "tip": "墙脚整边吸池底 —— 三面合围, 弹珠再快也翻不出去。",
      "tiles_to_add": [
        "pw_s8",
        "pw_s9",
        "pw_e0",
        "pw_e1",
