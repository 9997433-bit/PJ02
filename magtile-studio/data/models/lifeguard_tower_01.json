  "steps": [
    {
      "step_number": 1,
      "description": "铺海面立浪花: 三条蓝色长板短边互吸, 两朵清色浪花骑岸线拼缝。",
      "tip": "浪花底边整边吸住岸线 —— 今天风平浪静, 适合下水。",
      "tiles_to_add": [
        "sea_0",
        "sea_2",
        "sea_4",
        "wave_w",
        "wave_e"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺滩前行沙板: 六片黄色单位方板贴着海面排成一行。",
      "tip": "全用单位方板 —— 瞭望椅和值班房的墙脚拼缝就在这行北沿。",
