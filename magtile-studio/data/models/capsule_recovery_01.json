  "steps": [
    {
      "step_number": 1,
      "description": "铺南行草坪: 四条绿色长板短边互吸, 草原着陆场开工。",
      "tip": "返回舱预报落点就在这片草原 —— 回收队凌晨就出发了。",
      "tiles_to_add": [
        "g_s0",
        "g_s1",
        "g_s2",
        "g_s3"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "平铺主伞伞面: 九片红白棋盘方板嵌进草地, 与草坪同层拼缝互吸。",
      "tip": "主伞落地后摊成一大朵红白花 —— 直升机在天上一眼就能认出。",
      "tiles_to_add": [
        "chute_0_1",
        "chute_1_1",
        "chute_2_1",
        "chute_0_2",
