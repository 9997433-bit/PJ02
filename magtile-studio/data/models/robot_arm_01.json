  "steps": [
    {
      "step_number": 1,
      "description": "铺地坪南半: 2 行各 5 片 (方板x2 + 长板 + 方板x2), 黄色格是设备落点。",
      "tip": "拼缝 x=1,2,4,5 一条都不能错 —— 立柱脚全踩在这些缝上。",
      "tiles_to_add": [
        "fl_a_0",
