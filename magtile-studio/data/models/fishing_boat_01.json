  "steps": [
    {
      "step_number": 1,
      "description": "铺船底·主段: 4 片蓝色长板双列并进 (x 0..4), 拼缝落在 x=2 线。",
      "tip": "渔船船底要铺得平 —— 出海作业全靠这块底子。",
      "tiles_to_add": [
        "kb_0_0",
        "kb_0_1",
        "kb_2_0",
        "kb_2_1"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "船底收艏并立艏封板: 2 片方板补齐船艏, 艏部 2 片方墙封板立起。",
      "tip": "艏封板底边整边吸方板东边 —— 船头先站直。",
      "tiles_to_add": [
        "kb_4_0",
        "kb_4_1",
        "bow_0",
        "bow_1"
      ],
      "highlight_tiles": [
        "kb_2_0",
        "kb_2_1"
      ]
    },
    {
      "step_number": 3,
      "description": "立艉封板与南舷: 艉部 2 片封板, 南舷 2 片横楣长板 + 1 片方墙。",
      "tip": "横楣底边 (长 2) 整边吸船底长板长边, 拐角竖边互吸。",
      "tiles_to_add": [
        "stern_0",
