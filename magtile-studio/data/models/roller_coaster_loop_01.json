  "steps": [
    {
      "step_number": 1,
      "description": "铺南侧游园带: 沿 x 轴铺 6 片绿色地砖 (长-长-方-长-长-方), 排队栏落点处必须是单格方板。",
      "tip": "环圈南锚那根长方形的位置最关键 —— 它的长边即将吸住环圈。",
      "tiles_to_add": [
        "apron_s0",
        "apron_s1",
        "apron_s2",
        "apron_s3",
        "apron_s4",
        "apron_s5"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺轨道带: 8 片灰色地砖铺出过山车的行车线。",
      "tip": "桥墩基座与车厢停靠区用单格方板, 立墙只吸等长整边。",
      "tiles_to_add": [
        "track_w",
        "track_p0",
        "track_p1",
        "track_p2",
        "track_loop",
        "track_c0",
        "track_c1",
        "track_end"
      ],
      "highlight_tiles": [
        "apron_s0",
        "apron_s3"
      ]
    },
    {
      "step_number": 3,
      "description": "铺北侧游园带: 6 片绿色地砖合拢, 三条带连成 10x3 大地台。",
      "tip": "旗杆落点 (x=4,5) 两片必须是单格方板。",
      "tiles_to_add": [
        "apron_n0",
        "apron_n1",
        "apron_n2",
        "apron_n3",
        "apron_n4",
        "apron_n5"
      ],
      "highlight_tiles": [
        "track_w"
      ]
    },
    {
      "step_number": 4,
      "description": "砌站台箱体: 2 根蓝色长方形横放立起做前后墙, 2 片蓝色正方形封住东西两端, 围成箱形站台。",
      "tip": "长方形底边吸地砖长边, 端墙竖边与长墙竖边咬合。",
      "tiles_to_add": [
        "st_w",
        "st_e",
        "st_s",
        "st_n"
      ],
      "highlight_tiles": [
        "apron_s0",
        "track_w"
      ]
    },
    {
      "step_number": 5,
      "description": "盖站台台面并立雨棚柱: 1 根黄色长方形盖住箱口, 2 片透明正方形立在台面两端做雨棚柱。",
      "tip": "台面四边同时吸住四面站台墙 —— 箱体从此自锁。",
      "tiles_to_add": [
        "st_deck",
        "st_post_w",
        "st_post_e"
      ],
      "highlight_tiles": [
        "st_s",
        "st_n"
      ]
    },
    {
      "step_number": 6,
      "description": "盖雨棚与挂招牌: 1 根蓝色长方形架上双柱做雨棚顶, 1 片紫色扇形立在棚顶西沿当招牌。",
      "tip": "扇形直边吸棚顶边, 弧边朝天 —— 最拉风的过山车招牌。",
      "tiles_to_add": [
        "st_roof",
        "st_sign"
      ],
      "highlight_tiles": [
        "st_post_w",
        "st_post_e"
      ]
    },
    {
      "step_number": 7,
      "description": "装出站坡道与排队栏: 30 度坡道从台面西沿滑到地面, 1 片紫色等边三角形立在南带拼缝上当排队栏。",
      "tip": "坡道顶边整边吸台面沿口, 坡尾稳稳落地。",
      "tiles_to_add": [
        "st_exit",
        "queue"
      ],
      "highlight_tiles": [
        "st_deck"
      ]
    },
    {
      "step_number": 8,
      "description": "砌登顶桥墩: 4 片灰色正方形在轨道带上围成箱形桥墩。",
      "tip": "四片墙的竖边两两咬合, 箱形墩比单片墙结实得多。",
      "tiles_to_add": [
        "pier_s",
        "pier_n",
        "pier_w",
        "pier_e"
      ],
      "highlight_tiles": [
        "track_p1"
      ]
    },
    {
      "step_number": 9,
      "description": "盖墩顶并架双坡道: 红色顶板盖住桥墩, 上行坡道向西落地、俯冲坡道向东贴着环圈将要立起的位置俯冲。",
      "tip": "两条坡道的顶边分别吸住墩顶的东西沿口。",
