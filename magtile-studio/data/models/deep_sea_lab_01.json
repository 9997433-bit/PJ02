  "steps": [
    {
      "step_number": 1,
      "description": "铺南缘岩带与模块行海床: 灰色岩带三长板一方板, 模块行七片深蓝单位方板。",
      "tip": "主舱、廊道、气闸的墙脚全踩在这一行单位方板的拼缝上。",
      "tiles_to_add": [
        "sea_0_0",
        "sea_2_0",
        "sea_4_0",
        "sea_6_0",
        "sea_0_1",
        "sea_1_1",
        "sea_2_1",
        "sea_3_1",
        "sea_4_1",
        "sea_5_1",
        "sea_6_1"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺北半海床: 主舱行与北缘, 海藻要立的拼缝两端用单位方板。",
      "tip": "行行等边互吸 —— 海床连成一整片, 基地才有地基。",
      "tiles_to_add": [
        "sea_0_2",
        "sea_1_2",
        "sea_2_2",
        "sea_3_2",
        "sea_5_2",
        "sea_0_3",
        "sea_1_3",
        "sea_3_3",
        "sea_5_3",
        "sea_6_3"
      ],
      "highlight_tiles": [
        "sea_0_1"
      ]
    },
    {
      "step_number": 3,
      "description": "立主舱一层南墙与西墙: 灰色壳体墙踩拼缝, 拐角竖边互咬。",
      "tip": "深海水压大 —— 舱体从第一环就要合得严丝合缝。",
      "tiles_to_add": [
        "h1_s_1",
        "h1_s_2",
        "h1_w_1",
        "h1_w_2"
      ],
      "highlight_tiles": [
        "sea_1_1"
      ]
    },
    {
      "step_number": 4,
      "description": "立主舱一层北墙与东墙合环: 东南角留舱门门框, 正对廊道。",
      "tip": "门框方外框与正方形完全一致 —— 舱门就是通向廊道的入口。",
      "tiles_to_add": [
        "h1_n_1",
        "h1_n_2",
        "h1_door",
        "h1_e_2"
      ],
      "highlight_tiles": [
        "h1_s_1",
        "h1_w_1"
      ]
    },
    {
