  "steps": [
    {
      "step_number": 1,
      "description": "铺后排草坪: 沿 y=4 铺 5 片绿色, 长板与方板混拼。",
      "tip": "车亭后墙、小站和双树都会踩在这排格线上。",
      "tiles_to_add": [
        "g4_a",
