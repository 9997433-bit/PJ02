        "bs_n_2"
      ]
    },
    {
      "step_number": 4,
      "description": "起山顶台地南墙与西墙: 4 片踩草甸台面沿边 (x [0,2])。",
      "tip": "第二级台地直接叠在第一级上 —— 梯级山体的搭法。",
      "tiles_to_add": [
