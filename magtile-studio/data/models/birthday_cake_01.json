  "steps": [
    {
      "step_number": 1,
      "description": "铺底层圆台: 九片粉白相间的方板拼成 3x3, 行行整边互吸 —— 这是最大的一层蛋糕。",
      "tip": "粉白交替就是 T18 密铺 —— 像奶油裱花一样有节奏。",
      "tiles_to_add": [
        "t1_0_0",
        "t1_1_0",
        "t1_2_0",
        "t1_0_1",
        "t1_1_1",
        "t1_2_1",
        "t1_0_2",
        "t1_1_2",
        "t1_2_2"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "砌中层墙环: 四片黄橙墙围成 2x2, 墙脚整边踩底层拼缝 (T12 收分)。",
      "tip": "第二层比第一层小一圈 —— 墙环立在底层上, 不是悬空叠板。",
      "tiles_to_add": [
        "t2_s0",
        "t2_s1",
        "t2_n0",
        "t2_n1"
      ],
      "highlight_tiles": [
