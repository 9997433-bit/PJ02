  "steps": [
    {
      "step_number": 1,
      "description": "铺南岸堤: 闸墙脚下四格用单位方板, 两端绿茵长板收口。",
      "tip": "船闸工程从岸堤放线开始 —— 闸墙的脚要踩在方板拼缝上。",
      "tiles_to_add": [
        "bs_w",
        "bs_2",
        "bs_3",
        "bs_4",
        "bs_5",
        "bs_e"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺北岸堤: 与南岸对缝, 东端多留一格给闸控小屋。",
