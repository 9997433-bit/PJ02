# hanging_chain_long.expected — 物理负例期望声明 (sidecar, 由 test_physics_negative.sh 读取)
# expected_fail_rule: validate 输出必须匹配的错误/警告码 (grep 正则)
# severity: error = 必须以非零退出码拒绝; warning = 必须零退出且输出 [警告] 行
# R5: 悬挂链过长 —— 5 片 90g 未超承重预算但超过单边 4 片建议上限 (Warning)
expected_fail_rule=hanging_chain_long
severity=warning
