      ]
    },
    {
      "step_number": 3,
      "description": "铺北岸: 值班房的地基用两片单位方板留好拼缝。",
      "tip": "方板四条边都是墙脚的吸合缝 —— 值班房就盖在这里。",
      "tiles_to_add": [
        "bank_n_0",
        "bank_n_1",
        "bank_n_4",
        "bank_n_5",
        "bank_n_2",
        "bank_n_3"
      ],
      "highlight_tiles": [
