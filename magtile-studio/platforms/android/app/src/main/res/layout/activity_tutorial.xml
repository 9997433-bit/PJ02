<?xml version="1.0" encoding="utf-8"?>
<!-- 分步教程页 (3D 渲染接入前的文字分步浏览):
     标题栏 (返回 + 模型名) + 进度头 (第 x/y 步 · 已放 n/m 片 + 进度条)
     + 温和占位条 (3D 搭建即将上线) / 完成庆祝条 + 步骤列表 (当前步
     高亮 + 自动滚动定位) + 底部「上一步 / 下一步」大按钮 (>= 52dp)。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/magtile_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/magtile_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- 大返回键 (触控目标 >= 48dp) -->
        <TextView
            android:id="@+id/tutorial_back"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/back_button"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 模型中文名 (Intent 附带, 数据加载前即可显示) -->
        <TextView
            android:id="@+id/tutorial_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/tutorial_title_fallback"
            android:textColor="#FFFFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 状态行: 加载中 / 加载失败的温和提示 (加载完成后隐藏) -->
    <TextView
        android:id="@+id/tutorial_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:text="@string/tutorial_loading"
        android:textColor="@color/magtile_text_secondary"
        android:textSize="13sp" />

    <!-- 主体列 (数据加载完成前隐藏, 避免空壳闪烁) -->
    <LinearLayout
        android:id="@+id/tutorial_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 进度头: "第 x/y 步 · 已放 n/m 片" 文字 + 进度条双编码 (§4.7) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp">

            <TextView
                android:id="@+id/tutorial_step_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/magtile_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/tutorial_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:progressTint="@color/magtile_primary" />

            <!-- 温和占位: 3D 搭建视图即将上线 (提示琥珀浅底, 不锁功能) -->
            <TextView
                android:id="@+id/tutorial_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_banner_placeholder"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/tutorial_placeholder_3d"
                android:textColor="@color/magtile_badge_expansion_text"
                android:textSize="13sp" />

            <!-- 完成庆祝条 (走完全部步骤时显示, §4.3 只报喜) -->
            <TextView
                android:id="@+id/tutorial_finished"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_banner_finished"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/tutorial_finished_banner"
                android:textColor="@color/magtile_success"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 步骤列表 (当前步高亮 + smoothScroll 定位) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tutorial_steps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp" />

        <!-- 底部导航: 上一步 / 下一步 (末步时变「完成 🎉」) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/magtile_card"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <Button
                android:id="@+id/tutorial_prev_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/tutorial_prev"
                android:textSize="15sp" />

            <Button
                android:id="@+id/tutorial_next_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.4"
                android:backgroundTint="@color/magtile_primary"
                android:text="@string/tutorial_next"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
