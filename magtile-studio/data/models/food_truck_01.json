        "rd_4"
      ]
    },
    {
      "step_number": 4,
      "description": "竖餐车后壁下层: 3 片粉色正方形沿车道北线立起。",
      "tip": "后壁底边同时吸住车道边与人行道边, 一举两得。",
      "tiles_to_add": [
        "bk0_1",
        "bk0_2",
        "bk0_3"
      ],
      "highlight_tiles": [
        "rd_1",
        "rd_3"
      ]
    },
    {
      "step_number": 5,
      "description": "竖前脸下层两端: 前脸只立东西两端各 1 片, 中间留出一格宽的出餐窗口。",
      "tip": "这个负空间就是餐车的灵魂 —— 出餐窗口。",
      "tiles_to_add": [
        "ft0_1",
        "ft0_3"
      ],
      "highlight_tiles": [
        "rd_1",
        "rd_3"
      ]
    },
    {
      "step_number": 6,
      "description": "封车头车尾下层: 车头车尾各立 1 片, 竖边与前后壁拐角互吸。",
      "tip": "车头朝西 —— 下一步就给它装挡风玻璃。",
      "tiles_to_add": [
        "cab0",
        "tail0"
      ],
      "highlight_tiles": [
        "ft0_1",
        "bk0_3"
      ]
    },
    {
      "step_number": 7,
      "description": "叠上层车身: 后壁 3 片、车尾 1 片、车头换透明挡风玻璃。",
      "tip": "透明片就是驾驶室的挡风玻璃, 别装反位置。",
      "tiles_to_add": [
        "bk1_1",
        "bk1_2",
        "bk1_3",
        "tail1",
        "cab1"
      ],
      "highlight_tiles": [
        "bk0_1",
        "cab0"
      ]
    },
    {
      "step_number": 8,
      "description": "装窗楣合前脸上层: 两端 2 片先叠上, 中间窗楣片靠两侧竖边互吸悬跨窗口。",
      "tip": "窗楣两条竖边同时吸住左右邻片 —— 一格宽窗洞的标准砌法。",
      "tiles_to_add": [
        "ft1_1",
        "ft1_3",
        "ft1_2"
      ],
      "highlight_tiles": [
        "ft0_1",
