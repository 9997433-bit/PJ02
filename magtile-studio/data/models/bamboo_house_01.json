  "steps": [
    {
      "step_number": 1,
      "description": "西侧柱墩与楼板: 立 3 根灰色柱墩 (南/西/北), 随手把西列 3 片楼板压上柱顶 —— 每片底边吸柱墩顶边, 柱墩立刻连成一体。",
      "tip": "柱墩单独立着会孤单 —— 立一根就马上用楼板把它吸进队伍。",
      "tiles_to_add": [
        "st_s0",
        "st_w",
        "st_n0",
        "dk_0_0",
        "dk_0_1",
        "dk_0_2"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "东侧柱墩与南沿桥板: 同法立起东侧 3 根柱墩并压上东列 3 片楼板, 再沿南沿铺 2 片桥板把东西两半连通。",
      "tip": "南沿桥板两端都吸着有柱墩的楼板 —— 悬跨但不悬心。",
      "tiles_to_add": [
        "st_s3",
        "st_e",
        "st_n3",
        "dk_3_0",
        "dk_3_1",
        "dk_3_2",
        "dk_1_0",
        "dk_2_0"
      ],
      "highlight_tiles": [
        "dk_0_0"
      ]
    },
    {
      "step_number": 3,
      "description": "楼板合拢: 补上中部 4 片悬跨板, 4x3 楼板成形 —— 竹楼从此不沾地。",
      "tip": "悬跨板靠四邻边互吸传力, 铺完整层轻压中心检查是否结实。",
      "tiles_to_add": [
        "dk_1_1",
        "dk_2_1",
        "dk_1_2",
        "dk_2_2"
      ],
      "highlight_tiles": [
        "dk_1_0",
        "dk_2_0"
      ]
    },
    {
      "step_number": 4,
      "description": "主屋下层·西墙与门口: 西墙 2 片 + 南墙东段 1 片立上楼板 (x 1..2 的南面留作大门)。",
      "tip": "墙底边吸楼板边 —— 吊脚楼的墙立在楼板上, 不落地。",
      "tiles_to_add": [
        "w1_w1",
        "w1_w2",
        "w1_s2"
      ],
      "highlight_tiles": [
        "dk_1_1",
        "dk_2_0"
      ]
    },
    {
      "step_number": 5,
      "description": "主屋下层·东墙与北墙: 东墙 2 片、北墙 2 片合拢, 下层围出带门洞的堂屋。",
      "tip": "拐角竖边两两互吸, 从门洞望进去就是通风的堂屋。",
      "tiles_to_add": [
        "w1_e1",
        "w1_e2",
        "w1_n1",
        "w1_n2"
      ],
      "highlight_tiles": [
