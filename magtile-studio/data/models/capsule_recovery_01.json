        "g_s0"
      ]
    },
    {
      "step_number": 3,
      "description": "铺中带草坪: 方板加长板, 行行与南行对齐。",
      "tip": "伞面东边留出通道 —— 回收车要从这里开到舱边。",
      "tiles_to_add": [
        "g_12",
        "g_13",
        "g_14"
      ],
      "highlight_tiles": [
        "chute_2_1"
      ]
    },
    {
      "step_number": 4,
      "description": "铺伞绳板与着陆点: 两片灰色伞绳板从伞面一路牵到烧灼的落点。",
      "tip": "灰色方板就是伞绳与烧痕 —— 防热大底真的会把草烤焦一圈。",
      "tiles_to_add": [
        "line_a",
        "line_b",
