  "steps": [
    {
      "step_number": 1,
      "description": "铺设身体地板: 5 片灰色方板沿南北向连成中轴 (y 0..5)。",
      "tip": "这条中轴就是蝴蝶的身体投影, 左右翅膀都从它长出来。",
      "tiles_to_add": [
        "bd_fl_0",
        "bd_fl_1",
        "bd_fl_2",
        "bd_fl_3",
        "bd_fl_4"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺设东后翅: 4 片蓝青相间的方板贴着中轴右侧平铺 (y 1..3)。",
      "tip": "蓝青棋盘格是后翅的花纹, 内沿与中轴板边整边吸合。",
      "tiles_to_add": [
        "e_hw_0_0",
        "e_hw_1_0",
        "e_hw_0_1",
        "e_hw_1_1"
      ],
      "highlight_tiles": [
        "bd_fl_1",
        "bd_fl_2"
      ]
    },
    {
      "step_number": 3,
      "description": "铺设东前翅内列: 2 片红粉方板接在后翅上方 (y 3..5 第一列)。",
      "tip": "前翅比后翅大 —— 先铺紧贴身体的第一列。",
      "tiles_to_add": [
        "e_fw_0_0",
        "e_fw_0_1"
      ],
      "highlight_tiles": [
        "e_hw_0_1"
      ]
    },
    {
      "step_number": 4,
      "description": "铺完东前翅: 再向外接 4 片, 红粉棋盘格铺满 3 列。",
      "tip": "每片新板至少与一片旧板整边相吸, 花纹要红粉交错。",
      "tiles_to_add": [
        "e_fw_1_0",
        "e_fw_1_1",
        "e_fw_2_0",
        "e_fw_2_1"
      ],
      "highlight_tiles": [
        "e_fw_0_0"
      ]
    },
    {
      "step_number": 5,
      "description": "铺设西后翅: 与东后翅镜像, 蓝青花纹左右对称。",
      "tip": "对照东翅摆放 —— 蝴蝶最美的就是完美对称。",
      "tiles_to_add": [
        "w_hw_0_0",
        "w_hw_1_0",
        "w_hw_0_1",
        "w_hw_1_1"
      ],
      "highlight_tiles": [
        "bd_fl_1",
        "e_hw_0_0"
      ]
    },
    {
      "step_number": 6,
      "description": "铺设西前翅内列: 2 片红粉方板, 与东侧第一列镜像。",
      "tip": "左右两边同步检查: 每一格颜色都应镜像相同。",
      "tiles_to_add": [
        "w_fw_0_0",
        "w_fw_0_1"
      ],
      "highlight_tiles": [
        "w_hw_0_1"
      ]
    },
    {
      "step_number": 7,
      "description": "铺完西前翅: 再向外接 4 片, 两扇前翅完全展开。",
      "tip": "从头顶俯视: 红粉两大扇、蓝青两小扇, 翅膀已见雏形。",
      "tiles_to_add": [
        "w_fw_1_0",
