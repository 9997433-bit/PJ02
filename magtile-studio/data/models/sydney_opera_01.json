  "steps": [
    {
      "step_number": 1,
      "description": "前庭西半: 铺 4 片粉色花岗岩广场板, 相邻边互吸。",
      "tip": "高台立在广场北侧 —— 这排板是全场的基准线。",
      "tiles_to_add": [
        "pl_0",
        "pl_1",
        "pl_2",
        "pl_3"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "前庭东半: 再铺 4 片, 8 格前庭广场贯通。",
      "tip": "",
      "tiles_to_add": [
        "pl_4",
        "pl_5",
        "pl_6",
        "pl_7"
      ],
      "highlight_tiles": [
        "pl_3"
      ]
    },
    {
      "step_number": 3,
      "description": "高台南墙: 沿广场北沿立 6 片橙色砂岩方墙, 墙底吸广场板边。",
      "tip": "",
      "tiles_to_add": [
        "pw_s0",
        "pw_s1",
        "pw_s2",
        "pw_s3",
        "pw_s4",
        "pw_s5"
      ],
      "highlight_tiles": [
        "pl_1",
        "pl_6"
      ]
    },
    {
      "step_number": 4,
      "description": "东西侧墙: 从南墙两端拐角向北各立 2 片方墙, 拐角竖边互吸。",
      "tip": "先立贴着南墙的那片再向北接 —— 每片放下时都有竖边可吸。",
      "tiles_to_add": [
        "pw_w0",
        "pw_w1",
        "pw_e0",
        "pw_e1"
      ],
      "highlight_tiles": [
        "pw_s0",
        "pw_s5"
      ]
    },
    {
      "step_number": 5,
      "description": "高台北墙: 从西北角向东立 6 片方墙, 首尾吸住东西侧墙, 四面围合。",
      "tip": "墙圈闭合后台面才有四面支点。",
      "tiles_to_add": [
        "pw_n0",
        "pw_n1",
        "pw_n2",
        "pw_n3",
        "pw_n4",
