{
  "schema_version": 1,
  "id": "cable_car_01",
  "name": "缆车站",
  "name_en": "Cable Car Station 01",
  "description": "高山交通主题: 4x4 山地上立起 2x2 两层山顶站塔, 塔顶平台东沿挂着红色六边形驱动轮, 一条 30 度索道分两段滑向山脚 —— 第一段坡尾由中途支架塔整边接住, 第二段自然落地滑进 3x3 山脚站台; 站台上停着戴等腰四坡尖顶的红色缆车吊舱 (透明观景舷窗), 联络步道把全场连成一个磁力整体 —— 检票上车, 上山看云海。",
  "difficulty": 3,
  "total_pieces": 64,
  "tags": [
    "高山",
    "缆车",
    "交通",
    "索道",
    "进阶"
  ],
