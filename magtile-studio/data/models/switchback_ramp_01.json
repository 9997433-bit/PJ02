  "steps": [
    {
      "step_number": 1,
      "description": "铺塔基: 一片灰色方板打底, 四片蓝色方板合围第一层墙环。",
      "tip": "塔南侧空地先空着 —— 弹珠折返的最后一跳会回到塔脚下。",
      "tiles_to_add": [
        "base_0",
        "tw0_s",
        "tw0_w",
        "tw0_n",
        "tw0_e"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "塔角斜撑 (T14): 三片紫色直角三角竖直角边吸墙角竖缝、水平边贴地外伸, 西南/西北/东北三角各锁一角。",
      "tip": "东南角刻意留空 —— 那里是折返坡道的落珠口, 斜撑会挡道。",
      "tiles_to_add": [
        "br_sw",
        "br_nw",
        "br_ne"
      ],
      "highlight_tiles": [
        "tw0_w",
        "tw0_n"
      ]
    },
    {
      "step_number": 3,
      "description": "第二层墙 + 发球台: 四片蓝色方板骑上墙顶, 一片黄色方板盖住 z=2。",
      "tip": "两层墙环够高 —— D2 弹珠从 z=2 出发, 落差刚好跑完全程。",
      "tiles_to_add": [
        "tw1_s",
        "tw1_w",
        "tw1_n",
        "tw1_e",
        "deck_0"
      ],
      "highlight_tiles": [
        "tw0_s",
        "tw0_e"
      ]
    },
    {
      "step_number": 4,
      "description": "发球台挡珠: 三片红三角围住台沿 (东缘留口), 弹珠只能向东滑出。",
      "tip": "东缘空着 —— 那是首段坡道的唯一出珠口。",
      "tiles_to_add": [
        "drail_w",
        "drail_n",
        "drail_s"
      ],
      "highlight_tiles": [
        "deck_0"
      ]
    },
    {
      "step_number": 5,
      "description": "首段下坡 (整段成组): 东侧立双桥墩 (竖缝互吸成门式框架), 橙色坡道顶边吸发球台东缘; 四片青色直角三角两两沿对角缝拼出镜台 A 台面, 西缘接坡尾、东缘压墩顶。",
      "tip": "台面对角缝要拼严 —— 下一步折返镜就立在这条缝上。",
      "tiles_to_add": [
        "pier_n",
        "pier_s",
        "ramp_1",
        "pa_n_sw",
        "pa_n_ne",
        "pa_s_nw",
        "pa_s_se"
      ],
      "highlight_tiles": [
        "deck_0",
        "tw1_e"
      ]
    },
    {
      "step_number": 6,
      "description": "立折返镜 A: 两片红色直角三角立在对角缝上, 斜边贴缝、直角顶点朝天。",
      "tip": "北镜把东来的弹珠拍向南, 南镜再拍向西 —— 两次 45 度反弹 = 180 度掉头!",
      "tiles_to_add": [
        "mir_a_n",
        "mir_a_s"
      ],
      "highlight_tiles": [
        "pa_n_sw",
        "pa_s_nw"
      ]
    },
    {
      "step_number": 7,
      "description": "折返下坡: 橙色坡道从镜台 A 南格西缘下探到地面, 四片绿色直角三角在塔脚拼出镜台 B 台面 (坡尾整边吸台面东缘)。",
      "tip": "这段坡道贴着塔南墙外侧向西俯冲 —— 弹珠会径直冲回塔脚。",
      "tiles_to_add": [
        "ramp_2",
        "pb_n_se",
        "pb_n_nw",
        "pb_s_ne",
        "pb_s_sw"
      ],
      "highlight_tiles": [
        "pa_s_nw",
        "mir_a_s"
      ]
    },
    {
      "step_number": 8,
      "description": "立折返镜 B: 塔脚两片红色直角三角再立一组对角镜, 弹珠二次掉头向东。",
      "tip": "镜台 B 的缝口朝东张开 —— 西来的弹珠拍向南、再拍向东冲线。",
      "tiles_to_add": [
        "mir_b_n",
        "mir_b_s"
      ],
      "highlight_tiles": [
        "pb_n_se",
        "pb_s_sw"
      ]
    },
    {
      "step_number": 9,
      "description": "铺冲线直道: 三片黄色方板沿塔南向东铺开, 南缘各立一片红三角护栏。",
      "tip": "直道西缘整边吸镜台 B —— 弹珠出镜即上跑道, 不落缝。",
      "tiles_to_add": [
        "lane_0",
        "lane_1",
        "lane_2",
        "lrail_0",
        "lrail_1",
        "lrail_2"
      ],
      "highlight_tiles": [
        "pb_s_ne",
        "mir_b_s"
      ]
    },
    {
      "step_number": 10,
      "description": "接珠池收尾: 一片青色方板做池底, 东/北/南三面蓝色矮墙围合 —— 折返坡道滚珠塔完工, 放珠开滑!",
      "tip": "东下 → 镜台 A 掉头 → 西折 → 镜台 B 掉头 → 东冲线 —— 听两组镜子各响两声才算验收!",
      "tiles_to_add": [
        "pool_0",
        "pool_e",
        "pool_n",
        "pool_s"
      ],
      "highlight_tiles": [
        "lane_2"
      ]
    }
