  "steps": [
    {
      "step_number": 1,
      "description": "铺苗床第一排 (靠自己这排): 四片橙黄相间的方板从左到右吸成一条。",
      "tip": "橙黄棋盘格就是培养土 —— 拼缝对齐, 后面的墙和坡才有得吸。",
      "tiles_to_add": [
        "bed_0_0",
        "bed_1_0",
        "bed_2_0",
        "bed_3_0"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺苗床第二排: 再来四片, 与第一排整边互吸, 4x2 苗床完工。",
      "tip": "轻推苗床应整体滑动 —— 说明八片吸成了一块。",
      "tiles_to_add": [
        "bed_0_1",
        "bed_1_1",
        "bed_2_1",
        "bed_3_1"
      ],
      "highlight_tiles": [
        "bed_0_0"
      ]
    },
    {
      "step_number": 3,
      "description": "立后墙: 四片透明窗格方踩住苗床北缘拼缝排成一排, 相邻竖边互咬。",
      "tip": "窗格朝南, 太阳一出来整面墙都是亮的。",
      "tiles_to_add": [
        "glass_0",
        "glass_1",
        "glass_2",
        "glass_3"
      ],
      "highlight_tiles": [
        "bed_0_1",
        "bed_3_1"
      ]
    },
    {
      "step_number": 4,
      "description": "锁两端山墙: 灰色直角三角竖边吸后墙端缝、横边吸苗床拼缝。",
      "tip": "三角一咬上, 后墙就推不倒了 —— 这就是斜撑的本事。",
      "tiles_to_add": [
        "gable_w",
        "gable_e"
      ],
      "highlight_tiles": [
        "glass_0",
        "glass_3"
      ]
    },
    {
      "step_number": 5,
      "description": "盖玻璃斜顶: 四道透明长板顶边整边吸住后墙顶沿, 坡尾自然落地。",
      "tip": "一道一道盖, 相邻坡板长边互吸 —— 30 度斜坡正好接住阳光。",
      "tiles_to_add": [
        "roof_0",
        "roof_1",
        "roof_2",
        "roof_3"
      ],
      "highlight_tiles": [
        "glass_0",
        "glass_3"
      ]
    },
    {
      "step_number": 6,
      "description": "种上新芽: 四株小苗立上苗床前缘 —— 有一株已经开花了!",
      "tip": "底边要整条吸住前缘拼缝; 明天浇水的任务就交给你了。",
      "tiles_to_add": [
        "sprout_0",
        "sprout_1",
        "sprout_2",
        "sprout_3"
      ],
      "highlight_tiles": [
        "bed_0_0",
