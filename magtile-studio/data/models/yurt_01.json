  "steps": [
    {
      "step_number": 1,
      "description": "铺门前行: 两条草地长板夹三片方板, 中间黄色的是土路门阶。",
      "tip": "草原的早晨! 门阶北沿待会儿要咬住蒙古包的大门墙脚。",
      "tiles_to_add": [
        "g1_w",
        "g1_2",
        "g1_3",
        "g1_4",
        "g1_e"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺南行草原: 七片方板等边互吸, 黄色方板续上土路。",
      "tip": "干草垛要堆在单位方板上 —— 四条底边都得有整边可吸。",
      "tiles_to_add": [
        "g0_0",
        "g0_1",
        "g0_2",
        "g0_3",
        "g0_4",
        "g0_5",
        "g0_6"
      ],
      "highlight_tiles": [
        "g1_w"
      ]
    },
    {
      "step_number": 3,
      "description": "起毡墙环南半: 红漆门框方踩上门阶北沿, 左右各接一片白毡墙。",
      "tip": "相邻墙片的竖边以 135 度互咬 —— 蒙古包的圆肚皮就是这么鼓起来的。",
      "tiles_to_add": [
        "w_0",
        "w_1",
        "w_7"
      ],
      "highlight_tiles": [
        "g1_3"
      ]
    },
    {
      "step_number": 4,
      "description": "合毡墙环北半: 余下五片白毡墙逐片咬进环里, 首尾合拢。",
      "tip": "八片墙合成闭环就自己站稳了 —— 除了大门, 其他墙脚直接踩草地。",
      "tiles_to_add": [
