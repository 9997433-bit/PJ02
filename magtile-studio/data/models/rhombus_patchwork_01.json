        "f_w1"
      ]
    },
    {
      "step_number": 7,
      "description": "立东翼下半: 与西翼镜像, 两排绿黄菱形踩东翼步道缝咬合。",
      "tip": "左右两翼对称推进, U 形怀抱两边同时合拢, 站得最稳。",
      "tiles_to_add": [
        "e_0_0",
