<?xml version="1.0" encoding="utf-8"?>
<!-- 10+ 进阶模式紧凑卡片 (UI_UX_SPEC.md §2, 口径与桌面 Qt LibraryPage
     bandFull 更高列密度一致): 缩略图/内边距/行距收紧, 一屏可见更多
     模型 (信息项与标准卡片完全相同, 只降密度不减内容)。
     视图 id 与标准卡片 item_model_card 一一对应, 共用同一个 ViewHolder。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_model_card"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_small">

    <!-- 320x240 缩略图 (4:3) 紧凑尺寸; 无缩略图时显示占位底色 -->
    <ImageView
        android:id="@+id/model_thumbnail"
        android:layout_width="76dp"
        android:layout_height="57dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_thumbnail_placeholder"
        android:contentDescription="@string/thumbnail_description"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/model_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/magtile_text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/model_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/magtile_text_secondary"
            android:textSize="@dimen/text_caption" />

        <!-- 「需要扩展装」琥珀角标: 只在 BOM 已知且用到扩展片型时显示 -->
        <TextView
            android:id="@+id/model_expansion_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@drawable/bg_badge_expansion"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:text="@string/card_needs_expansion"
            android:textColor="@color/magtile_badge_expansion_text"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/model_difficulty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/magtile_star"
            android:textSize="@dimen/text_secondary" />

        <TextView
            android:id="@+id/model_pieces"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/magtile_text_secondary"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

</LinearLayout>
