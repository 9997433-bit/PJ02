# =============================================================
# MagTile Studio - Android release 签名配置模板
#
# 用法 (完整流程见同目录 SIGNING.md):
#   1. 复制本文件为 keystore.properties (同目录, 即 Gradle 工程根):
#        cp keystore.properties.example keystore.properties
#   2. 生成 release keystore (一次性, 生成后妥善离线备份):
#        keytool -genkeypair -v -keystore release.keystore \
#          -alias magtile-release -keyalg RSA -keysize 4096 -validity 10000
#   3. 填入下方四个键 (全部必填, 任一缺失 release 构建会报错指回本模板)
#
# 安全红线: keystore.properties 与 *.keystore / *.jks 已被本目录
# .gitignore 排除, 真实口令与密钥文件绝不入库; 本模板只允许保留
# 占位值 (CHANGE_ME)。
# =============================================================

# keystore 文件路径 (相对本目录 platforms/android/, 亦可写绝对路径)
storeFile=release.keystore

# keystore 口令
storePassword=CHANGE_ME

# 密钥别名 (与 keytool -alias 一致)
keyAlias=magtile-release

# 密钥口令 (JKS 格式可与 storePassword 不同; PKCS12 格式二者须一致)
keyPassword=CHANGE_ME
