<?xml version="1.0" encoding="utf-8"?>
<!-- 家长门对话框 (UI_UX_SPEC.md §9): 「请家长来完成」 + 中文数字乘法题 +
     中文大写数字软键盘 (不依赖物理键盘/输入法, 键帽 56dp 大号触控)。
     两个互斥状态组: 答题态 (gate_question_group) / 冷却态
     (gate_cooldown_group, 温和的「休息一下」倒计时, 无惩罚文案),
     由 ParentGateDialog 按 core::ParentGate 状态切换。
     门界面无任何商品/价格信息; 措辞与桌面 GL/Qt 门界面一致。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/magtile_background"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="22dp"
    android:paddingBottom="22dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/gate_title"
        android:textColor="@color/magtile_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/gate_subtitle"
        android:textColor="@color/magtile_text_secondary"
        android:textSize="13sp" />

    <!-- ================= 答题态 ================= -->
    <LinearLayout
        android:id="@+id/gate_question_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 题面 (中文数字乘法题, 如「叁 × 柒 = ?」) -->
        <TextView
            android:id="@+id/gate_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="@color/magtile_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/gate_answer_format_hint"
            android:textColor="@color/magtile_text_secondary"
            android:textSize="13sp" />

        <!-- 答案展示框 (软键盘输入, 不弹系统输入法) -->
        <TextView
            android:id="@+id/gate_answer"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_gate_answer"
            android:gravity="center"
            android:text="@string/gate_input_placeholder"
            android:textColor="@color/magtile_text_secondary"
            android:textSize="18sp" />

        <!-- 答错温和提示 (琥珀, 不用红色表达「错误」) -->
        <TextView
            android:id="@+id/gate_wrong_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/magtile_badge_expansion_text"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 中文大写数字软键盘 (4 行 x 3 列, 键帽由 ParentGateDialog
             统一构造: 56dp 高大号触控目标) -->
        <GridLayout
            android:id="@+id/gate_keys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/gate_submit"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_gate_submit"
                android:gravity="center"
                android:text="@string/gate_submit"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gate_cancel"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_gate_key"
                android:gravity="center"
                android:text="@string/gate_cancel"
                android:textColor="@color/magtile_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ================= 冷却态 (温和的「休息一下」) ================= -->
    <LinearLayout
        android:id="@+id/gate_cooldown_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/gate_cooldown_title"
            android:textColor="@color/magtile_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gate_cooldown_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/magtile_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/gate_cooldown_back"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_gate_key"
            android:gravity="center"
            android:text="@string/gate_cancel"
            android:textColor="@color/magtile_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
