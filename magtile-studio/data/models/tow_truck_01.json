    },
    {
      "step_number": 4,
      "description": "立驾驶室箱体: 挡风窗格方朝西, 两扇门框方作侧门, 尾隔墙收东。",
      "tip": "四面墙四角竖边互咬成环 —— 驾驶室是拖床的第二条支撑路径。",
      "tiles_to_add": [
        "cab_front",
        "cab_door_s",
        "cab_door_n",
        "cab_rear"
      ],
      "highlight_tiles": [
        "g1_2"
      ]
    },
    {
      "step_number": 5,
      "description": "盖驾驶室压顶并装警灯: 压顶四边吸墙顶, 红色警灯骑压顶西沿。",
      "tip": "警灯'压顶西沿+挡风窗顶'一线双吸 —— 出勤路上一闪一闪。",
      "tiles_to_add": [
        "cab_top",
        "cab_beacon"
      ],
      "highlight_tiles": [
        "cab_front"
      ]
    },
    {
      "step_number": 6,
      "description": "立双轮并铺拖床: 车轮底座平行立上地缝, 拖床双长边压双轮顶、西短边吸驾驶室压顶东边。",
      "tip": "床板压双轮 + 共缝驾驶室 —— 剪断任一条铰链线力都绕行。",
      "tiles_to_add": [
        "tow_wh_s",
        "tow_wh_n",
        "tow_bed"
      ],
      "highlight_tiles": [
        "cab_top"
      ]
    },
    {
      "step_number": 7,
      "description": "架登车坡道: 30 度坡顶边整边吸拖床东短边, 坡尾自然落地。",
      "tip": "顶铰链 + 接地斜撑两条路径, 零悬挑 —— 绞盘就位!",
      "tiles_to_add": [
        "tow_ramp"
      ],
      "highlight_tiles": [
        "tow_bed"
      ]
    },
    {
      "step_number": 8,
      "description": "拼故障小车: 双轮立上地缝, 蓝色车板双长边压轮顶。",
      "tip": "小车车头正对坡道尽头 —— 就差把它拉上平板了。",
