{
  "schema_version": 1,
  "id": "ski_jump_01",
  "name": "跳台滑雪场",
  "name_en": "Ski Jump 01",
  "description": "全库第一条直线下山的雪道动线: 三层出发塔甩出 助滑坡-中继台-加速坡-起跳台 三段 30 度雪道, 每段坡道顶边吸台沿、坡尾由栈桥墩接住 (三角刚性节点); 着陆坡直落雪面滑进减速区, 撞上橙色终点挡墙; 南侧紫色裁判塔戴四坡尖顶, 透明观察窗正对着陆点 —— 3, 2, 1, 出发!",
  "difficulty": 3,
  "total_pieces": 54,
  "tags": [
    "运动",
    "滑雪",
    "跳台",
    "坡道",
    "进阶"
  ],
