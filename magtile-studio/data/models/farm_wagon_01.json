  "steps": [
    {
      "step_number": 1,
      "description": "拼车架: 四片车轮底座在桌面上拼成 4x2 平板, 八只轮子全部着地。",
      "tip": "长边贴长边、短边贴短边 —— 拼好轻轻一推, 整个车架会往前跑。",
      "tiles_to_add": [
        "chassis_sw",
        "chassis_se",
        "chassis_nw",
        "chassis_ne"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "立货斗侧板: 四片红色横楣踩住车架长边, 围出货斗的两条长边。",
      "tip": "横楣底边一次吸满一片底座的长边, 立稳一片再立下一片。",
      "tiles_to_add": [
        "rail_s_0",
        "rail_s_2",
        "rail_n_0",
        "rail_n_2"
      ],
      "highlight_tiles": [
        "chassis_sw",
        "chassis_ne"
      ]
    },
    {
      "step_number": 3,
      "description": "装车头挡板和尾门: 车头两片红方, 车尾黄色门框方开卸货门洞、上面窗格透气。",
      "tip": "四角竖边互相咬住, 货斗就锁成了一圈 —— 门洞留在车尾正中。",
      "tiles_to_add": [
        "front_s",
        "front_n",
        "tail_door",
        "tail_window"
      ],
      "highlight_tiles": [
        "rail_s_0",
        "rail_n_2"
      ]
    },
    {
      "step_number": 4,
      "description": "合拖挂箭头: 两片灰色直角三角平铺在车头前, 直角边吸车架、斜边拼成箭头。",
      "tip": "两片三角中缝互咬 —— 箭头指向哪, 马车就往哪走。",
      "tiles_to_add": [
        "hitch_s",
        "hitch_n"
      ],
      "highlight_tiles": [
        "front_s",
        "front_n"
      ]
    },
    {
      "step_number": 5,
      "description": "搭驾驶台: 两片蓝色方板平搭车头墙顶, 中缝互吸拼成车夫的座位。",
      "tip": "每片方板西边吸挡板顶、外侧边压侧板顶 —— 三面都吸住才算搭好。",
      "tiles_to_add": [
        "seat_s",
        "seat_n"
      ],
      "highlight_tiles": [
        "front_s",
        "front_n"
      ]
    },
    {
      "step_number": 6,
      "description": "盖货舱盖板: 两片橙色长板盖住尾半段, 中间留出敞口投货位。",
      "tip": "盖板长边与侧板顶沿等长贴合, 东头短边吸住尾门顶 —— 苹果从中间敞口丢进去, 尾门滚出来。",
      "tiles_to_add": [
        "deck_s",
        "deck_n"
      ],
      "highlight_tiles": [
        "rail_s_2",
        "rail_n_2"
      ]
    },
    {
      "step_number": 7,
      "description": "点车灯收尾: 两盏黄色三角灯立上驾驶台两角 —— 马车发车!",
      "tip": "车灯底边整条吸住驾驶台边沿; 推一圈试试, 八个轮子都要贴着桌面。",
      "tiles_to_add": [
        "lamp_s",
        "lamp_n"
      ],
      "highlight_tiles": [
        "seat_s",
        "seat_n"
      ]
    }
  ]
}
