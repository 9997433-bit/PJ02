        "floor_s_6"
      ]
    },
    {
      "step_number": 4,
      "description": "立北侧连拱墙: 镜像三段立墙, 南北两排窗洞正对成穿堂景。",
      "tip": "两排墙合出连廊骨架 —— 顶沿 z=1 就是雨棚带的铰链线。",
      "tiles_to_add": [
        "arc_n_0",
        "arc_n_3",
        "arc_n_6"
      ],
      "highlight_tiles": [
        "arc_s_0"
      ]
    },
    {
      "step_number": 5,
      "description": "挂南侧雨棚带: 三片正放梯形下底吸墙顶, 两片透明倒放梯形跨窗洞, 腰边互锁。",
      "tip": "正放先吸墙顶, 倒放再挂进两腰 —— 一上一下咬成整条条纹斜披。",
      "tiles_to_add": [
        "awn_s_up0",
