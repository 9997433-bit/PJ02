{
  "schema_version": 1,
  "id": "slide_playground_01",
  "name": "滑梯乐园",
  "name_en": "Slide Playground",
  "description": "双道竞速滑梯乐园: 两层攀爬主塔向东甩出两条并排的两段式竞速滑道 (中继桥墩接力落地), 冲过红色双柱冲线门; 塔西紫色直角三角攀岩壁, 塔北幼儿塔配向西缓滑道, 甲板护栏与等腰旗杆一应俱全 —— 大孩子比速度, 小朋友玩缓坡, 全场连成一个连通整体。",
  "difficulty": 3,
  "total_pieces": 67,
  "tags": [
    "游乐园",
    "运动",
    "进阶"
  ],
