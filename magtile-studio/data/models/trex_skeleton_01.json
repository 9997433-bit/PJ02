  "steps": [
    {
      "step_number": 1,
      "description": "铺设展台中轴: 沿直线平放 6 片正方形 (灰青相间), 相邻边互相吸合。",
      "tip": "这条中轴线就是霸王龙的身体轴线: 尾巴朝西, 头朝东。",
      "tiles_to_add": [
        "base_c_0",
        "base_c_1",
        "base_c_2",
        "base_c_3",
        "base_c_4",
        "base_c_5"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺设展台南排: 中轴南侧接 6 片绿色地台。",
      "tip": "每片先吸住中轴地台的边, 再与左右邻片吸合。",
      "tiles_to_add": [
        "base_s_0",
        "base_s_1",
        "base_s_2",
        "base_s_3",
        "base_s_4",
        "base_s_5"
      ],
      "highlight_tiles": [
        "base_c_0",
        "base_c_5"
      ]
    },
    {
      "step_number": 3,
      "description": "铺设展台北排: 中轴北侧再接 6 片, 3x6 展台完工。",
      "tip": "展台要留出西端两格空地 —— 那是尾巴落地的位置。",
      "tiles_to_add": [
        "base_n_0",
        "base_n_1",
        "base_n_2",
        "base_n_3",
        "base_n_4",
        "base_n_5"
      ],
      "highlight_tiles": [
        "base_s_0"
      ]
    },
    {
      "step_number": 4,
      "description": "竖立两条后腿并装肌腱: 黄色腿柱立在中轴 x=2 与 x=3 的接缝上, 再用 4 根橙色直角三角形斜撑锁住腿柱两侧。",
      "tip": "斜撑的竖直边吸腿柱竖边、水平边吸展台接缝 —— 这就是霸王龙的腿部肌腱。",
      "tiles_to_add": [
        "leg_w",
        "leg_e",
        "ten_sw",
        "ten_nw",
        "ten_se",
        "ten_ne"
      ],
      "highlight_tiles": [
        "base_c_2",
        "base_c_3"
      ]
    },
    {
      "step_number": 5,
      "description": "铺设躯干底板: 3 片黄色正方形压在两条腿柱顶边上 (先铺正中一片)。",
      "tip": "正中一片要同时吸住两条腿柱的顶边, 躯干的重量全靠它们传下去。",
      "tiles_to_add": [
        "belly_2",
        "belly_1",
        "belly_3"
      ],
      "highlight_tiles": [
        "leg_w",
        "leg_e"
      ]
    },
    {
      "step_number": 6,
      "description": "竖立躯干南肋壁与臀端封板: 南侧 3 片立墙 + 臀端 (西) 1 片封板。",
      "tip": "立墙底边吸底板沿口; 转角处臀端封板与南肋壁竖边互吸。",
      "tiles_to_add": [
        "rib_s_1",
        "rib_s_2",
        "rib_s_3",
        "hip_w"
      ],
      "highlight_tiles": [
        "belly_1",
        "belly_3"
      ]
    },
    {
      "step_number": 7,
      "description": "竖立躯干北肋壁与胸端封板, 躯干合围。",
      "tip": "合围后轻推躯干应整体联动 —— 四角竖边都要互相吸住。",
      "tiles_to_add": [
        "rib_n_1",
        "rib_n_2",
        "rib_n_3",
        "chest_e"
      ],
      "highlight_tiles": [
        "hip_w",
        "rib_s_1"
      ]
    },
    {
      "step_number": 8,
      "description": "盖上背板: 3 片黄色正方形压住四周肋壁顶边, 躯干成为刚性箱体。",
      "tip": "背板四边都压在肋壁顶上, 剪断任何一条边都还有别的支撑 —— 这就是箱形结构。",
      "tiles_to_add": [
        "back_1",
        "back_2",
        "back_3"
      ],
      "highlight_tiles": [
        "rib_s_2",
        "rib_n_2"
      ]
    },
    {
      "step_number": 9,
      "description": "安装背脊骨板: 3 片红色等边三角形立在背板北沿, 尖角朝天。",
      "tip": "骨板底边吸背板沿口即可站稳, 一排三角就是霸王龙的背脊轮廓。",
      "tiles_to_add": [
        "plate_1",
        "plate_2",
        "plate_3"
      ],
      "highlight_tiles": [
        "back_1",
        "back_3"
      ]
    },
    {
      "step_number": 10,
      "description": "安装尾巴: 30 度长方形坡道顶边整边吸在躯干底板西沿, 坡尾拖到展台上; 再在坡尾沿上立 1 片红色尾尖三角。",
      "tip": "坡道顶边与底板沿口完全贴合后, 坡尾自然落地, 不需要任何支撑。",
      "tiles_to_add": [
