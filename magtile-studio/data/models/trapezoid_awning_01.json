      ]
    },
    {
      "step_number": 5,
      "description": "横砌墙第二层: 再两片长方形叠上去, 层间整边互吸砌成花架墙。",
      "tip": "上下两层对缝叠放, 墙腰 z=1 的横缝留给展台。",
      "tiles_to_add": [
        "wall_w1",
        "wall_e1"
      ],
      "highlight_tiles": [
