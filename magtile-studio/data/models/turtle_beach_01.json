  "steps": [
    {
      "step_number": 1,
      "description": "铺海面: 三条蓝色长板短边互吸, 海在南边等着小海龟。",
      "tip": "孵化季的夜晚, 小海龟破壳后会朝着大海的方向爬。",
      "tiles_to_add": [
        "sea_0",
        "sea_2",
        "sea_4"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺岸线行沙板, 三只小海龟骑上拼缝: 排队下海!",
      "tip": "海龟底边整边吸住岸线拼缝 —— 一二三, 冲向大海!",
