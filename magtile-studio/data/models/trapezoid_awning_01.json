  "steps": [
    {
      "step_number": 1,
      "description": "铺走道: 八片清灰相间的方板拼成 4x2, 中央 2x2 与外角同层 —— 下沉式走道。",
      "tip": "走道铺平, 角柱和檐轨才有整边可吸 —— 这是 T12 的地基。",
      "tiles_to_add": [
        "path_0_0",
        "path_1_0",
        "path_2_0",
        "path_3_0",
        "path_0_1",
        "path_1_1",
        "path_2_1",
        "path_3_1"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "立角柱与内框檐轨: 四角绿色立墙 + 四片灰色横楣围成 2x2 抬升檐口。",
      "tip": "檐轨顶沿 z=1 比走道高一层 —— T12 层叠退台, 也是雨棚铰链线。",
      "tiles_to_add": [
        "post_sw",
        "post_nw",
        "post_se",
        "post_ne",
        "rim_s",
        "rim_n",
        "rim_w",
        "rim_e"
      ],
      "highlight_tiles": [
        "path_0_0",
        "path_3_1"
      ]
    },
    {
      "step_number": 3,
      "description": "合围上层雨棚: 四片梯形下底吸檐轨顶沿, 腰互锁成开放式顶 —— 南北绿、东西清。",
      "tip": "梯形片是主角 —— 四片合围, 阳光还能从棚顶漏下来。",
      "tiles_to_add": [
        "roof_s",
        "roof_e",
        "roof_n",
        "roof_w"
      ],
      "highlight_tiles": [
        "rim_s",
        "rim_n"
      ]
    },
    {
      "step_number": 4,
      "description": "铺南侧苗床: 两片 2 格泥土基座贴住走道南沿, 给下层檐篷整边铰链。",
      "tip": "基座北沿与走道南沿共用一条缝 —— 花园和连廊连成一体。",
      "tiles_to_add": [
        "foot_s0",
        "foot_s2"
      ],
      "highlight_tiles": [
        "path_0_0",
        "post_sw"
      ]
    },
    {
      "step_number": 5,
      "description": "铺北侧基座并摆盆花: 两片泥土基座, 四株三角盆花立在走道北/南沿。",
      "tip": "盆花底边吸走道沿 —— 连廊里也能看到颜色。",
      "tiles_to_add": [
        "foot_n0",
