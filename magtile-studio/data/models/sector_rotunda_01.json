  "steps": [
    {
      "step_number": 1,
      "description": "扇形合圆铺殿底: 四片灰色扇形每片管一个象限, 半径边两两互吸拼成正圆。",
      "tip": "扇形只有两条半径边带磁 —— 四片合圆后每条拼缝都是双片互吸。",
      "tiles_to_add": [
        "disc_ne",
        "disc_nw",
        "disc_sw",
        "disc_se"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "立十字风车墙: 四片透明方墙骑在圆盘的四条轴向拼缝上, 在圆心咬成十字。",
      "tip": "墙脚一条边同时吸住两片扇形 —— 圆盘从此再也散不了。",
      "tiles_to_add": [
        "cw_e",
        "cw_n",
        "cw_w",
        "cw_s"
      ],
      "highlight_tiles": [
        "disc_ne"
      ]
    },
    {
      "step_number": 3,
      "description": "扇形合圆盖殿顶: 四片蓝色扇形搁上墙顶再度合圆, 半径边吸墙顶又互吸。",
      "tip": "剪断任何一条顶缝, 力还能沿圆顶绕行 —— 这就是合圆的环状冗余。",
      "tiles_to_add": [
        "dome_ne",
        "dome_nw",
        "dome_sw",
        "dome_se"
      ],
      "highlight_tiles": [
        "cw_e",
        "cw_n"
      ]
    },
    {
      "step_number": 4,
      "description": "装顶缝冠饰: 四片金色三角骑在殿顶拼缝上, 圆顶开出四瓣金冠。",
      "tip": "冠饰底边与顶缝共线 —— 一片吸三家 (两片顶扇加一道墙)。",
      "tiles_to_add": [
        "crown_e",
        "crown_n",
        "crown_w",
        "crown_s"
      ],
      "highlight_tiles": [
        "dome_ne"
      ]
    },
    {
      "step_number": 5,
      "description": "展开切向门屋: 四片绿色方墙从十字墙端头风车状转出 90 度, 竖缝互咬。",
      "tip": "门屋竖边吸风车墙端头竖边 —— 圆殿即将由它们连向外环。",
      "tiles_to_add": [
        "gate_e",
        "gate_n",
        "gate_w",
        "gate_s"
      ],
      "highlight_tiles": [
        "cw_e"
      ]
    },
    {
      "step_number": 6,
      "description": "铺回字环廊 (东北半环): 六片广场砖从东门屋脚起逆时针排到西北角。",
      "tip": "首块砖的西缘正咬住东门屋墙脚 —— 环廊与圆殿从这里接通。",
      "tiles_to_add": [
        "ring_43",
        "ring_44",
        "ring_34",
        "ring_24",
        "ring_14",
        "ring_13"
      ],
      "highlight_tiles": [
        "gate_e"
      ]
    },
    {
      "step_number": 7,
      "description": "铺回字环廊 (西南半环): 再六片合拢成回字环, 尾块咬回东门屋南侧。",
      "tip": "十二片合成闭环 —— 环廊自身也是一圈结构冗余。",
      "tiles_to_add": [
        "ring_12",
        "ring_11",
        "ring_21",
        "ring_31",
        "ring_41",
        "ring_42"
      ],
      "highlight_tiles": [
        "ring_14"
      ]
    },
    {
      "step_number": 8,
      "description": "装门屋檐饰: 四片金色三角骑上门屋墙顶, 四座门屋有了屋脊。",
      "tip": "檐饰底边整边吸墙顶 —— 重心正压墙线, 稳如泰山。",
      "tiles_to_add": [
        "gc_e",
        "gc_n",
        "gc_w",
        "gc_s"
      ],
      "highlight_tiles": [
        "gate_n"
      ]
    },
    {
      "step_number": 9,
      "description": "贴竖立扇面撑: 四片橙色扇形立在门屋外侧, 底半径边吸广场砖、竖半径边吸门屋竖缝。",
      "tip": "第三种扇形用法 —— 四分之一圆的扇面撑, 弧线从地面一直卷到墙顶。",
      "tiles_to_add": [
        "fan_e",
        "fan_n",
        "fan_w",
        "fan_s"
      ],
      "highlight_tiles": [
        "gate_e",
        "ring_44"
      ]
    },
    {
      "step_number": 10,
      "description": "立四角石柱: 四片透明方墙站上环廊四角砖的外缘。",
      "tip": "柱脚整边吸角砖边线 —— 四角一立, 广场的轮廓就画完了。",
      "tiles_to_add": [
        "pil_sw",
