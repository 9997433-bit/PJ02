  "steps": [
    {
      "step_number": 1,
      "description": "铺隧道引道并立山脚南壁: 引道 2 片钻山而出, 南壁 3 片 —— 正中嵌门框方隧道洞门。",
      "tip": "山还没堆起来, 先给火车留好山洞 —— 洞门正对引道。",
      "tiles_to_add": [
        "bs_s_0",
        "bs_tun",
        "bs_s_2",
        "pt_0",
        "pt_1"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "合山脚台地墙环: 西墙 2 + 北墙 3 + 东墙 2, 10 片墙锁成 3x2 箱形。",
      "tip": "箱形墙环就是山体的第一级台地 —— 处处成环, 剪一条不塌。",
      "tiles_to_add": [
        "bs_w_0",
        "bs_w_1",
        "bs_n_0",
        "bs_n_1",
        "bs_n_2",
        "bs_e_0",
        "bs_e_1"
      ],
      "highlight_tiles": [
        "bs_s_0",
        "bs_tun"
      ]
    },
    {
      "step_number": 3,
      "description": "铺山脚草甸台面: 6 片绿色方板压墙顶, 第一级台地封顶。",
      "tip": "每片台面同时吸墙顶与邻板拼缝 —— 山腰草甸长出来了。",
      "tiles_to_add": [
        "bs_d_0_0",
        "bs_d_0_1",
