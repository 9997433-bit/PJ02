  "steps": [
    {
      "step_number": 1,
      "description": "铺南岸步道: 方板加中段长板边边互吸, 沿着水道一字排开。",
      "tip": "运河边的纤道 —— 以前的船就是靠人沿着这条路拉过闸的。",
      "tiles_to_add": [
        "bank_s_0",
        "bank_s_1",
        "bank_s_mid",
        "bank_s_4",
        "bank_s_5",
        "bank_s_6"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺下游低位水面: 六片青色水板贴着南岸北沿铺开。",
      "tip": "下游的水位低 —— 记住这个高度, 一会儿和上游比一比。",
      "tiles_to_add": [
        "water_lo_4_1",
        "water_lo_4_2",
        "water_lo_5_1",
        "water_lo_5_2",
        "water_lo_6_1",
        "water_lo_6_2"
      ],
      "highlight_tiles": [
        "bank_s_4"
      ]
    },
    {
      "step_number": 3,
      "description": "铺闸室低位水面: 四片青色水板, 船就停在这一段。",
      "tip": "闸室是船的'电梯间': 关上门, 水涨船高。",
      "tiles_to_add": [
        "chamber_2_1",
        "chamber_2_2",
        "chamber_3_1",
        "chamber_3_2"
      ],
      "highlight_tiles": [
        "water_lo_4_1"
      ]
    },
    {
      "step_number": 4,
      "description": "铺北岸步道: 贴着水面北沿再铺一排, 与南岸隔水相望。",
      "tip": "两岸夹住两格宽的水道 —— 船闸的舞台搭好了。",
      "tiles_to_add": [
        "bank_n_0",
        "bank_n_1",
        "bank_n_2",
        "bank_n_3",
        "bank_n_mid",
        "bank_n_6"
      ],
      "highlight_tiles": [
        "chamber_2_2",
        "water_lo_4_2"
      ]
    },
    {
      "step_number": 5,
      "description": "立闸室南北闸墙: 四片灰墙踩住岸沿拼缝, 墙脚咬牢。",
      "tip": "闸墙是船闸的骨架, 一会儿两扇闸门都要靠它夹住。",
      "tiles_to_add": [
        "lock_s_w",
        "lock_s_e",
        "lock_n_w",
        "lock_n_e"
      ],
      "highlight_tiles": [
        "chamber_2_1"
      ]
    },
    {
      "step_number": 6,
      "description": "围上游围堰: 西墙两片 + 南北墙各两片, 围出高位水池。",
      "tip": "围堰墙顶就是上游水面的高度 —— 整整比下游高一层。",
      "tiles_to_add": [
        "basin_w_1",
        "basin_w_2",
        "basin_s_0",
        "basin_s_1",
        "basin_n_0",
        "basin_n_1"
      ],
      "highlight_tiles": [
        "lock_s_w"
      ]
    },
    {
      "step_number": 7,
      "description": "插上下两扇整板钢闸门: 竖直长方形卡进闸墙竖边之间。",
      "tip": "一整板就是一扇门: 两条竖边同时吸住两侧墙边, 底边落地。",
      "tiles_to_add": [
        "gate_up",
        "gate_down"
      ],
      "highlight_tiles": [
        "basin_s_1",
        "lock_s_e"
      ]
    },
    {
      "step_number": 8,
      "description": "给上游铺高位水面: 四片蓝色水板压在围堰墙顶上。",
      "tip": "每片水板至少一条边整边吸住墙顶, 板板互吸连成水面。",
      "tiles_to_add": [
        "water_hi_0_1",
        "water_hi_0_2",
        "water_hi_1_1",
        "water_hi_1_2"
      ],
      "highlight_tiles": [
        "basin_w_1",
        "gate_up"
      ]
    },
    {
      "step_number": 9,
      "description": "挂闸口警示三角, 贴检修梯斜撑: 撑-墙-岸锁成三角。",
      "tip": "斜撑两条直角边都要吸牢 —— 检修工人踩着它上下闸墙。",
      "tiles_to_add": [
        "warn_s",
        "warn_n",
        "ladder_s",
        "ladder_n"
      ],
      "highlight_tiles": [
        "lock_s_w",
        "lock_n_e"
      ]
    },
    {
      "step_number": 10,
      "description": "搭北岸闸控室: 借用闸墙当南墙, 窗格方望着闸门。",
      "tip": "闸长在窗后值班: 看水位、开闸门, 全在这一间小屋里。",
      "tiles_to_add": [
        "cabin_w",
        "cabin_e",
        "cabin_n"
      ],
      "highlight_tiles": [
        "lock_n_w"
      ]
    },
    {
