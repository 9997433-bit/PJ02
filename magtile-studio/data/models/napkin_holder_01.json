  "steps": [
    {
      "step_number": 1,
      "description": "铺餐垫: 六片绿黄棋盘方板逐片整边互吸, 铺成 2x3 的野餐格。",
      "tip": "餐垫拼缝就是墙脚线 —— 铺齐了后面才好立墙。",
      "tiles_to_add": [
        "mat_0_0",
        "mat_0_1",
        "mat_0_2",
        "mat_1_0",
        "mat_1_1",
        "mat_1_2"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "立南墙: 两片红色门框方踩住 y=1 拼缝并肩而立, 门洞里将透出餐巾。",
      "tip": "门框方外框和方板一模一样, 吸法完全相同。",
      "tiles_to_add": [
        "arch_s_w",
        "arch_s_e"
      ],
      "highlight_tiles": [
        "mat_0_0",
        "mat_1_0"
      ]
    },
    {
      "step_number": 3,
      "description": "立北墙: 两片红色窗格方踩住 y=2 拼缝, 与南墙面对面留出一格餐巾槽。",
      "tip": "",
      "tiles_to_add": [
        "arch_n_w",
        "arch_n_e"
      ],
      "highlight_tiles": [
        "arch_s_w"
      ]
    },
    {
      "step_number": 4,
      "description": "盖顶板锁框架: 两片灰色方板南北边分别整边吸住两道墙顶, 门式框架合龙!",
      "tip": "顶板一盖, 两道墙互相拉住 —— 推哪边都不倒。",
      "tiles_to_add": [
        "roof_w",
        "roof_e"
      ],
      "highlight_tiles": [
        "arch_s_w",
        "arch_n_w"
      ]
    },
    {
      "step_number": 5,
      "description": "围牙签盒: 左前角三片青墙合围, 南墙自己当第四面, 省一片是一片。",
      "tip": "",
      "tiles_to_add": [
        "pick_s",
        "pick_w",
        "pick_e"
      ],
      "highlight_tiles": [
        "mat_0_0"
      ]
    },
    {
      "step_number": 6,
      "description": "围调料盒: 右后角同样三片合围, 北墙作第四面, 前后正好对角呼应。",
      "tip": "",
      "tiles_to_add": [
        "spice_n",
        "spice_w",
        "spice_e"
      ],
      "highlight_tiles": [
        "mat_1_2"
      ]
    },
    {
      "step_number": 7,
      "description": "升小旗、翘餐巾角: 两面绿旗骑上顶板短边, 两片粉色等腰三角立上南墙顶沿 —— 餐巾架开饭!",
      "tip": "餐巾角重心正压沿口, 翘得高也站得稳。",
      "tiles_to_add": [
        "flag_w",
        "flag_e",
        "corner_w",
        "corner_e"
      ],
      "highlight_tiles": [
        "roof_w",
