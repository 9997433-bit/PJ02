  "steps": [
    {
      "step_number": 1,
      "description": "铺塔基并立门框拱廊: 一片灰色方板打底, 四片橙色门框方合围首层 —— 四面门洞就是本作的招牌。",
      "tip": "门框方外框与正方形完全一样, 四片下边整边吸住地台即可站稳。",
      "tiles_to_add": [
        "base_0",
        "arc_s",
        "arc_w",
        "arc_n",
        "arc_e"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "方板二层: 四片蓝色方板骑上拱廊墙顶, 上下边完整贴合。",
      "tip": "两层塔身够高 —— D2 弹珠从 z=2 出发, 不必再往上叠。",
      "tiles_to_add": [
        "tw_s",
        "tw_w",
        "tw_n",
        "tw_e"
      ],
      "highlight_tiles": [
        "arc_s",
        "arc_e"
      ]
    },
    {
      "step_number": 3,
      "description": "盖发球台: 一片黄色方板压住二层墙顶, 三片红色挡珠三角围住台沿 (东缘留口)。",
      "tip": "东缘空着 —— 那是弹珠冲向分流枢纽的唯一出珠口。",
      "tiles_to_add": [
        "deck_0",
        "drail_w",
        "drail_s",
        "drail_n"
      ],
      "highlight_tiles": [
        "tw_s",
        "tw_e"
      ]
    },
    {
      "step_number": 4,
      "description": "四柱门亭与首段坡道 (整段成组): 塔东侧一片灰色桥墩居西, 三片橙色门框柱站南/东/北, 枢纽台面压住四根柱顶, 橙色坡道顶边吸出珠口、坡尾搭上桥墩顶。",
      "tip": "台面四边都有柱顶整边接住, 坡道把塔与门亭连成一体 —— 分流枢纽是全场受撞最多的地方。",
      "tiles_to_add": [
        "pier_w",
        "pil_s",
        "pil_e",
        "pil_n",
        "hub",
        "ramp_e"
      ],
      "highlight_tiles": [
        "deck_0",
        "arc_e"
      ]
    },
    {
      "step_number": 5,
      "description": "布置分流室: 南北各立一道橙色分流门框, 东端粉色窗格铃板封口, 顶饰三角压住铃板上沿。",
      "tip": "弹珠撞铃板弹回后从南/北门洞 (T17 负空间) 二选一穿出 —— 分流全靠它!",
      "tiles_to_add": [
        "gate_s",
        "gate_n",
        "bell_e",
        "crown_e"
      ],
      "highlight_tiles": [
        "hub",
        "ramp_e"
      ]
    },
    {
      "step_number": 6,
      "description": "北轨下坡: 橙色坡道从北分流门下探到地面, 落地跑道接住坡尾, 东西道沿各立一片红色挡珠三角。",
      "tip": "坡尾与跑道南缘整边互吸 —— 弹珠穿过门洞就一路贴地向北。",
      "tiles_to_add": [
        "ramp_n",
        "land_n",
        "lrail_nw",
        "lrail_ne"
      ],
      "highlight_tiles": [
        "gate_n",
        "hub"
      ]
    },
    {
      "step_number": 7,
      "description": "北轨终点: 橙色终点门框立在跑道尽头, 青色池底与三面池壁围住接珠池。",
      "tip": "弹珠穿过终点门洞落池 —— 青色代表北轨得分!",
      "tiles_to_add": [
