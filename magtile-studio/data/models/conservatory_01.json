  "steps": [
    {
      "step_number": 1,
      "description": "砌南立面: 四片透明窗格方整排朝南 —— 花房的玻璃招牌墙, 竖直边逐片互咬。",
      "tip": "窗格方物理上和实心墙一样稳 —— 从南边看进去是一整面玻璃。",
      "tiles_to_add": [
        "ws_s0",
        "ws_s1",
        "ws_s2",
        "ws_s3"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺 L 形花池: 四片泥土方板沿南墙脚与东侧拐弯, 底边与墙脚共线互吸。",
      "tip": "花池贴墙种 —— 阳光从南窗照进来, 正好晒在土格上。",
      "tiles_to_add": [
        "bed_1",
        "bed_2",
        "bed_3",
        "bed_4"
      ],
      "highlight_tiles": [
        "ws_s1",
        "ws_s3"
      ]
    },
    {
      "step_number": 3,
      "description": "种盆栽: 红/紫/粉三株三角花骑上花池拼缝。",
      "tip": "先种花再合围 —— 墙环合拢前手还伸得进花房。",
      "tiles_to_add": [
        "plant_a",
        "plant_b",
        "plant_c"
      ],
      "highlight_tiles": [
        "bed_2",
        "bed_4"
      ]
    },
    {
      "step_number": 4,
      "description": "合围西墙与东墙: 西侧实心-窗-实心三片, 东侧整排三片窗格, 四角竖直边互咬。",
      "tip": "东墙三片全是窗 —— 晨光先照进花房的东脸。",
      "tiles_to_add": [
        "wall_w0",
        "ws_w1",
        "wall_w2",
        "ws_e0",
        "ws_e1",
        "ws_e2"
      ],
      "highlight_tiles": [
        "ws_s0",
        "ws_s3"
      ]
    },
    {
      "step_number": 5,
      "description": "封北墙留门洞: 西段实心墙 + 东段两片窗格, x [1,2] 空出入户门洞(T17 负空间)。",
      "tip": "少砌一片墙就是门 —— 门洞上方一会儿由平顶补齐。",
      "tiles_to_add": [
        "wall_n0",
        "ws_n2",
        "ws_n3"
      ],
      "highlight_tiles": [
        "wall_w2",
        "ws_e2"
      ]
    },
    {
      "step_number": 6,
      "description": "铺南半平顶: 六片透明方板盖住南两行, 边与墙顶等长互吸、彼此拼缝。",
      "tip": "从南墙顶开始铺 —— 每片至少吸住一条墙顶边或邻板拼缝。",
      "tiles_to_add": [
        "roof_0_0",
        "roof_1_0",
        "roof_2_0",
        "roof_3_0",
        "roof_0_1",
        "roof_1_1"
      ],
      "highlight_tiles": [
        "ws_s1",
        "ws_e0"
      ]
    },
    {
      "step_number": 7,
      "description": "铺北半平顶: 再六片补齐 4x3 玻璃平顶, 门洞上方由顶板连桥。",
      "tip": "平顶拼缝连成网 —— 正中的十字缝就是天窗塔的地基线。",
      "tiles_to_add": [
        "roof_2_1",
        "roof_3_1",
        "roof_0_2",
        "roof_1_2",
        "roof_2_2",
        "roof_3_2"
      ],
      "highlight_tiles": [
        "wall_n0",
        "ws_n2"
      ]
    },
    {
      "step_number": 8,
      "description": "升天窗塔: 六片窗格方骑住平顶正中拼缝, 围出 2x1 采光天窗环。",
      "tip": "塔墙脚两侧各吸一片顶板 —— 天窗塔是屋顶上的小玻璃房。",
      "tiles_to_add": [
        "lt_s1",
        "lt_s2",
        "lt_w",
        "lt_n1",
        "lt_n2",
        "lt_e"
      ],
      "highlight_tiles": [
        "roof_1_1",
        "roof_2_1"
      ]
    },
    {
      "step_number": 9,
      "description": "封塔顶: 绿色长方形压顶两端与塔墙顶等长互吸, 黄色尖饰立上两端—— 天窗玻璃花房落成!",
      "tip": "尖饰底边同时吸住塔端墙顶与压顶短边 —— 阳光顺着天窗洒满花房。",
