  "steps": [
    {
      "step_number": 1,
      "description": "铺设田园地台外圈: 南排 4 片灰色石板路平铺在最前, 西北角放 1 片灰色水井地基, 北排与东西两列铺绿色草地长方形与方板。",
      "tip": "先摆南排再逆时针合拢, 每片至少一条边与邻片整边吸合。",
      "tiles_to_add": [
        "path_0",
        "path_1",
        "path_2",
        "path_3",
        "well_base",
        "lawn_n",
        "lawn_ne",
        "lawn_w",
        "lawn_e"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺设磨坊室内地板: 4 片黄色正方形填满中央 2x2, 这是塔身的地基。",
      "tip": "地板与四周草地整边吸合, 之后所有墙都立在它的边上。",
      "tiles_to_add": [
        "floor_00",
        "floor_10",
        "floor_01",
        "floor_11"
      ],
      "highlight_tiles": [
        "lawn_w",
        "lawn_e"
      ]
    },
    {
      "step_number": 3,
      "description": "竖立一层西墙与东墙: 各 2 片橙色正方形沿室内地板边缘立起。",
      "tip": "墙底边吸地板边, 相邻两片墙的竖边在中缝互吸。",
      "tiles_to_add": [
        "w1_w_0",
        "w1_w_1",
        "w1_e_0",
        "w1_e_1"
      ],
      "highlight_tiles": [
        "floor_00",
        "floor_11"
      ]
    },
    {
      "step_number": 4,
      "description": "竖立一层北墙: 2 片橙色正方形, 南面整面留空 —— 那是磨坊大门。",
      "tip": "北墙两端的竖边分别吸住西墙与东墙, 一层围成 U 形。",
      "tiles_to_add": [
        "w1_n_0",
        "w1_n_1"
      ],
      "highlight_tiles": [
        "w1_w_1",
        "w1_e_1"
      ]
    },
    {
      "step_number": 5,
      "description": "叠加二层西墙与东墙: 各 2 片橙色正方形叠在一层墙顶。",
      "tip": "上下两层墙的横边完全对齐, 竖缝也要对齐才结实。",
      "tiles_to_add": [
        "w2_w_0",
        "w2_w_1",
        "w2_e_0",
        "w2_e_1"
      ],
      "highlight_tiles": [
        "w1_w_0",
        "w1_e_0"
      ]
    },
    {
      "step_number": 6,
      "description": "封二层北窗并横跨门楣: 2 片透明正方形做北窗, 1 片黄色长方形横跨南面大门上方, 两端竖边吸住西墙与东墙的二层。",
      "tip": "门楣下方是 2 格宽的负空间大门 —— 全靠两端竖边传力。",
      "tiles_to_add": [
        "w2_n_0",
        "w2_n_1",
        "lintel"
      ],
      "highlight_tiles": [
        "w2_w_0",
        "w2_e_0"
      ]
    },
    {
      "step_number": 7,
      "description": "安装裙檐: 4 片红色梯形下底吸塔口沿边, 腰两两互吸, 向内收分出 1x1 的顶部洞口。",
      "tip": "先放南片再顺时针合拢, 最后一片卡进去整圈自锁。",
      "tiles_to_add": [
        "skirt_s",
        "skirt_e",
        "skirt_n",
        "skirt_w"
      ],
      "highlight_tiles": [
        "w2_n_0",
        "lintel"
      ]
    },
    {
      "step_number": 8,
      "description": "扣上锥帽: 4 片红色等腰三角形在裙檐洞口上方合拢成尖顶。",
      "tip": "四条斜棱两两互吸, 锥尖在洞口正上方 0.87 格处会合。",
      "tiles_to_add": [
        "hat_s",
        "hat_e",
        "hat_n",
        "hat_w"
      ],
      "highlight_tiles": [
        "skirt_s",
        "skirt_n"
      ]
    },
    {
