    },
    {
      "step_number": 7,
      "description": "搭东吊舱: 对称再来一座, 舷窗朝东。",
      "tip": "两座吊舱对称配重, 离心机转起来才不偏心。",
      "tiles_to_add": [
        "ge_s",
        "ge_n",
        "ge_w",
        "ge_e"
