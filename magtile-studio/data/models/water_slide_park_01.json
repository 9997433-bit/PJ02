{
  "schema_version": 1,
  "id": "water_slide_park_01",
  "name": "水上滑梯乐园",
  "name_en": "Water Slide Park 01",
  "description": "全库第一座入水滑道乐园: 两层跳台上一条 30 度大滑梯经中继桥墩接力俯冲, 穿过泳池西侧留口直插池心水面; 4x3 大泳池四面围墙、券门双柱合龙、北岸儿童缓滑道、东岸救生员高椅 —— 跳台、泳池、儿童区与入口全部由地面板链连成一个连通整体。",
  "difficulty": 3,
  "total_pieces": 65,
  "tags": [
    "夏日乐园",
    "滑梯",
    "泳池",
    "游乐场"
  ],
