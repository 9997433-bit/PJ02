{
  "schema_version": 1,
  "id": "roman_aqueduct_01",
  "name": "罗马水道桥",
  "name_en": "Roman Aqueduct 01",
  "description": "仿加尔水道桥的双层石砌拱廊: 下层 4 座双壁石墩跨出 3 个大拱洞, 上层矮墩与横楣组成小拱层, 顶上是一条能通水的 U 形水槽, 两端封头、垛口点缀 —— 每座石墩都是地梁、双壁、桥面锁成的箱形环, 结实得像真石头。",
  "difficulty": 4,
  "total_pieces": 79,
  "tags": [
    "古代工程",
    "桥梁",
    "双层结构",
    "进阶"
  ],
