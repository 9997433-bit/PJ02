<?xml version="1.0" encoding="utf-8"?>
<!-- 次级描边按钮底 (白底主色描边, 按压转主色浅底; 订阅页「恢复购买」) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/magtile_primary_soft" />
            <stroke android:width="1dp" android:color="@color/magtile_primary" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/magtile_card" />
            <stroke android:width="1dp" android:color="@color/magtile_primary" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
