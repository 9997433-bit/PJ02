  "steps": [
    {
      "step_number": 1,
      "description": "铺转运道南行: 四条灰色长板短边互吸连成路。",
      "tip": "从总装厂房到发射区有一条专用转运道 —— 今天火箭要搬家。",
      "tiles_to_add": [
        "rd_s0",
        "rd_s1",
        "rd_s2",
        "rd_s3"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺转运道中行: 车轮就压在这行与邻行的长缝上。",
      "tip": "长板行行对齐, 每条长缝都是等长磁边 —— 车轮的轨道。",
      "tiles_to_add": [
        "rd_m0",
        "rd_m1",
        "rd_m2",
        "rd_m3"
      ],
      "highlight_tiles": [
        "rd_s0"
      ]
    },
    {
      "step_number": 3,
      "description": "铺转运道北行: 三行道面合拢。",
      "tip": "道面越宽越稳 —— 转运车是发射场里最慢也最稳的车。",
      "tiles_to_add": [
        "rd_n0",
