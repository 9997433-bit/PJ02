  "steps": [
    {
      "step_number": 1,
      "description": "铺南岸: 五片绿色长板短边互吸连成河岸。",
      "tip": "运河从西向东流 —— 上游在东边, 比下游高整整一层。",
      "tiles_to_add": [
        "bank_s_0",
        "bank_s_1",
        "bank_s_2",
        "bank_s_3",
        "bank_s_4"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺水道行: 下游蓝水、红驳船、闸室青水、高位箱底一字排开。",
      "tip": "灰色的三格是高位水道的箱底 —— 待会儿要被封进箱子里。",
      "tiles_to_add": [
        "canal_0",
        "canal_1",
        "canal_2",
        "canal_3",
        "canal_4",
        "canal_5",
