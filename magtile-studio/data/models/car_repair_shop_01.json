  "steps": [
    {
      "step_number": 1,
      "description": "铺场地南行: 轮胎堆平放在西角, 清色待修车位长板横在南沿。",
      "tip": "轮胎堆就是平放的车轮底座 —— 修理站的备件都码在地上。",
      "tiles_to_add": [
        "tire_stack",
        "fl_1_0",
        "wait_bay",
        "fl_4_0"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "补第二行四片方板, 南半场铺齐。",
      "tip": "轮胎堆一块顶两格; 车位长板的两条长边就是待修车的轮缝。",
      "tiles_to_add": [
        "fl_1_1",
        "fl_2_1",
        "fl_3_1",
        "fl_4_1"
      ],
      "highlight_tiles": [
        "tire_stack"
      ]
    },
    {
      "step_number": 3,
      "description": "铺第三行: 五片方板横贯, 清色检修通道格对准举升机。",
      "tip": "检修通道从南门一直通到举升机底下。",
      "tiles_to_add": [
        "fl_0_2",
        "fl_1_2",
        "fl_2_2",
        "fl_3_2",
        "fl_4_2"
      ],
      "highlight_tiles": [
        "fl_1_1"
      ]
    },
    {
      "step_number": 4,
      "description": "铺第四行: 场地铺满, 工坊地基就位。",
      "tip": "行行等边互吸, 每道拼缝都是一条磁力吸边。",
      "tiles_to_add": [
        "fl_0_3",
        "fl_1_3",
        "fl_2_3",
        "fl_3_3",
        "fl_4_3"
      ],
      "highlight_tiles": [
