  "steps": [
    {
      "step_number": 1,
      "description": "铺车道: 5 片蓝色方板一字排开 ([0,5]x[0,1]), 相邻边互吸。",
      "tip": "餐车马上要停在这条车道上 —— 地面缝缝吸牢。",
      "tiles_to_add": [
        "rd_0",
        "rd_1",
        "rd_2",
        "rd_3",
        "rd_4"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺人行道: 车道北侧再铺 5 片灰色方板。",
      "tip": "人行道贴着车道北沿, 一会儿梧桐树就种在这里。",
      "tiles_to_add": [
        "wk_0",
        "wk_1",
        "wk_2",
        "wk_3",
        "wk_4"
      ],
      "highlight_tiles": [
        "rd_0",
        "rd_4"
      ]
    },
    {
      "step_number": 3,
      "description": "铺餐位广场: 车道南侧铺 5 片绿色方板, 三条街面完工。",
      "tip": "广场是食客排队的地方, 也是吧台的地基。",
      "tiles_to_add": [
        "pz_0",
        "pz_1",
        "pz_2",
        "pz_3",
        "pz_4"
      ],
      "highlight_tiles": [
