  "steps": [
    {
      "step_number": 1,
      "description": "铺桌面底板第一排 (靠自己这排): 六片黄橙相间的方板从左到右吸成一条。",
      "tip": "底板是整个整理站的地基, 拼缝对齐了, 上面的每个功能位才有得吸。",
      "tiles_to_add": [
        "desk_0_0",
        "desk_1_0",
        "desk_2_0",
        "desk_3_0",
        "desk_4_0",
        "desk_5_0"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺第二排底板: 再来六片, 与第一排行行整边互吸。",
      "tip": "棋盘格颜色错开铺, 一眼就能看出哪片没对齐。",
      "tiles_to_add": [
        "desk_0_1",
        "desk_1_1",
        "desk_2_1",
        "desk_3_1",
        "desk_4_1",
        "desk_5_1"
      ],
      "highlight_tiles": [
        "desk_0_0"
      ]
    },
    {
      "step_number": 3,
      "description": "铺第三排底板: 桌面完工, 6x3 的大底板轻推应整体滑动。",
      "tip": "底板越大越稳 —— 这就是整理站不怕碰的秘密。",
      "tiles_to_add": [
        "desk_0_2",
        "desk_1_2",
        "desk_2_2",
        "desk_3_2",
        "desk_4_2",
        "desk_5_2"
      ],
      "highlight_tiles": [
        "desk_0_1"
      ]
    },
    {
      "step_number": 4,
      "description": "左前角围回形针盘: 四片青色方板合围开顶小盒, 一支清色钢笔立在盘沿。",
      "tip": "盒口不封顶 —— 回形针、橡皮擦都从上面丢进去。",
      "tiles_to_add": [
        "tray_s",
        "tray_e",
        "tray_n",
        "tray_w",
        "pen"
      ],
      "highlight_tiles": [
        "desk_0_0"
      ]
    },
    {
      "step_number": 5,
      "description": "左后角起笔筒塔第一层: 四片蓝色方板合围, 墙脚踩住底板拼缝。",
      "tip": "笔筒要装长铅笔, 所以要盖两层 —— 这只是第一层。",
      "tiles_to_add": [
        "cup0_s",
        "cup0_e",
        "cup0_n",
        "cup0_w"
      ],
      "highlight_tiles": [
        "desk_0_2"
      ]
    },
    {
      "step_number": 6,
      "description": "笔筒塔加高第二层: 再来四片上下边完整贴合, 筒沿放一株绿色多肉。",
      "tip": "两层深筒笔不歪 —— 多肉是整理站的镇桌之宝。",
      "tiles_to_add": [
        "cup1_s",
        "cup1_e",
        "cup1_n",
        "cup1_w",
        "plant"
      ],
      "highlight_tiles": [
        "cup0_s"
      ]
    },
    {
      "step_number": 7,
      "description": "立手机架靠背: 两片紫色方板踩上 y=2 拼缝, 两端各锁一片直角斜撑。",
      "tip": "斜撑竖边吸靠背端缝、横边吸桌板拼缝 —— 靠背从此推不倒。",
      "tiles_to_add": [
        "back_w",
        "back_e",
        "back_brace_w",
        "back_brace_e"
      ],
      "highlight_tiles": [
        "desk_2_1",
        "desk_3_1"
      ]
    },
    {
      "step_number": 8,
      "description": "搭手机坡道: 橙色长板顶边整边吸住靠背顶沿, 坡尾自然落在桌板上。",
      "tip": "30 度斜躺角正好是看视频的角度 —— 手机放上去试试!",
      "tiles_to_add": [
        "phone_ramp"
      ],
      "highlight_tiles": [
        "back_w",
        "back_e"
      ]
    },
    {
      "step_number": 9,
      "description": "布置展示区: 粉色照片窗格框立在北沿, 框顶点一片红色顶花, 黄色便签板骑住双拼缝。",
      "tip": "便签板底边一次吸住两条拼缝, 还和靠背手拉手 —— 长片就要这样用。",
      "tiles_to_add": [
        "frame",
        "clip",
        "board"
      ],
      "highlight_tiles": [
        "back_e",
        "desk_4_2"
      ]
    },
    {
      "step_number": 10,
      "description": "装信件槽收尾: 两道绿色立墙夹出一格投信位 —— 整理站开张!",
      "tip": "信、卡片、课程表都插这里 —— 明天的你会感谢今天搭好它的你。",
      "tiles_to_add": [
        "rack_w",
        "rack_e"
      ],
      "highlight_tiles": [
        "desk_4_0",
        "desk_5_0"
      ]
    }
