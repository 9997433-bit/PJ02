  "steps": [
    {
      "step_number": 1,
      "description": "铺半场南排: 蓝色边线长方形 + 灰色场地长方形 + 蓝色角方板。",
      "tip": "街头半场从南边线铺起, 长方形长边彼此等长互吸。",
      "tiles_to_add": [
        "ct_s_w",
        "ct_s_m",
        "ct_s_e"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺油漆区与中场南带: 橙色大正方形一片顶四片, 南边整边吸边线长方形长边 (2 = 2); 再补中场长方形与方板。",
      "tip": "大正方形是油漆区 —— 罚球线内的必争之地。",
      "tiles_to_add": [
        "paint",
        "ct_m0",
        "ct_m0_e"
      ],
      "highlight_tiles": [
        "ct_s_w"
      ]
    },
    {
      "step_number": 3,
      "description": "合拢场地: 中场北带 + 北边线一排, 半场 5x4 铺完。",
      "tip": "北边线长方形与大正方形北边等长互吸, 场地连成刚性整板。",
      "tiles_to_add": [
        "ct_m1",
        "ct_m1_e",
        "ct_n_w",
        "ct_n_m",
        "ct_n_e"
      ],
      "highlight_tiles": [
        "paint"
      ]
    },
    {
      "step_number": 4,
      "description": "铺篮架塔底板: 2 片灰色方板贴在油漆区西侧场外。",
      "tip": "塔底板中缝互吸, 也是塔身三面墙的地基。",
      "tiles_to_add": [
        "tw_f0",
        "tw_f1"
      ],
      "highlight_tiles": [
        "paint"
      ]
    },
    {
      "step_number": 5,
      "description": "立篮架塔一层: 南/北/西三面墙 U 形围合 (东面敞开做通道), 拐角竖边互吸锁定。",
      "tip": "U 形墙三面锁角, 比两根孤柱结实得多 —— 这是街球篮架的底气。",
      "tiles_to_add": [
        "tw_s_0",
        "tw_n_0",
        "tw_w0_0",
        "tw_w1_0"
      ],
      "highlight_tiles": [
        "tw_f0",
        "tw_f1"
      ]
    },
    {
      "step_number": 6,
      "description": "叠篮架塔二层: 再 4 片墙, 底边整边吸一层墙顶边。",
      "tip": "上下两层墙缝对缝, 拐角继续互吸成环。",
      "tiles_to_add": [
        "tw_s_1",
        "tw_n_1",
        "tw_w0_1",
        "tw_w1_1"
      ],
      "highlight_tiles": [
