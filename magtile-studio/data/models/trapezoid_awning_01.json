  "steps": [
    {
      "step_number": 1,
      "description": "铺步道: 两片灰色长石板整边互吸, 连成 4 格长的赏花步道。",
      "tip": "长石板的 2 格横边一会儿正好给梯形包边当吸合线。",
      "tiles_to_add": [
        "walk_w",
        "walk_e"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺花圃带: 四片泥土方板贴住步道北沿, 两端各补一片黄色碎石板。",
      "tip": "花圃拼缝落在每条整数线上 —— 那是花苗的位置。",
      "tiles_to_add": [
        "bed_0",
        "bed_1",
        "bed_2",
        "bed_3",
        "gravel_w",
        "gravel_e"
      ],
      "highlight_tiles": [
        "walk_w",
        "walk_e"
      ]
    },
    {
      "step_number": 3,
      "description": "种花圃: 五株三角花骑上花圃拼缝, 红紫粉相间排成一行。",
      "tip": "花底边与拼缝等长互吸, 重心正压缝上 —— 一排花墙脚。",
      "tiles_to_add": [
        "flower_0",
        "flower_1",
        "flower_2",
        "flower_3",
        "flower_4"
      ],
      "highlight_tiles": [
        "bed_1",
        "bed_2"
      ]
    },
    {
      "step_number": 4,
      "description": "横砌墙第一层: 两片绿色长方形踩住花圃北沿, 两端立侧翼护墙。",
      "tip": "长方形横着当砖砌 —— 2 格长的顶边就是梯形的专用吸合位。",
      "tiles_to_add": [
        "wall_w0",
