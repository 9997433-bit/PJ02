      ]
    },
    {
      "step_number": 11,
      "description": "砌吧台墙: 广场北沿立 3 片橙色矮墙, 正对出餐窗口。",
      "tip": "吧台墙底边吸广场北沿, 就立在餐车正前方。",
      "tiles_to_add": [
        "bar_w_1",
        "bar_w_2",
        "bar_w_3"
      ],
      "highlight_tiles": [
        "pz_1",
        "pz_3"
      ]
    },
    {
      "step_number": 12,
      "description": "铺吧台台面: 3 片橙色方板同时吸住吧台墙顶边与车身窗台底边。",
      "tip": "一条吧台把餐车和广场焊成整体 —— 出餐、用餐一条线。",
