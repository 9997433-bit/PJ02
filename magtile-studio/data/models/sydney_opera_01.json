      ],
      "highlight_tiles": [
        "pw_w1",
        "pw_e1"
      ]
    },
    {
      "step_number": 6,
      "description": "大台阶: 2 片粉色长板以 30 度斜倚南墙, 顶边吸南墙顶 —— 歌剧院标志性的纪念台阶。",
      "tip": "坡尾自然落地, 顶边与台面同高。",
      "tiles_to_add": [
        "stair_w",
        "stair_e"
      ],
      "highlight_tiles": [
        "pw_s2",
        "pw_s3"
      ]
    },
    {
      "step_number": 7,
      "description": "台面前排: 6 片黄色方板铺上高台 (z=1), 南边逐一吸住南墙顶。",
      "tip": "",
      "tiles_to_add": [
        "dk_f0",
        "dk_f1",
        "dk_f2",
        "dk_f3",
        "dk_f4",
        "dk_f5"
      ],
      "highlight_tiles": [
        "pw_s0",
        "pw_s5"
      ]
