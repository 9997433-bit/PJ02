        "tw_w0_0"
      ]
    },
    {
      "step_number": 7,
      "description": "嵌窗格篮板: 2 片透明窗格方立在塔东口, 竖边吸二层墙竖边、两片中缝互吸。",
      "tip": "窗格就是篮板格纹 —— 打板进筐就靠它。",
      "tiles_to_add": [
        "bb_s",
        "bb_n"
      ],
      "highlight_tiles": [
        "tw_s_1",
        "tw_n_1"
      ]
    },
