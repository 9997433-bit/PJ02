  "steps": [
    {
      "step_number": 1,
      "description": "铺草原基座: 6 片草地方板沿 x 一字铺开 (x 0..6), 相邻边互吸。",
      "tip": "长颈鹿要站上来的地基 —— 绿色青色交替就是斑驳的草地。",
      "tiles_to_add": [
        "gr_0",
        "gr_1",
        "gr_2",
        "gr_3",
        "gr_4",
        "gr_5"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "立前腿下节: 左右前腿各 1 片黄色方片立在草地上 (x 1..2), 底边分别吸草地南北沿边。",
      "tip": "左腿在 y=0 沿, 右腿在 y=1 沿 —— 两片平行相对, 中间留空。",
      "tiles_to_add": [
        "fleg_l_0",
        "fleg_r_0"
      ],
      "highlight_tiles": [
        "gr_1"
      ]
    },
    {
      "step_number": 3,
      "description": "立后腿下节: 同样手法在 x 4..5 立起左右后腿。",
      "tip": "前后腿间距 2 格, 正好是躯干的跨度。",
      "tiles_to_add": [
        "hleg_l_0",
        "hleg_r_0"
      ],
      "highlight_tiles": [
        "gr_4",
        "fleg_l_0"
      ]
    },
    {
      "step_number": 4,
      "description": "前蹄斜撑: 2 片直角三角形竖边吸前腿骨, 横边贴地向西前伸 —— 这是长颈鹿俯身喝水的前蹄, 也是全身的抗侧地锚。",
      "tip": "直角三角形两条直角边同时吸腿与贴地, 双边受力最稳。",
      "tiles_to_add": [
        "hoof_l",
        "hoof_r"
      ],
      "highlight_tiles": [
        "fleg_l_0",
        "fleg_r_0"
      ]
    },
    {
      "step_number": 5,
      "description": "腿加高一节: 4 片橙色方片分别叠上四条腿, 竖边横边全部对齐。",
      "tip": "四条腿都到 2 格高 —— 长颈鹿的腿比很多动物的全身还高。",
      "tiles_to_add": [
        "fleg_l_1",
        "fleg_r_1",
        "hleg_l_1",
        "hleg_r_1"
      ],
      "highlight_tiles": [
        "hoof_l"
      ]
    },
    {
      "step_number": 6,
      "description": "躯干左壁: 4 片方片横跨前后腿顶 (x 1..5), 黄橙相间。",
      "tip": "左壁两端分别压在前后腿顶边上, 中段靠竖边互吸悬跨。",
      "tiles_to_add": [
        "bd_l_1",
        "bd_l_2",
        "bd_l_3",
        "bd_l_4"
      ],
      "highlight_tiles": [
        "fleg_l_1",
        "hleg_l_1"
      ]
    },
    {
      "step_number": 7,
      "description": "躯干右壁: 同样 4 片补齐右侧, 躯干成双壁通道。",
      "tip": "左右壁平行相对, 腹部留空 —— 从侧面看就是修长的肚线。",
      "tiles_to_add": [
        "bd_r_1",
        "bd_r_2",
        "bd_r_3",
        "bd_r_4"
      ],
      "highlight_tiles": [
        "fleg_r_1",
        "hleg_r_1"
      ]
    },
    {
      "step_number": 8,
      "description": "背板压顶: 4 片背板盖住躯干 (z=3), 每片同时吸左右壁顶边, 躯干锁成箱形梁。",
      "tip": "背板是躯干的力学锁扣 —— 盖完轻推躯干应纹丝不动。",
      "tiles_to_add": [
        "bk_1",
        "bk_2",
        "bk_3",
        "bk_4"
      ],
      "highlight_tiles": [
        "bd_l_2",
        "bd_r_2"
      ]
    },
    {
      "step_number": 9,
      "description": "脖颈起步: 左右颈壁各 2 层叠在躯干前端背板上 (x 1..2, z 3..5)。",
      "tip": "颈壁踩着背板与躯干壁顶边起跳, 每层都要对缝竖直向上。",
      "tiles_to_add": [
        "nk_l_0",
        "nk_r_0",
        "nk_l_1",
        "nk_r_1"
      ],
      "highlight_tiles": [
        "bk_1"
      ]
    },
    {
      "step_number": 10,
      "description": "中部横档: 1 片红色横档在 z=5 锁住左右颈壁 —— 脖颈从双壁变成梯架。",
      "tip": "横档同时吸住两侧颈壁顶边, 是长脖子抗晃的关键一档。",
      "tiles_to_add": [
        "rung"
      ],
      "highlight_tiles": [
        "nk_l_1",
        "nk_r_1"
      ]
    },
    {
      "step_number": 11,
      "description": "脖颈到顶: 左右颈壁再各叠 2 层 (z 5..7), 长脖子拔到 7 格高。",
      "tip": "上两层踩在横档与下层颈壁上 —— 全库最高的动物脖颈。",
      "tiles_to_add": [
        "nk_l_2",
        "nk_r_2",
        "nk_l_3",
        "nk_r_3"
      ],
      "highlight_tiles": [
        "rung"
      ]
    },
    {
      "step_number": 12,
      "description": "头底板: 1 片方板盖住颈顶 (z=7), 同时吸左右颈壁顶边。",
      "tip": "这块板既是颈顶横档又是头颅的地板, 一片两用。",
      "tiles_to_add": [
        "hd_base"
      ],
      "highlight_tiles": [
        "nk_l_3",
        "nk_r_3"
      ]
    },
    {
