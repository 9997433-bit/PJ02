  "steps": [
    {
      "step_number": 1,
      "description": "铺林地南行: 深浅绿棋盘格四片, 边边互吸。",
      "tip": "夜色刚落下, 森林安静下来 —— 先铺出这片林间空地。",
      "tiles_to_add": [
        "ground_0_0",
        "ground_1_0",
        "ground_2_0",
        "ground_3_0"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺林地第二、三行: 西缘竖嵌一条长板苔径, 其余方板补齐。",
      "tip": "行行等边互吸, 林地连成一整张网 —— 树桩的墙脚要踩这些拼缝。",
      "tiles_to_add": [
        "moss_w",
        "ground_1_1",
        "ground_2_1",
        "ground_3_1",
        "ground_1_2",
        "ground_2_2",
        "ground_3_2"
      ],
      "highlight_tiles": [
        "ground_0_0"
      ]
    },
    {
      "step_number": 3,
      "description": "铺林地北行: 中段再嵌一条长板苔径, 空地铺满。",
      "tip": "正中四格就是老树桩的家。",
      "tiles_to_add": [
        "ground_0_3",
        "moss_n",
        "ground_3_3"
      ],
      "highlight_tiles": [
        "ground_1_2"
      ]
    },
    {
      "step_number": 4,
      "description": "立树桩南墙与西墙: 四片橙色树皮墙踩住拼缝。",
      "tip": "树桩是猫头鹰的瞭望台 —— 墙脚咬牢, 上面还要站鸟呢。",
      "tiles_to_add": [
        "stump_s_w",
        "stump_s_e",
        "stump_w_s",
        "stump_w_n"
      ],
      "highlight_tiles": [
        "ground_1_1"
      ]
    },
    {
      "step_number": 5,
      "description": "合树桩北墙与东墙: 八片墙环四角竖边互咬闭环。",
      "tip": "2x2 的墙环围好了 —— 这是整只猫头鹰的地基。",
      "tiles_to_add": [
        "stump_n_w",
        "stump_n_e",
        "stump_e_s",
        "stump_e_n"
      ],
      "highlight_tiles": [
        "stump_s_w"
      ]
    },
    {
      "step_number": 6,
      "description": "铺锯木平台: 四片黄色方板边边入扣墙顶, 板板互吸。",
      "tip": "像刚锯开的树桩年轮 —— 每片至少一条边咬住墙顶。",
      "tiles_to_add": [
        "platform_1_1",
        "platform_2_1",
        "platform_1_2",
        "platform_2_2"
      ],
      "highlight_tiles": [
        "stump_s_w"
      ]
    },
    {
      "step_number": 7,
      "description": "起鸟身墙环: 南面两片清色是胸腹, 墙脚压平台拼缝。",
      "tip": "猫头鹰蹲坐的身体是 2x1 的墙环 —— 荷载沿墙面一路传到地面。",
      "tiles_to_add": [
        "body_s_w",
        "body_s_e",
        "body_n_w",
        "body_n_e",
        "body_w",
        "body_e"
      ],
      "highlight_tiles": [
        "platform_1_1"
      ]
    },
    {
      "step_number": 8,
      "description": "叠头部墙环: 南面装一对窗格方 —— 那是它的大圆眼!",
      "tip": "窗格的洞就是瞳孔 —— 猫头鹰的眼睛在夜里最亮。",
      "tiles_to_add": [
        "eye_w",
        "eye_e",
        "head_n_w",
        "head_n_e",
        "head_w",
        "head_e"
      ],
      "highlight_tiles": [
        "body_s_w"
      ]
    },
    {
      "step_number": 9,
      "description": "盖头顶盖板, 竖起双耳羽: 等边三角骑住盖板东西侧沿。",
      "tip": "两撮耳羽尖尖的 —— 其实那不是耳朵, 是它的羽毛角。",
      "tiles_to_add": [
        "cap_w",
        "cap_e",
        "ear_w",
        "ear_e"
      ],
      "highlight_tiles": [
        "eye_w"
      ]
    },
    {
      "step_number": 10,
      "description": "贴收拢的翅膀, 插上尾羽: 猫头鹰全身完工。",
      "tip": "瘦高翅膀骑平台侧沿贴在身后, 尾羽朝北 —— 起飞前的姿势。",
      "tiles_to_add": [
        "wing_w",
        "wing_e",
        "tail_w",
        "tail_e"
      ],
      "highlight_tiles": [
