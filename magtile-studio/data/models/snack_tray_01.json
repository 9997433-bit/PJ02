  "steps": [
    {
      "step_number": 1,
      "description": "铺托底第一排 (靠自己这排): 两片长方板头对头吸成一条长边。",
      "tip": "长方板短边对短边吸住, 托盘的地基就有了。",
      "tiles_to_add": [
        "board_0_0",
        "board_2_0"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺完托底: 再来四片长方板, 颜色橙黄错开, 拼成 4x3 大托底。",
      "tip": "每片长边都要与上一排整边贴合 —— 托底平整, 点心才放得稳。",
      "tiles_to_add": [
        "board_0_1",
        "board_2_1",
        "board_0_2",
        "board_2_2"
      ],
      "highlight_tiles": [
        "board_0_0"
      ]
    },
    {
      "step_number": 3,
      "description": "立两条长边围沿: 四片青色横楣踩住托底长边, 底边一次吸满两格。",
      "tip": "横楣是长片, 立的时候扶住两端再松手。",
      "tiles_to_add": [
        "rim_s_0",
        "rim_s_2",
        "rim_n_0",
        "rim_n_2"
      ],
      "highlight_tiles": [
        "board_0_0",
        "board_0_2"
      ]
    },
    {
      "step_number": 4,
      "description": "装两端提手墙: 绿方夹住透明窗格, 窗孔就是提手孔, 竖边与围沿咬角。",
      "tip": "窗格放中间高度正好 —— 大人的手指能穿过窗孔把托盘端起来。",
      "tiles_to_add": [
        "end_w_a",
        "handle_w",
        "end_w_b",
        "end_e_a",
        "handle_e",
        "end_e_b"
      ],
      "highlight_tiles": [
        "rim_s_0",
        "rim_n_0"
      ]
    },
    {
      "step_number": 5,
      "description": "立中隔墙: 三片蓝色方板沿正中拼缝排开, 托盘分成咸甜两格。",
      "tip": "隔墙两端与围沿竖边互咬, 像'日'字一样锁成整体。",
      "tiles_to_add": [
        "divider_0",
        "divider_1",
        "divider_2"
      ],
      "highlight_tiles": [
        "rim_s_0",
        "rim_s_2"
      ]
    },
    {
      "step_number": 6,
      "description": "插招牌小旗: 两面红色三角旗立上提手窗顶 —— 点心托盘开张!",
      "tip": "左格放咸的、右格放甜的, 小旗写上今日招牌。",
      "tiles_to_add": [
        "flag_w",
        "flag_e"
      ],
      "highlight_tiles": [
        "handle_w",
        "handle_e"
      ]
    }
