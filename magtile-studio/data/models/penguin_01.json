  "steps": [
    {
      "step_number": 1,
      "description": "铺浮冰南列: [0,5]x[0,1] 铺 5 片透明青色相间方板。",
      "tip": "浮冰是全家的舞台, 透明片就是新结的亮冰。",
      "tiles_to_add": [
        "fl_0_0",
        "fl_1_0",
        "fl_2_0",
        "fl_3_0",
        "fl_4_0"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺浮冰中列: 再铺 5 片, 大企鹅将站在这一列上。",
      "tip": "拼缝对齐, 冰面才平整。",
      "tiles_to_add": [
        "fl_0_1",
        "fl_1_1",
        "fl_2_1",
        "fl_3_1",
        "fl_4_1"
      ],
      "highlight_tiles": [
        "fl_0_0"
      ]
    },
    {
      "step_number": 3,
      "description": "铺浮冰北列: 5 片补齐, 浮冰成型。",
      "tip": "北沿留给冰山背景 —— 一会儿它们会立起来。",
      "tiles_to_add": [
        "fl_0_2",
        "fl_1_2",
        "fl_2_2",
        "fl_3_2",
        "fl_4_2"
      ],
      "highlight_tiles": [
        "fl_0_1"
      ]
    },
    {
      "step_number": 4,
      "description": "铺海水: 浮冰东侧 3 片蓝色长板拼出海面。",
      "tip": "长板短边吸浮冰边 —— 冰与海从此连成整体。",
      "tiles_to_add": [
        "sea_0",
        "sea_1",
        "sea_2"
      ],
      "highlight_tiles": [
        "fl_4_0",
        "fl_4_2"
      ]
    },
    {
      "step_number": 5,
      "description": "砌身躯第 1 层: 透明前壁 (白肚皮) + 蓝色后壁两片长方形, 加两片方形侧壁, 拐角竖边互吸自锁成环。",
      "tip": "长边给前后壁、短边给侧壁 —— 圈层砌法的长短分工。",
      "tiles_to_add": [
        "pg_s_0",
        "pg_w_0",
        "pg_n_0",
        "pg_e_0"
      ],
      "highlight_tiles": [
        "fl_1_1",
        "fl_2_1"
      ]
    },
    {
      "step_number": 6,
      "description": "砌身躯第 2 层: 再叠一环, 上环整边压下环。",
      "tip": "帝企鹅站起来有一米多高 —— 塔式身躯要对缝直叠。",
      "tiles_to_add": [
        "pg_s_1",
        "pg_w_1",
        "pg_n_1",
        "pg_e_1"
      ],
      "highlight_tiles": [
        "pg_s_0"
      ]
    },
    {
      "step_number": 7,
      "description": "压双肩: 2 片蓝色方板并排盖住身躯顶口。",
      "tip": "用 2 片方板而不是 1 片长板 —— 头颅的四条底边才有处可吸。",
      "tiles_to_add": [
        "sh_w",
        "sh_e"
      ],
      "highlight_tiles": [
        "pg_w_1",
        "pg_e_1"
      ]
    },
    {
      "step_number": 8,
      "description": "落头颅: 东肩上四面立墙围出头颅小箱, 脸颊朝南是透明的。",
      "tip": "四条底边边边落吸 —— 四重连接, 头颅没有单点失效。",
      "tiles_to_add": [
        "hd_s",
        "hd_w",
        "hd_n",
        "hd_e"
      ],
      "highlight_tiles": [
        "sh_e",
        "sh_w"
      ]
    },
    {
      "step_number": 9,
      "description": "封头顶接扁喙: 头顶方板四边压墙顶, 橙色等边扁喙从东沿水平收尖。",
      "tip": "扁喙悬挑力矩 5 <= 预算 20 —— 正望着滑梯的方向。",
      "tiles_to_add": [
        "hd_top",
        "beak"
      ],
      "highlight_tiles": [
        "hd_s",
        "hd_e"
      ]
    },
    {
      "step_number": 10,
      "description": "撑鳍肢: 两片蓝色菱形从冰面斜倚身躯前后两侧, 底边整边吸浮冰边。",
      "tip": "菱形 60 度的天然斜度就是鳍肢摆动的角度 —— 接地斜撑, 越靠越稳。",
      "tiles_to_add": [
        "fin_s",
        "fin_n"
      ],
      "highlight_tiles": [
        "pg_s_0",
        "pg_n_0"
      ]
    },
    {
      "step_number": 11,
      "description": "搭企鹅宝宝: 浮冰东北角四面灰色立墙围出毛茸茸的小身子。",
      "tip": "宝宝紧挨着大企鹅 —— 帝企鹅是全世界最顾家的鸟。",
      "tiles_to_add": [
        "ck_s",
        "ck_w",
        "ck_n",
        "ck_e"
      ],
      "highlight_tiles": [
        "fl_4_2"
      ]
    },
    {
