  "steps": [
    {
      "step_number": 1,
      "description": "观星广场南排: 4 片方板一字铺开 (x 0..4, y 0..1), 灰蓝相间。",
      "tip": "中央 2x2 空位是鼓身的地基 —— 广场只围不占。",
      "tiles_to_add": [
        "pz_0_0",
        "pz_1_0",
        "pz_2_0",
        "pz_3_0"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "广场合围: 西/北各平铺 1 片长板 (2 格长), 东侧 2 片方板, 再补东北西北两角 —— 外环合拢。",
      "tip": "西/北的长板长边留给鼓身底边整边吸合 —— 这是塔的地锚。",
      "tiles_to_add": [
        "pw",
        "pn",
        "pz_3_1",
        "pz_3_2",
        "pz_0_3",
        "pz_3_3"
      ],
      "highlight_tiles": [
        "pz_0_0",
        "pz_3_0"
      ]
    },
    {
      "step_number": 3,
      "description": "六边形星图: 紫色六边形北边整边吸广场南沿 (x 1..2), 上面立 1 片黄色日晷尖, 旁边再种 1 丛绿色灌木。",
      "tip": "六边形的边长与方板边长通用, 对准 x 1..2 那一段再放。",
      "tiles_to_add": [
        "starmap",
        "sundial",
        "shrub"
      ],
      "highlight_tiles": [
        "pz_1_0",
        "pz_2_0"
      ]
    },
    {
      "step_number": 4,
      "description": "鼓身底环: 3 片灰色长方形横立成 U 形 (西/北/东), 拐角竖边两两互吸; 西/北两片底边整边吸住广场长板边, 南面整面留空作拱门。",
      "tip": "长方形横着立 —— 一片顶两格宽, 三片就围出大半个塔身。",
      "tiles_to_add": [
        "dr0_w",
        "dr0_n",
        "dr0_e"
      ],
      "highlight_tiles": [
        "pw",
        "pn"
      ]
    },
    {
      "step_number": 5,
      "description": "望远镜厅: 塔内平铺 2 片地板长方形 (长边分别吸鼓身东西底边), 中缝立起橙色赤道仪基墩, 基墩顶边再立 1 片红色梯形接收架 —— 趁塔顶敞开先装好内部设备。",
      "tip": "等穹顶封了口, 手就伸不进去了 —— 内部件永远先装。",
      "tiles_to_add": [
        "fl_w",
        "fl_e",
        "pier",
        "dish"
      ],
      "highlight_tiles": [
        "dr0_w",
        "dr0_e"
      ]
    },
    {
      "step_number": 6,
      "description": "鼓身中环 U 形: 西/北/东 3 片蓝色长方形整边叠上底环顶边。",
      "tip": "上环底边与下环顶边等长, 整边贴合才吸得实。",
      "tiles_to_add": [
        "dr1_w",
        "dr1_n",
        "dr1_e"
      ],
      "highlight_tiles": [
        "dr0_w",
        "dr0_e"
      ]
    },
    {
      "step_number": 7,
      "description": "拱门门楣: 黄色长方形横跨拱门上方, 两端竖边分别吸中环西片与东片的竖边 —— 三边受力的过梁。",
      "tip": "门楣下方是 2 格宽的拱门 —— 观测员推着仪器车进出无碍。",
      "tiles_to_add": [
        "dr1_s"
      ],
      "highlight_tiles": [
        "dr1_w",
        "dr1_e"
      ]
    },
    {
      "step_number": 8,
      "description": "鼓身顶环: 4 片长方形合成完整一环, 东面用透明片作采光带。",
      "tip": "顶环四片拐角全部互吸, 是承接穹顶的刚性环梁。",
      "tiles_to_add": [
        "dr2_w",
        "dr2_n",
        "dr2_e",
        "dr2_s"
      ],
      "highlight_tiles": [
        "dr1_s",
        "dr1_n"
      ]
    },
    {
      "step_number": 9,
      "description": "穹顶下级·南北面: 2 片青色梯形下底整边吸顶环顶边, 向内倾斜。",
      "tip": "梯形下底长 2, 恰与长方形顶边等长 —— 这就是叠环的深意。",
      "tiles_to_add": [
        "dome_s",
        "dome_n"
      ],
      "highlight_tiles": [
        "dr2_s",
        "dr2_n"
      ]
    },
    {
      "step_number": 10,
      "description": "穹顶下级·东西面: 再上 2 片, 四腰两两互吸收成 1x1 顶口; 东面这片用透明 —— 观测缝的下半段。",
      "tip": "腰边卡进相邻梯形的瞬间会咔哒一声 —— 那是自锁完成。",
      "tiles_to_add": [
        "dome_e",
        "dome_w"
      ],
      "highlight_tiles": [
