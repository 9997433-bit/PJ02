  "steps": [
    {
      "step_number": 1,
      "description": "铺南列走道: 灰色长石板与黄色踏步石按 长-方-长-方-长 交替铺满 8 格。",
      "tip": "长板给墙段留 2 格整边, 方板给窗洞留 1 格整边 —— 交替节奏就是吸合蓝图。",
      "tiles_to_add": [
        "floor_s_0",
        "floor_s_2",
        "floor_s_3",
        "floor_s_5",
        "floor_s_6"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺北列走道: 与南列同款交替铺法, 两列拼缝逐段对齐互吸。",
      "tip": "黄踏步石上下两列对齐 —— 走到这格, 抬头就是将来的天光缝。",
      "tiles_to_add": [
        "floor_n_0",
        "floor_n_2",
        "floor_n_3",
        "floor_n_5",
        "floor_n_6"
      ],
      "highlight_tiles": [
        "floor_s_0"
      ]
    },
    {
      "step_number": 3,
      "description": "立南侧连拱墙: 三段绿色 2 格立墙踩住长石板南沿, 空出两个取景窗洞。",
      "tip": "墙段只踩长板整边, 窗洞正对黄踏步石 —— 负空间留给窗外的花。",
      "tiles_to_add": [
        "arc_s_0",
        "arc_s_3",
        "arc_s_6"
      ],
      "highlight_tiles": [
