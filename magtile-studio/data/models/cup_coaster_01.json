  "steps": [
    {
      "step_number": 1,
      "description": "铺地台: 两片黄色大正方形并排吸合, 一片顶四片小方, 地基一步到位。",
      "tip": "大正方形边长 2, 一条边能同时吸住两片小方 —— 记住这招。",
      "tiles_to_add": [
        "base_w",
        "base_e"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "围南墙与西墙: 六片橙色方板墙脚整边骑住大方板边, 逐片手拉手。",
      "tip": "",
      "tiles_to_add": [
        "rim_s_0",
