{
  "schema_version": 1,
  "id": "rocket_launchpad_01",
  "name": "火箭发射台",
  "name_en": "Rocket Launchpad 01",
  "description": "航天主题旗舰: 5x5 发射场上, 三级透明箭体由 4 片风车状红色尾翼锁定, 锥形整流罩四片斜棱自锁成环; 勤务塔与箭体之间架起登舱桥形成结构闭环, 西南角燃料罐、四座避雷塔与一圈警戒火焰旗把发射场围得像真的一样 —— 点火倒计时, 5、4、3、2、1!",
  "difficulty": 4,
  "total_pieces": 89,
  "tags": [
    "航天",
    "火箭",
    "发射场",
    "旗舰"
  ],
