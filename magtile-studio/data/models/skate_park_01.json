  "steps": [
    {
      "step_number": 1,
      "description": "铺场地南排: 西段长方形 + 6 片方板密缝排开 (道具柱线都落在这排缝上)。",
      "tip": "南排用方板密缝 —— 磨杆柱和火山围墙都要吸在这些拼缝上。",
      "tiles_to_add": [
        "f0_w",
        "f0_2",
        "f0_3",
        "f0_4",
        "f0_5",
        "f0_6",
        "f0_7"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺涂鸦带第一排: 方板收两端, 3 片青色长方形居中。",
      "tip": "青色涂鸦带是公园的招牌 —— 轮子擦过就是一道弧线。",
      "tiles_to_add": [
        "f1_w",
        "f1_a",
        "f1_b",
        "f1_c",
        "f1_e"
      ],
      "highlight_tiles": [
        "f0_w"
      ]
    },
    {
      "step_number": 3,
      "description": "铺涂鸦带第二排: 与第一排对称。",
      "tip": "长方形长边彼此等长互吸 (2 = 2)。",
      "tiles_to_add": [
        "f2_w",
        "f2_a",
        "f2_b",
        "f2_c",
        "f2_e"
      ],
      "highlight_tiles": [
        "f1_a"
      ]
    },
    {
      "step_number": 4,
      "description": "铺场地北排: 4 片长方形合拢 8x4 水泥板场。",
      "tip": "场地连成刚性整板, 道具才有稳固地基。",
      "tiles_to_add": [
        "f3_0",
        "f3_1",
        "f3_2",
        "f3_3"
      ],
      "highlight_tiles": [
        "f2_w"
      ]
    },
    {
      "step_number": 5,
      "description": "立方箱跳台南墙与西墙: 4 片橙色墙板, 拐角竖边互吸。",
      "tip": "墙底边吸场地拼缝, 拐角一锁就不晃。",
      "tiles_to_add": [
        "bx_s_0",
        "bx_s_1",
        "bx_w_0",
        "bx_w_1"
      ],
      "highlight_tiles": [
        "f1_b"
      ]
    },
    {
      "step_number": 6,
      "description": "合拢方箱北墙与东墙: 再 4 片, 八墙围筒成环。",
      "tip": "围筒是最结实的箱形结构 —— 跳台的全部底气。",
      "tiles_to_add": [
        "bx_n_0",
        "bx_n_1",
        "bx_e_0",
        "bx_e_1"
      ],
      "highlight_tiles": [
