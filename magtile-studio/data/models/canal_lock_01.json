  "steps": [
    {
      "step_number": 1,
      "description": "铺南岸: 六片灰绿相间的方板沿运河排开。",
      "tip": "运河沿着东西向流, 两岸步道就是全场的地基。",
      "tiles_to_add": [
        "bank_s_0",
        "bank_s_1",
        "bank_s_2",
        "bank_s_3",
        "bank_s_4",
        "bank_s_5"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺下游水面: 四片蓝色方板贴着南岸拼开, 这是低的那级水位。",
      "tip": "下游的水贴着地面 —— 记住这个高度, 一会儿要和上游比一比。",
      "tiles_to_add": [
        "low_0_1",
        "low_1_1",
        "low_0_2",
        "low_1_2"
      ],
      "highlight_tiles": [
        "bank_s_0"
      ]
    },
    {
      "step_number": 3,
      "description": "铺闸室水面, 橙色驳船底就位闸室东南格。",
      "tip": "驳船开进闸室, 就停在两道闸门之间。",
      "tiles_to_add": [
        "ch_2_1",
        "ch_2_2",
        "ch_hull",
        "ch_3_2"
      ],
      "highlight_tiles": [
        "low_1_1"
      ]
    },
    {
      "step_number": 4,
      "description": "铺北岸: 六片方板贴着水面北沿排开, 与南岸隔河对望。",
      "tip": "岸线上的每一道拼缝, 待会都要接住闸墙的墙脚。",
      "tiles_to_add": [
        "bank_n_0",
        "bank_n_1",
        "bank_n_2",
        "bank_n_3",
        "bank_n_4",
        "bank_n_5"
      ],
      "highlight_tiles": [
        "ch_2_2"
      ]
    },
    {
      "step_number": 5,
      "description": "驳船上装清色驾驶舱与红色桅旗, 都骑在水面拼缝上。",
      "tip": "底边整边吸住拼缝, 重心正压铰链线 —— 船稳稳当当。",
      "tiles_to_add": [
        "boat_cabin",
        "boat_mast"
      ],
      "highlight_tiles": [
        "ch_hull"
      ]
    },
    {
      "step_number": 6,
      "description": "立闸室高墙: 南北各两片灰墙踩住岸线拼缝。",
      "tip": "闸室的墙要挡住涨起来的水, 墙脚整边吸缝一片不能歪。",
      "tiles_to_add": [
        "lk_s_2",
        "lk_s_3",
        "lk_n_2",
        "lk_n_3"
      ],
      "highlight_tiles": [
        "ch_2_1"
      ]
    },
    {
      "step_number": 7,
      "description": "挂下游闸门与系船柱: 两扇绿叶已经拉开贴在墙外侧。",
      "tip": "船进来之后闸门就会合上; 黄色系船柱先把缆绳挂好。",
      "tiles_to_add": [
        "gate_dn_s",
        "gate_dn_n",
        "bollard_s",
        "bollard_n"
      ],
      "highlight_tiles": [
        "lk_s_2"
      ]
    },
    {
      "step_number": 8,
      "description": "围上游高水位池的南北壁: 四片灰墙踩岸线拼缝。",
      "tip": "上游的水位比下游高一整层, 池壁就是它的堤坝。",
      "tiles_to_add": [
        "pl_s_4",
        "pl_s_5",
        "pl_n_4",
        "pl_n_5"
      ],
      "highlight_tiles": [
