      ]
    },
    {
      "step_number": 9,
      "description": "盖车顶: 3 片灰色方板压住四面墙顶, 餐车封顶。",
      "tip": "从出餐窗口望进去, 厨房宽敞明亮。",
      "tiles_to_add": [
        "rf_1",
        "rf_2",
