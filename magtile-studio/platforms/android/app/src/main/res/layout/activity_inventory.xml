<?xml version="1.0" encoding="utf-8"?>
<!-- 磁力片库存录入: 标题栏 (返回 + 合计角标) + 分组片型步进器列表 +
     页脚保存操作条 (对齐桌面 InventoryPage.qml 的字段与信息层级) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/magtile_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- 大返回键 (触控目标 >= 48dp) -->
        <TextView
            android:id="@+id/inventory_back"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/inventory_back"
            android:textColor="@color/magtile_on_primary"
            android:textSize="@dimen/text_section"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/inventory_title"
            android:textColor="@color/magtile_on_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <!-- 合计角标 (随录入实时刷新) -->
        <TextView
            android:id="@+id/inventory_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/magtile_on_primary"
            android:textSize="@dimen/text_secondary"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:text="@string/inventory_hint"
        android:textColor="@color/magtile_text_secondary"
        android:textSize="@dimen/text_secondary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <!-- 基础套装 (核心 9 片型) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/inventory_group_core"
                android:textColor="@color/magtile_text_primary"
                android:textSize="@dimen/text_section"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/inventory_core_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 扩展包 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/inventory_group_expansion"
                android:textColor="@color/magtile_text_primary"
                android:textSize="@dimen/text_section"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/inventory_expansion_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- 页脚操作条: 保存 / 保存并看看我能搭什么 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/magtile_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/inventory_zero_note"
            android:textColor="@color/magtile_text_secondary"
            android:textSize="@dimen/text_caption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/inventory_save"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginEnd="@dimen/spacing_small"
                android:layout_weight="1"
                android:text="@string/inventory_save"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/inventory_save_match"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1.4"
                android:backgroundTint="@color/magtile_primary"
                android:text="@string/inventory_save_match"
                android:textColor="@color/magtile_on_primary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
