  "steps": [
    {
      "step_number": 1,
      "description": "铺设主塔地台与攀岩围裙: 4 片灰色方板做塔基, 塔西再铺 2 片围裙板。",
      "tip": "地台是整座乐园的锚点, 6 片板缝缝相吸铺成一整块。",
      "tiles_to_add": [
        "pd_0_0",
        "pd_1_0",
        "pd_0_1",
        "pd_1_1",
        "ap_0",
        "ap_1"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺设落地沙坑: 塔东 8 片黄色方板, 竞速滑道将从这里冲线。",
      "tip": "沙坑板与塔基板整边吸合 —— 落地区要足够长才安全。",
      "tiles_to_add": [
        "sd_2_0",
        "sd_2_1",
