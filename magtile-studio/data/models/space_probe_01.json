  "steps": [
    {
      "step_number": 1,
      "description": "铺十字着陆架内圈: 灰色方板放正中当舱底, 东南西北各贴一片, 拼成小十字。",
      "tip": "板与板整边完整贴合 —— 探测器落地要四平八稳。",
      "tiles_to_add": [
        "pad_c",
        "arm_w1",
        "arm_e1",
        "arm_s1",
        "arm_n1"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "接长四条臂: 四片黄色警示板接在臂端, 十字着陆架伸展完成。",
      "tip": "",
      "tiles_to_add": [
