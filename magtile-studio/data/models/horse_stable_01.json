  "steps": [
    {
      "step_number": 1,
      "description": "铺场地南行: 西边三片草地, 东边三片沙地。",
      "tip": "草绿和沙黄的分界线就是训练场的入口线。",
      "tiles_to_add": [
        "fld_0_0",
        "fld_1_0",
        "fld_2_0",
        "fld_3_0",
        "fld_4_0",
        "fld_5_0"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺第二行: 行行等边互吸, 跳栏都要踩这行的拼缝。",
      "tip": "沙地松软, 小马落地不伤蹄 —— 真正的马场也铺沙。",
      "tiles_to_add": [
        "fld_0_1",
        "fld_1_1",
        "fld_2_1",
        "fld_3_1",
        "fld_4_1",
        "fld_5_1"
      ],
      "highlight_tiles": [
        "fld_0_0"
      ]
    },
    {
      "step_number": 3,
      "description": "铺第三行: 训练场越来越大。",
      "tip": "西边草地待会放草料垛, 东边沙地是小马的舞台。",
      "tiles_to_add": [
        "fld_0_2",
        "fld_1_2",
        "fld_2_2",
        "fld_3_2",
        "fld_4_2",
        "fld_5_2"
      ],
      "highlight_tiles": [
        "fld_0_1"
      ]
    },
    {
      "step_number": 4,
      "description": "铺第四行: 马厩地基与围栏墙脚线就位。",
      "tip": "整片场地连成一张网, 每道拼缝都是一条磁力吸边。",
      "tiles_to_add": [
        "fld_0_3",
        "fld_1_3",
        "fld_2_3",
        "fld_3_3",
        "fld_4_3",
        "fld_5_3"
      ],
      "highlight_tiles": [
        "fld_0_2"
      ]
    },
    {
      "step_number": 5,
      "description": "立马厩北墙: 窗格方后窗居西, 两片橙色木板墙接排。",
      "tip": "北墙踩住场地北沿, 三片竖边互咬连成整面。",
      "tiles_to_add": [
        "barn_n_0",
        "barn_n_1",
        "barn_n_2"
      ],
      "highlight_tiles": [
        "fld_0_3"
      ]
    },
    {
      "step_number": 6,
      "description": "插四道隔墙: 山墙加隔墙隔出三个单间马房。",
      "tip": "每道隔墙都与北墙竖边互咬 —— 格格成环, 拆一片不倒。",
      "tiles_to_add": [
        "barn_w_0",
        "barn_p_1",
        "barn_p_2",
        "barn_e_3"
      ],
      "highlight_tiles": [
        "barn_n_0"
      ]
    },
    {
      "step_number": 7,
      "description": "盖马厩屋面, 屋脊旗骑上北墙顶。",
      "tip": "每片屋面北边压北墙顶、东西两边压隔墙顶, 三边受力; 旗杆底边一线双吸直上 3.0。",
      "tiles_to_add": [
        "barn_r_0",
        "barn_r_1",
        "barn_r_2",
        "barn_flag"
      ],
      "highlight_tiles": [
        "barn_p_1"
      ]
    },
    {
      "step_number": 8,
      "description": "两匹马从栏门探出头: 底边整边吸住屋面南沿。",
      "tip": "南面敞开就是栏门 —— 中间那间的小马已经出去训练啦。",
      "tiles_to_add": [
        "head_a",
