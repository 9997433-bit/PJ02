  "steps": [
    {
      "step_number": 1,
      "description": "铺展示垫: 连桥方板把百宝盒与右侧工作台接成一体。",
      "tip": "实用功能 D1 开工! 展示垫就是盖板平拼的工作台。",
      "tiles_to_add": [
        "link_20",
        "pad_3_0",
        "pad_4_0",
        "pad_4_1"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "拼盒底: 四片胡桃木方板 2x2 整边互吸, 角对角对齐。",
      "tip": "盒底拼缝对齐, 墙脚才有整边可吸。",
      "tiles_to_add": [
        "base_00",
        "base_01",
        "base_10",
        "base_11"
      ],
      "highlight_tiles": [
        "link_20"
      ]
    },
    {
      "step_number": 3,
      "description": "围盒身: 四片方墙踩住盒底四沿, 四角竖边互咬成环。",
      "tip": "闭环箱框 —— 荷载沿墙面直下, 百宝才装得稳。",
      "tiles_to_add": [
        "wall_s",
        "wall_n",
        "wall_w",
        "wall_e"
