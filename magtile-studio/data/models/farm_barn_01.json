  "steps": [
    {
      "step_number": 1,
      "description": "铺院子南排: 6 片地坪沿南沿排开, 灰色方板是大门正南的小路, 长板拼缝正落在谷仓南墙线上。",
      "tip": "长板 [1,3] 的北长边就是谷仓南墙的地基线 —— 拼缝纪律从第一步开始。",
      "tiles_to_add": [
        "g_0_0",
        "g_r_s",
        "g_3_0",
        "g_4_0",
        "g_r_se",
        "g_7_0"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺仓内与披屋地坪: 灰色长板铺出仓内两进地面, 东侧再补草料场地坪。",
      "tip": "仓内 y=2 拼缝是谷仓北墙线, y=3 拼缝是披屋北墙线 —— 一缝不差。",
