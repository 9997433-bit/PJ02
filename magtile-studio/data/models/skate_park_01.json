{
  "schema_version": 1,
  "id": "skate_park_01",
  "name": "滑板公园",
  "name_en": "Skate Park",
  "description": "街式滑板公园: 8x4 水泥板场上四件道具各不重样 —— 中央八墙围筒方箱跳台挂双 30 度下坡, 西侧靠墙斜坡双坡道挂墙顶, 东南角四墙围筒直接戴等边四坡锥成火山跳包, 东北高低台半围压顶再放单坡; 方箱前双柱桥式磨杆三点受力, 入场双旗与雪糕筒画出练习区 —— 助跑、起跳、尖翻上杆, 稳稳落地!",
  "difficulty": 3,
  "total_pieces": 60,
