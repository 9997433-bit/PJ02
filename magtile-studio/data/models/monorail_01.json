        "py_10_1"
      ]
    },
    {
      "step_number": 8,
      "description": "立列车南墙: 橙色乘客门在前, 3 扇透明观景窗随后。",
      "tip": "墙脚踩轨道梁的南沿 —— 单轨列车是跨坐在梁上的。",
      "tiles_to_add": [
        "car_s_3",
