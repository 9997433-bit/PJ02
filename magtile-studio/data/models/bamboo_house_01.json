{
  "schema_version": 1,
  "id": "bamboo_house_01",
  "name": "竹楼民居",
  "name_en": "Bamboo Stilt House 01",
  "description": "全库第一座架空建筑: 12 片楼板悬架在 6 根石柱墩上 (吊脚楼), 先柱顶板后悬跨板的铺法让每片放下即吸; 两层竹墙戴梯形攒尖茅顶 (长方形顶棚作转换层), 前沿挑廊配 30 度竹梯斜下院坝; 东侧粮仓小竹楼同样架空防潮, 院坝地坪把全场连成一个整体。",
  "difficulty": 3,
  "total_pieces": 62,
  "tags": [
    "民居风情",
    "建筑",
    "架空",
    "田园",
    "需要扩展装"
  ],
