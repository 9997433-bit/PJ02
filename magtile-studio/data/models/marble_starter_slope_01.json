  "steps": [
    {
      "step_number": 1,
      "description": "铺跑道: 三片青色方板整边相吸一字排开 —— 这就是滚珠要跑的直道。",
      "tip": "",
      "tiles_to_add": [
        "track_1",
        "track_2",
        "track_3"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "立发射塔: 东墙墙脚先吸住跑道板西边, 其余三面墙竖棱角缝互吸围成一圈。",
      "tip": "四片墙的竖棱像小手拉手 —— 拉成一圈塔就推不倒了。",
      "tiles_to_add": [
        "tw_e",
        "tw_s",
        "tw_n",
        "tw_w"
      ],
      "highlight_tiles": [
        "track_1"
      ]
    },
    {
      "step_number": 3,
      "description": "盖塔帽搭滑坡: 黄色塔帽四边整边锁住墙顶, 橙色长板坡顶吸塔帽东沿、坡尾顺势落在跑道上, 出发旗骑上塔帽西沿, 灰色上球台贴住塔脚。",
      "tip": "30 度斜面是滚珠的发动机 —— 越陡越快, 这个角度刚刚好。",
      "tiles_to_add": [
        "t_cap",
        "slope",
        "start_flag",
        "pad_w"
      ],
      "highlight_tiles": [
        "tw_e"
      ]
    },
    {
      "step_number": 4,
      "description": "装护轨: 四片蓝色方墙墙脚压住跑道板边, 竖棱先吸塔角再依次手拉手。",
      "tip": "护轨夹住滑坡两侧 —— 滚珠再调皮也跑不出道。",
      "tiles_to_add": [
        "rail_s1",
        "rail_n1",
        "rail_s2",
        "rail_n2"
      ],
      "highlight_tiles": [
        "track_1",
        "track_2"
      ]
    },
    {
      "step_number": 5,
      "description": "围接球槽: 三片绿色方墙在道尾合围, 开口正对滑坡 —— 滚珠到站!",
      "tip": "",
