  "steps": [
    {
      "step_number": 1,
      "description": "铺台下与两廊地垫: 台下四片灰色方板, 东西两廊与训练角绿色方板。",
      "tip": "擂台的八道墙脚全踩在灰色方板的拼缝上 —— 先把地基铺方正。",
      "tiles_to_add": [
        "mat_u_2_2",
        "mat_u_3_2",
        "mat_u_2_3",
        "mat_u_3_3",
        "mat_w_2",
        "mat_w_3",
        "mat_e_2",
        "mat_e_3",
