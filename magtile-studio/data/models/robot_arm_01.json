        "pd_e_0"
      ]
    },
    {
      "step_number": 5,
      "description": "立前臂柱: x=4 拼缝上叠 2 片灰色方墙, 与肩座同高。",
      "tip": "先立远端支点 —— 大臂伸过来时才有地方落脚。",
      "tiles_to_add": [
        "fa_0",
        "fa_1"
      ],
      "highlight_tiles": [
        "fl_d_2"
      ]
    },
    {
      "step_number": 6,
      "description": "架肩顶平台与大臂: 平台四边压环顶, 大臂 2 片向东接力, 远端稳稳搭上前臂柱顶。",
      "tip": "大臂第 1 片力矩 15 <= 预算 17.5, 第 2 片双端受力 —— 零悬挑。",
