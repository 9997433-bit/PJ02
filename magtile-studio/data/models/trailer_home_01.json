  "steps": [
    {
      "step_number": 1,
      "description": "铺草地·第 1 行: 方板+长板混铺 (y 0..1), 长板落在 x 3..5。",
      "tip": "长板拼缝就是轮轴线 —— 单轴房车的轮子将吸在这条缝上。",
      "tiles_to_add": [
        "g0_0",
        "g1_0",
        "g2_0",
        "gr_0",
        "g5_0",
        "g6_0",
        "g7_0"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺草地·第 2 行: 同样混铺一行 (y 1..2)。",
      "tip": "两行长板缝上下对齐 —— 轮组底边要同时咬住两条长边。",
