  "steps": [
    {
      "step_number": 1,
      "description": "铺耕地南沿: 6 片地坪排开, 橙色长板是翻好的垄沟。",
      "tip": "垄沟 [1,3] 的北长边就是大后轮的地基缝 —— 拼缝先行。",
      "tiles_to_add": [
        "f_0_0",
        "f_r0",
        "f_3_0",
        "f_4_0",
        "f_r1",
        "f_7_0"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺耕地中部: 2 行灰色车底土路加橙色垄沟, 拖拉机的车位留好了。",
      "tip": "y=1 与 y=3 两条拼缝之间, 就是车身的宽度。",
      "tiles_to_add": [
        "f_0_1",
        "f_a_1",
        "f_b_1",
        "f_c_1",
        "f_7_1",
        "f_0_2",
        "f_a_2",
        "f_b_2",
        "f_c_2",
        "f_7_2"
      ],
      "highlight_tiles": [
        "f_r0",
        "f_4_0"
      ]
    },
    {
      "step_number": 3,
      "description": "铺耕地北沿: 6 片合拢, 8x4 耕地就绪。",
      "tip": "土地平整完毕 —— 该请主角进场了。",
      "tiles_to_add": [
        "f_0_3",
        "f_r3",
        "f_3_3",
        "f_4_3",
        "f_r4",
        "f_7_3"
      ],
      "highlight_tiles": [
        "f_a_2",
        "f_c_2"
      ]
    },
    {
      "step_number": 4,
      "description": "装大后轮: 2 片车轮底座沿 y=1 与 y=3 拼缝立起, 底边整边吸合。",
      "tip": "车轮底座一片顶两格 —— 拖拉机的大后轮就是它的招牌。",
      "tiles_to_add": [
        "wh_rs",
        "wh_rn"
      ],
      "highlight_tiles": [
        "f_r0",
        "f_r3"
      ]
    },
    {
      "step_number": 5,
      "description": "装小前轮: 2 片灰色方板立在 x [4,5] 格边上, 前轮比后轮小一号。",
      "tip": "大后轮小前轮 —— 这才是拖拉机的经典侧影。",
      "tiles_to_add": [
        "wh_fs",
        "wh_fn"
      ],
      "highlight_tiles": [
        "wh_rs",
        "wh_rn"
      ]
    },
    {
      "step_number": 6,
      "description": "架底盘后段: 2 片红色长板长边整边压住两侧后轮顶边。",
      "tip": "底盘压轮成桥 —— 车架从这里开始受力。",
      "tiles_to_add": [
        "ch_rs",
        "ch_rn"
      ],
      "highlight_tiles": [
        "wh_rs",
        "wh_rn"
      ]
    },
    {
      "step_number": 7,
      "description": "接底盘前段: 再接 2 片, 短边与后段短边接龙, 长边内侧稳稳吸住前轮顶边。",
      "tip": "前轮顶边完整落在长板长边内 —— 长短边贴合同样牢固。",
      "tiles_to_add": [
        "ch_fs",
        "ch_fn"
      ],
      "highlight_tiles": [
        "ch_rs",
        "wh_fs"
      ]
    },
    {
      "step_number": 8,
      "description": "立驾驶室玻璃圈层: 4 片透明长楣在底盘后段围成一圈, 四角竖边咬合。",
      "tip": "透明圈层就是 360 度环景驾驶室 —— 农机手视野第一。",
      "tiles_to_add": [
        "cb_s_g",
        "cb_n_g",
        "cb_w_g",
        "cb_e_g"
      ],
      "highlight_tiles": [
        "ch_rs",
        "ch_rn"
      ]
    },
    {
      "step_number": 9,
      "description": "立引擎舱墙: 南北 2 片红色长楣加前格栅, 西墙借用驾驶室前风挡 —— 两舱共墙锁成双环。",
      "tip": "共墙是双环结构的关键: 一面墙同时属于两个圈层。",
      "tiles_to_add": [
        "hd_s",
        "hd_n",
        "hd_e"
      ],
      "highlight_tiles": [
        "cb_e_g",
        "ch_fs"
      ]
    },
    {
      "step_number": 10,
      "description": "盖引擎舱顶: 2 片长板南北合拢, 南沿吸舱南墙顶、短边搭格栅与风挡顶。",
      "tip": "舱顶盖上, 引擎舱成了一只结实的箱子。",
      "tiles_to_add": [
        "hd_rf_s",
        "hd_rf_n"
      ],
      "highlight_tiles": [
        "hd_s",
        "hd_e"
      ]
    },
    {
