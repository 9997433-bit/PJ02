  "steps": [
    {
      "step_number": 1,
      "description": "铺院子南排: 橙色步道方板正对西牙根的大门位, 东段两片方板给候诊长凳留落脚边。",
      "tip": "磨牙楼的大门开在西牙根上 —— 步道先把位置标出来。",
      "tiles_to_add": [
        "g0_w",
        "g0_path",
        "g0_a",
        "g0_b",
        "g0_c",
        "g0_e"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺牙根落脚行: 两片白色根内地板夹住橙色穿堂地, 全部用方板 —— 牙根四壁要吸这些格线。",
      "tip": "根与根之间留一格穿堂 —— 从牙缝里穿过去!",
      "tiles_to_add": [
        "g1_w",
        "g1_ra",
        "g1_pass",
        "g1_rb",
        "g1_a",
        "g1_e"
