  "steps": [
    {
      "step_number": 1,
      "description": "铺步道南段: 五片方板沿南边一字排开 —— 两端清色角砖是门旗座, 中间三片灰清相间。",
      "tip": "这条步道是屏风的\"毯边\", 拼缝对齐, 后面整扇屏都要踩在缝上。",
      "tiles_to_add": [
        "f_sw",
        "f_c0",
        "f_c1",
        "f_c2",
        "f_se"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺两翼步道: 西翼与东翼各两片方板向北延伸, 步道围成一个 U 字。",
      "tip": "左右各铺两片, 和角砖整边吸牢 —— U 形的怀抱就是屏风的地基。",
      "tiles_to_add": [
        "f_w0",
        "f_w1",
        "f_e0",
        "f_e1"
      ],
      "highlight_tiles": [
        "f_sw",
        "f_se"
      ]
    },
    {
      "step_number": 3,
      "description": "立中屏底排: 三片菱形踩上步道北缝, 整排向东倾, 红橙红相间。",
      "tip": "菱形下底吸步道拼缝, 相邻斜边互咬 —— 整排同向倾是人字纹的第一笔。",
      "tiles_to_add": [
        "c_0_0",
        "c_0_1",
        "c_0_2"
      ],
      "highlight_tiles": [
        "f_c0",
        "f_c1",
        "f_c2"
      ]
    },
    {
      "step_number": 4,
      "description": "砌中屏第二排: 三片菱形整排换向西倾, 下底一对一骑上底排的上底。",
      "tip": "倾向一排一换, 两排咬合出人字纹 —— 织毯的经纬就是这样交错的。",
      "tiles_to_add": [
        "c_1_0",
        "c_1_1",
        "c_1_2"
      ],
      "highlight_tiles": [
        "c_0_0",
        "c_0_1",
        "c_0_2"
      ]
    },
    {
      "step_number": 5,
      "description": "砌中屏三四排封顶: 第三排回东倾, 第四排再西倾, 红橙菱格一格不错。",
      "tip": "顶排上底连成一条直线, 屏缘的锯齿像织毯毛边 —— 中屏完工!",
      "tiles_to_add": [
        "c_2_0",
        "c_2_1",
        "c_2_2",
        "c_3_0",
        "c_3_1",
        "c_3_2"
      ],
      "highlight_tiles": [
        "c_1_0",
        "c_1_1",
        "c_1_2"
      ]
    },
    {
      "step_number": 6,
      "description": "立西翼下半: 两片菱形踩西翼步道缝向北倾, 第二排换向南倾骑上去, 蓝青拼布。",
      "tip": "西翼立面和中屏成直角 —— 翼墙一立, 整面屏风就不怕前后推了。",
      "tiles_to_add": [
        "w_0_0",
        "w_0_1",
