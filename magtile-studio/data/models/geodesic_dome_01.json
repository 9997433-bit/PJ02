  "steps": [
    {
      "step_number": 1,
      "description": "放好六边形地板: 1 片灰色六边形平放桌面正中, 它是整座穹顶的地基。",
      "tip": "六边形的每条边都和正方形边一样长 1 格 —— 这是本模型的钥匙。",
      "tiles_to_add": [
        "floor"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺设广场方板: 6 片绿色正方形沿六边形的 6 条边向外平铺。",
      "tip": "每片方板一条边与地板整边吸合, 铺完像一朵六瓣花。",
      "tiles_to_add": [
        "pl_sq_0",
        "pl_sq_1",
        "pl_sq_2",
        "pl_sq_3",
        "pl_sq_4",
        "pl_sq_5"
      ],
      "highlight_tiles": [
        "floor"
      ]
    },
    {
      "step_number": 3,
      "description": "补齐广场楔角: 相邻方板之间的 60 度缺口正好塞进 1 片黄色等边三角形, 共 6 片。",
      "tip": "三角形两条边分别吸住两侧方板 —— 广场从此连成一个整圆盘。",
      "tiles_to_add": [
        "pl_tri_0",
        "pl_tri_1",
        "pl_tri_2",
        "pl_tri_3",
        "pl_tri_4",
        "pl_tri_5"
      ],
      "highlight_tiles": [
        "pl_sq_0",
        "pl_sq_1"
      ]
    },
    {
      "step_number": 4,
      "description": "竖立鼓身下层: 5 片青色正方形沿地板边缘立起 (朝东北的一面留作门洞), 相邻墙的竖边在拐角处互相吸合。",
      "tip": "每面墙底边吸地板边、侧边吸邻墙 —— 六边形筒壁自己就能锁紧。",
      "tiles_to_add": [
        "dr1_1",
        "dr1_2",
        "dr1_3",
        "dr1_4",
        "dr1_5"
      ],
      "highlight_tiles": [
        "floor"
      ]
    },
    {
      "step_number": 5,
      "description": "叠加鼓身上层前半: 3 片透明正方形叠在下层墙顶 (从门洞左侧数起)。",
      "tip": "上下两层墙的横边要完全对齐, 透明墙让阳光洒进穹顶。",
      "tiles_to_add": [
        "dr2_1",
        "dr2_2",
        "dr2_3"
      ],
      "highlight_tiles": [
        "dr1_1"
      ]
    },
    {
      "step_number": 6,
      "description": "叠加鼓身上层后半并封门楣: 再叠 2 片透明墙, 最后 1 片横跨门洞上方, 两条竖边分别吸住左右邻墙。",
      "tip": "门楣那片没有下层墙托底, 全靠两侧竖边吸牢 —— 这就是过梁。",
      "tiles_to_add": [
        "dr2_4",
        "dr2_5",
        "dr2_0"
      ],
      "highlight_tiles": [
        "dr2_1",
        "dr2_5"
      ]
    },
    {
      "step_number": 7,
      "description": "安装三角带正立片 (前半): 3 片透明等边三角形底边吸鼓身顶沿, 向内倾斜, 尖端指向穹顶轴线上空。",
      "tip": "尖端悬空不用怕 —— 等一圈装完它们会互相锁住。",
      "tiles_to_add": [
        "up_0",
        "up_1",
        "up_2"
      ],
      "highlight_tiles": [
        "dr2_0"
      ]
    },
    {
      "step_number": 8,
      "description": "安装三角带正立片 (后半): 其余 3 片, 6 个尖端围成一个转了 30 度的小六边形。",
      "tip": "从正上方看: 6 个尖端正好落在下方 6 个墙拐角的正中间上空。",
      "tiles_to_add": [
        "up_3",
        "up_4",
        "up_5"
      ],
      "highlight_tiles": [
        "up_0"
      ]
    },
    {
      "step_number": 9,
      "description": "嵌入三角带倒立片 (前半): 3 片青色等边三角形尖端朝下, 两条腰分别吸住左右正立片的斜边。",
      "tip": "倒立片一嵌进去, 三角带立刻变硬 —— 这就是测地穹顶的奥秘。",
      "tiles_to_add": [
        "dn_0",
        "dn_1",
        "dn_2"
      ],
      "highlight_tiles": [
        "up_0",
        "up_5"
      ]
    },
    {
      "step_number": 10,
      "description": "嵌入三角带倒立片 (后半): 其余 3 片, 正倒三角交替围成完整一圈。",
      "tip": "装完轻按整圈三角带: 12 片应像一个整体一样纹丝不动。",
      "tiles_to_add": [
        "dn_3",
        "dn_4",
        "dn_5"
      ],
      "highlight_tiles": [
        "dn_0"
      ]
    },
    {
      "step_number": 11,
      "description": "盖上顶板: 1 片蓝色六边形转 30 度放上三角带顶沿, 6 条边同时吸合。",
      "tip": "注意方向: 顶板的角要对准倒立三角的上沿接缝才吸得上。",
      "tiles_to_add": [
        "cap"
      ],
      "highlight_tiles": [
        "dn_0",
        "up_0"
      ]
    },
    {
      "step_number": 12,
      "description": "安装王冠 (前半): 3 片紫色等腰三角形底边吸顶板边, 向内浅浅倾斜。",
      "tip": "等腰三角形又高又尖, 6 片的尖端将在顶板上方 0.5 格处会合。",
      "tiles_to_add": [
        "cr_0",
        "cr_1",
        "cr_2"
      ],
      "highlight_tiles": [
        "cap"
      ]
    },
    {
      "step_number": 13,
