      ]
    },
    {
      "step_number": 10,
      "description": "铺上游水面: 四片蓝色水板压上池壁顶, 高水位亮相!",
      "tip": "每片水板两条外边压墙顶、两条内边彼此互吸 —— 上下游水面正好差一层, 这就是船闸要填平的高度差。",
      "tiles_to_add": [
        "up_4_1",
        "up_5_1",
        "up_4_2",
        "up_5_2"
      ],
      "highlight_tiles": [
        "gate_up_s"
      ]
    },
    {
      "step_number": 11,
      "description": "起控制塔一层: 借高台北墙当南墙, 北门朝岸再补东西两片。",
      "tip": "共墙技法: 一片墙同时属于高台和塔, 两个环共用一道保险。",
