  "steps": [
    {
      "step_number": 1,
      "description": "铺街景绿化带: 5 片绿色长板沿线排开 (y [0,1])。",
      "tip": "绿化带的北沿拼缝, 就是墩柱斜撑的落脚线。",
      "tiles_to_add": [
        "lawn_0",
        "lawn_1",
        "lawn_2",
        "lawn_3",
        "lawn_4"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺轨道基带西半段: 5 片灰色方板 (x 0~5)。",
      "tip": "方板之间的拼缝要对齐网格线 —— 墩柱就踩在拼缝上。",
      "tiles_to_add": [
        "base_0",
        "base_1",
        "base_2",
        "base_3",
        "base_4"
      ],
      "highlight_tiles": [
        "lawn_0"
      ]
    },
    {
      "step_number": 3,
      "description": "铺轨道基带东半段: 再铺 6 片, 基带贯通 11 格。",
      "tip": "基带铺直了, 高架才立得正。",
      "tiles_to_add": [
        "base_5",
        "base_6",
        "base_7",
        "base_8",
        "base_9",
        "base_10"
      ],
      "highlight_tiles": [
        "base_4"
      ]
    },
    {
      "step_number": 4,
      "description": "立三座高架墩柱: 每座两节立墙叠高, 墙脚整边吸基带拼缝。",
      "tip": "上节墙底边整边吸下节墙顶边 —— 磁条对磁条, 一条不落。",
      "tiles_to_add": [
        "py_1_0",
        "py_1_1",
        "py_5_0",
        "py_5_1",
        "py_10_0",
        "py_10_1"
      ],
      "highlight_tiles": [
        "base_1",
        "base_5",
        "base_9"
      ]
    },
    {
      "step_number": 5,
      "description": "加墩柱斜撑: 每座前后各一片直角三角形, 竖边吸墙、底边吸板。",
      "tip": "三角形是最稳的形状 —— 列车驶过, 墩柱纹丝不动。",
      "tiles_to_add": [
        "br_1_e",
        "br_1_w",
        "br_5_e",
        "br_5_w",
        "br_10_e",
        "br_10_w"
      ],
      "highlight_tiles": [
        "py_1_0",
        "py_5_0",
        "py_10_0"
      ]
    },
    {
      "step_number": 6,
      "description": "架轨道梁西半段: 5 片青色方板从西端铺到中央墩柱。",
      "tip": "先放 x=0 这片: 它的东边正好吸住西墩柱顶。",
      "tiles_to_add": [
        "beam_0",
        "beam_1",
        "beam_2",
        "beam_3",
        "beam_4"
      ],
      "highlight_tiles": [
        "py_1_1",
        "py_5_1"
      ]
    },
    {
      "step_number": 7,
      "description": "架轨道梁东半段 + 缓冲挡板: 梁铺满 10 格, 尽头立起红色挡板。",
      "tip": "挡板正压端墩柱顶 —— 列车永远不会冲出轨道。",
      "tiles_to_add": [
        "beam_5",
        "beam_6",
