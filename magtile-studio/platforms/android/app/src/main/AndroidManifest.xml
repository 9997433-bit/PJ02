<?xml version="1.0" encoding="utf-8"?>
<!-- MagTile Studio Android 清单: 模型库 + 库存录入 + 进度页 + 成就墙
     四个 Activity, 无任何权限申请 (数据资产随 APK assets 分发, 首启
     解包到应用私有目录; 进度存档 SQLite 亦在应用私有目录)。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.MagTile">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 磁力片库存录入 (从模型库筛选栏进入, 结果回传刷新「我能搭的」) -->
        <activity
            android:name=".InventoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 进度页「我的作品」(从模型库标题栏进入; 纯只读看板) -->
        <activity
            android:name=".ProgressActivity"
            android:exported="false" />

        <!-- 成就墙全览 (从进度页成就条带进入) -->
        <activity
            android:name=".AchievementsActivity"
            android:exported="false" />
    </application>

</manifest>
