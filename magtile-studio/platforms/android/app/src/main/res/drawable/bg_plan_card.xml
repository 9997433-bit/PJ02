<?xml version="1.0" encoding="utf-8"?>
<!-- 订阅页档位卡底 (对齐桌面 Qt SubscriptionPage 档位卡):
     选中 = 主色浅底 + 主色描边加粗; 未选 = 白底细描边。
     点卡只是选择, 购买必须再按下方主 CTA (无预勾选加购语义 §11)。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/magtile_primary_soft" />
            <stroke android:width="2dp" android:color="@color/magtile_primary" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/magtile_card" />
            <stroke android:width="1dp" android:color="@color/magtile_card_border" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
</selector>
