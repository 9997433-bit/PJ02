  "steps": [
    {
      "step_number": 1,
      "description": "铺南步道: 4 片灰色长板 (y [0,1]) + 西侧 2 片站位方板。",
      "tip": "长板长边压齐网格线 —— 游客就从南面隔着玻璃看企鹅。",
      "tiles_to_add": [
        "gd_s_0",
        "gd_s_1",
        "gd_s_2",
        "gd_s_3",
        "gd_0_1",
        "gd_0_2"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺池底: 8 片蓝色方板拼出 [1,5]x[1,3] 的水池底。",
      "tip": "池底全用方板 —— 池壁每条墙脚都能整边吸上。",
      "tiles_to_add": [
        "pl_1_1",
