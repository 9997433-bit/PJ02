  "steps": [
    {
      "step_number": 1,
      "description": "铺南半场软垫 (y [1,3]): 两行单位方板, 塔脚一圈用红色缓冲垫。",
      "tip": "攀岩馆的第一条安全规则: 垫子先到位, 岩塔才开工。",
      "tiles_to_add": [
        "mat_0_1",
        "mat_1_1",
        "mat_2_1",
        "mat_3_1",
        "mat_0_2",
        "mat_1_2",
        "mat_2_2",
        "mat_3_2",
        "mat_4_2"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺北半场软垫 (y [3,5]): 再两行, 每片与邻片等边互吸连成一张网。",
      "tip": "全部用单位方板 —— 墙脚与斜撑要吸的拼缝一格都不能少。",
      "tiles_to_add": [
        "mat_0_3",
        "mat_1_3",
        "mat_2_3",
        "mat_3_3",
        "mat_4_3",
        "mat_0_4",
        "mat_1_4",
        "mat_2_4",
        "mat_3_4",
        "mat_4_4"
      ],
      "highlight_tiles": [
        "mat_0_2"
      ]
    },
    {
      "step_number": 3,
      "description": "立一层南墙与西墙: 入口门框方在西南角, 红色初级线从这里出发。",
      "tip": "拐角两片竖边一咬, 排墙就变成了立得住的直角。",
      "tiles_to_add": [
        "t1_s_1",
        "t1_s_2",
        "t1_w_2",
        "t1_w_3"
      ],
      "highlight_tiles": [
        "mat_1_1"
      ]
    },
    {
      "step_number": 4,
      "description": "立一层北墙与东墙合环: 四角竖边互咬, 一层箱体闭环。",
      "tip": "闭环的墙比一字排开的墙结实得多 —— 这是岩塔的地基环。",
      "tiles_to_add": [
        "t1_n_1",
        "t1_n_2",
        "t1_e_2",
        "t1_e_3"
      ],
      "highlight_tiles": [
        "t1_s_1",
        "t1_w_2"
      ]
    },
    {
      "step_number": 5,
      "description": "装起步石: 借塔东墙围一格小箱, 再盖上灰色石面。",
      "tip": "塔的东墙同时也是起步石的西墙 —— 一墙两用, 第一脚踩这里。",
      "tiles_to_add": [
        "sb_s",
        "sb_n",
        "sb_e",
        "sb_cap"
      ],
      "highlight_tiles": [
        "t1_e_3"
      ]
    },
    {
      "step_number": 6,
      "description": "装塔基斜撑: 南面两端 + 西面两端, 竖直角边吸墙角竖棱、水平直角边吸软垫拼缝。",
