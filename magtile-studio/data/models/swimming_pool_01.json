        "wa_1_0",
        "wa_1_1",
        "wa_1_2"
      ],
      "highlight_tiles": []
    },
    {
      "step_number": 2,
      "description": "铺泳道 3、4: 再 6 片, 6x4 四泳道水面合拢。",
      "tip": "四条泳道各就各位 —— 蛙泳、自由泳随便挑。",
