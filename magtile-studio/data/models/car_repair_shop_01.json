    },
    {
      "step_number": 5,
      "description": "立举升机: 南北双门柱踩住地缝, 黄色举升台短边压双柱顶。",
      "tip": "柱-台-柱-地面锁成门式刚架, 双端受力零悬挑 —— 台下正好钻得进检修工。",
      "tiles_to_add": [
        "lift_pier_s",
        "lift_pier_n",
        "lift_deck"
      ],
      "highlight_tiles": [
        "fl_1_2"
      ]
    },
    {
      "step_number": 6,
      "description": "红色小车开上举升台: 双轮立台面长边, 车顶板压双轮顶。",
      "tip": "车轮底边整边吸住台面长边 (一缝双吸), 整车在二楼上再锁一个门式框架。",
      "tiles_to_add": [
        "up_wh_w",
        "up_wh_e",
        "up_top",
        "up_glass"
      ],
      "highlight_tiles": [
